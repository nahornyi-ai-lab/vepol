BAND_TAG = {"white": "⚪ white", "grey": "🟡 grey", "black": "⚫ black"}  # fallback


def labels() -> dict:
    return L.get(owner_lang(), L["en"])


def render_agent_note(date_iso: str, agent: dict) -> str:
    status = agent["status"]
    def _links(c):
        ls = [u for u in (c.get("proof_links") or []) if isinstance(u, str) and u.strip()]
        return ", ".join(ls[:3]) or "none"
    body = "\n".join(
        f"- [{c.get('band','?')}] {c.get('title','?')} — interest {c.get('interest','?')}, "
        f"money_real {c.get('money_real','?')}, pain {c.get('pain_intensity','?')}, "
        f"density {c.get('audience_density_score','?')}; links: {_links(c)}"
        for c in agent["candidates"]) or "(none)"
    return f"""---
slug: money-radar-{date_iso}-{agent['id']}
type: research-pass
agent: {agent['id']}
date: {date_iso}
status: {status}
---

# Money Radar {date_iso} — {agent['id']} pass ({status})

rc={agent['rc']}, finds={len(agent['candidates'])}

{body}
"""


def _find_block(i, r, lab, prefix=""):
    c = r["candidate"]
    band = c.get("band", "grey")
    tag = lab.get("bands", BAND_TAG).get(band, BAND_TAG.get(band, band))
    corr = f" · {r['corroboration']} {lab.get('agents','agents')}" if r.get("corroboration", 1) >= 2 else ""
    rs = r.get("rank_score")
    head = (f"{prefix}{i}. {c.get('title','?')} [{tag}{corr}]"
            + (f" — {lab.get('rank','rank')} {rs:.0f}" if isinstance(rs, (int, float)) else ""))
    out = [head]
    # Only emit fields the agent actually filled — an empty value must not render as a
    # dangling "Label:" line (live-smoke quality nit 2026-06-21: claude left how_it_works
    # blank and the digest showed "Как устроено:" with nothing after it).
    for key, lbl in (("money_flow", lab['flow']), ("pain_signal", lab['pain']),
                     ("audience_density", lab['density']), ("who_earns", lab['who']),
                     ("why_now", lab['why']), ("how_it_works", lab['how']),
                     ("rough_numbers", lab['numbers']), ("risk", lab['risk'])):
        val = str(c.get(key) or "").strip()   # str(): an agent may send a number/obj
        if val:
            out.append(f"   {lbl}: {val}")
    htt = str(c.get("how_to_try") or "").strip()
    if band != "black" and htt:
        out.append(f"   {lab['try']}: {htt}")
    pl = lab.get("proof", "proof")
    links = [u for u in (c.get("proof_links") or []) if isinstance(u, str) and u.strip()][:3]
    if links:
        out.append(f"   {pl}: {', '.join(links)}")
    elif c.get("_links_withheld"):
        out.append(f"   {pl}: ⚠️ {lab['withheld']}")
    out.append(f"   ⚠️ {lab['verify']}")
    return "\n".join(out)


def render_report(date_iso: str, ranked: list, nogo: list, agents: list, confidence: str) -> str:
    lab = labels()
    sub = [a["id"] for a in agents if a["status"] == "substantive"]
    deg = [a["id"] for a in agents if a["status"] != "substantive"]
    lines = [f"---\nslug: money-radar-{date_iso}\ntype: report\ndate: {date_iso}\n"
             f"confidence: {confidence}\n---\n",
             f"# Money Radar {date_iso} — fast-money intelligence\n",
             "## Quorum status\n",
             f"- substantive: {', '.join(sub) or 'none'}",
             f"- degraded: {', '.join(deg) or 'none'}",
             f"- confidence: {confidence}\n",
             "## Top finds (intelligence — you decide)\n"]
    if ranked:
        for i, r in enumerate(ranked, 1):
            lines.append(_find_block(i, r, lab) + "\n")
    else:
        lines.append(f"_{lab['none']}._\n")
    lines.append("## Scoring table\n")
    for r in ranked:
        c = r["candidate"]
        lines.append(f"- [{c.get('band','?')}] {c.get('title','?')}: "
                     f"rank {r.get('rank_score',0):.0f} "
                     f"(money_real {c.get('money_real','?')}, interest {c.get('interest','?')}, "
                     f"pain {c.get('pain_intensity','?')}, density {c.get('audience_density_score','?')}, "
                     f"corroboration {r['corroboration']})")
    lines.append("\n## Awareness / not pursued (other finds + reasons)\n")
    for c, reason in nogo:
        lines.append(f"- {c.get('title','?')}: {reason}")
    lines.append("\n## Sources\n")
    for r in ranked:
        for u in (r["candidate"].get("proof_links") or [])[:3]:
            if isinstance(u, str) and u.strip():
                lines.append(f"- {u}")
    return "\n".join(lines) + "\n"


def render_digest(date_iso: str, ranked: list, agents: list, confidence: str,
                  nogo: list, unavailable: bool) -> str:
    lab = labels()
    quorum = " · ".join(
        f"{a['id']} {'✓' if a['status']=='substantive' else '—'}" for a in agents)
    if unavailable:
        return (f"{lab['hdr']} {date_iso}\n\n⚠️ {lab['unavail']}\n\n"
                f"{lab['quorum']}: {quorum}")
    out = [f"{lab['hdr']} {date_iso}\n"]
    if ranked:
        for i, r in enumerate(ranked, 1):
            out.append(_find_block(i, r, lab))
    else:
        out.append(f"{lab['none']}.")
    conf = lab.get("conf_vals", {}).get(confidence, confidence)
    out.append(f"\n{lab['quorum']}: {quorum}  ({lab.get('confidence','confidence')}: {conf})")
    return "\n".join(out)


# --------------------------------------------------------------------------
# Delivery
# --------------------------------------------------------------------------

def channel_bin() -> str:
    override = os.environ.get("MONEY_RADAR_CHANNEL_BIN", "").strip()
    if override:
        return override
    hub_bin = HUB / "bin" / "kb-channel-send"
    return str(hub_bin) if hub_bin.exists() else ""


def deliver_digest(date_iso: str, digest: str, manifest: dict) -> int:
    outputs = process_outputs()
    if "telegram" not in outputs:
        manifest["telegram_delivered"] = False
        return 0
    if manifest.get("telegram_delivered"):
        log(f"{date_iso}: telegram already delivered; skip resend")
        return 0
    sender = channel_bin()
    if not sender:
        manifest["error"] = "kb-channel-send not found"
        return 1
    try:
        proc = subprocess.run([sender, "money-radar", digest], capture_output=True,
                              text=True, timeout=60, check=False, stdin=subprocess.DEVNULL)
    except Exception as exc:
        manifest["error"] = f"telegram delivery failed: {exc}"
        return 1
    if proc.returncode != 0:
        manifest["error"] = f"telegram delivery failed rc={proc.returncode}"
        return 1
    manifest["telegram_delivered"] = True
    save_manifest(date_iso, manifest)  # persist flag immediately (min resend window)
    return 0


# --------------------------------------------------------------------------
# Safety guard (write-detection backstop)
# --------------------------------------------------------------------------

# Genuine persistence/exfil WRITE targets that must never change during a money-radar
# run. Deliberately excludes agent-owned config (~/.claude.json, ~/.codex/auth*) which
# the CLI agents legitimately rewrite every invocation (real-smoke false-positive
# 2026-06-20) — those are not attacker persistence targets.
SENSITIVE_LEAVES = [
    "~/.ssh/id_rsa", "~/.ssh/id_ed25519", "~/.ssh/authorized_keys",
    "~/.ssh/known_hosts", "~/.gitconfig",
]


def _snapshot() -> dict:
    """Backstop snapshot. The PRIMARY defense is that scheduled agents cannot write
    at all (codex --sandbox confined to a throwaway cwd; claude --allowedTools
    Read,Glob,Grep,WebSearch,WebFetch has no write/shell tool; grok --deny write/edit/
    bash; agy --print returns text). So the guard only watches:
      - sensitive leaf secrets (content) — must never change during a run;
      - the SET of files in the radar's PRIVATE output dirs (sources/money-radar,
        reports/money-radar) — a NEW non-allowlisted file THERE is an agent dropping a
        payload, with no concurrent-write ambiguity.
    It deliberately does NOT watch the shared sources/ and reports/ (which churn from
    concurrent dev work — live-smoke false-positive 2026-06-21) nor content-diff the
    whole knowledge/ tree (log.md / backlog.md / daily/ churn — false-positive
    2026-06-20). The deferred social lane needs a real OS sandbox, not this backstop."""
    secrets = {}
    for leaf in SENSITIVE_LEAVES:
        p = pathlib.Path(os.path.expanduser(leaf))
        if p.is_file():
            try:
                secrets[str(p)] = hashlib.sha256(p.read_bytes()).hexdigest()
            except OSError:
                pass
    outputs = set()
    for d in (RADAR_SOURCES, RADAR_REPORTS):
        try:
            for p in d.iterdir():
                if p.is_file():
                    outputs.add(str(p.resolve()))
        except OSError:
            pass
    return {"secrets": secrets, "outputs": outputs}


def guard_check(before: dict, date_iso: str) -> list:
    after = _snapshot()
    violations = []
    for path, h in before["secrets"].items():
        if after["secrets"].get(path) != h:
            violations.append(f"{path} (sensitive file changed)")
    for path in after["outputs"] - before["outputs"]:
        if not is_allowlisted(pathlib.Path(path), date_iso):
            violations.append(path)
    return violations


# --------------------------------------------------------------------------
# Main orchestration
# --------------------------------------------------------------------------

def run(date_iso: str, force: bool, with_social: bool, dry_run: bool) -> int:
    ORCH.mkdir(parents=True, exist_ok=True)
    RADAR_SOURCES.mkdir(parents=True, exist_ok=True)
    RADAR_REPORTS.mkdir(parents=True, exist_ok=True)
    # The guard watches these private dirs by path; if one is a symlink it could redirect
    # writes/watch off-project. Refuse to run rather than trust a redirected output dir.
    for d in (RADAR_SOURCES, RADAR_REPORTS):
        if d.is_symlink():
            log(f"{date_iso}: refusing to run — {d} is a symlink (expected a real dir)")
            return 2

    try:
        roster = load_roster(with_social)
    except RosterError as exc:
        log(f"{date_iso}: roster rejected: {exc}")
        return 2

    if dry_run:
        print(f"[dry] roster={[a['id'] for a in roster]} outputs={sorted(process_outputs())}")
        return 0

    lock = acquire_lock(date_iso)
    if lock is None:
        m = load_manifest(date_iso)
        if m.get("telegram_delivered") and m.get("status") in ("completed", "degraded-unavailable"):
            log(f"{date_iso}: lock held but already completed+delivered; rc=0")
            return 0
        log(f"{date_iso}: lock held by another run (not yet a delivered success); rc=1")
        return 1

    try:
        return _run_locked(date_iso, roster, force)
    finally:
        try:
            fcntl.flock(lock.fileno(), fcntl.LOCK_UN)
            lock.close()
        except Exception:
            pass


def _run_locked(date_iso: str, roster: list, force: bool) -> int:
    manifest = {} if force else load_manifest(date_iso)
    if force:
        manifest = {}
    # Idempotency: a day already finished for its configured outputs is a no-op re-run, not
    # a fresh attempt — don't re-invoke agents or re-write/re-guard (Codex stop-review
    # 2026-06-22: repeated daily runs must not fail or resend after the first success).
    if not force and manifest.get("status") in ("completed", "degraded-unavailable"):
        outputs = process_outputs()
        if manifest.get("telegram_delivered") or "telegram" not in outputs:
            log(f"{date_iso}: already finished+delivered; idempotent no-op rc=0")
            return 0
    manifest.setdefault("date", date_iso)
    manifest.setdefault("attempts", 0)
    manifest["attempts"] = int(manifest.get("attempts", 0)) + 1
    manifest["attempt_date"] = date_iso
    manifest["started"] = now_iso()
    manifest.setdefault("agents", {})

    # Pin the run language ONCE; every downstream owner_lang() (prompt + render + defang)
    # returns this value, and any stale-language cache is dropped (Codex stop-review 2026-06-22).
    run_lang = pin_run_language()
    if _gate_cache_language(manifest, run_lang):
        log(f"{date_iso}: profile language now {run_lang}; dropped stale-language cache")
    manifest["language"] = run_lang

    before = _snapshot()

    # Context pack
    context = build_context(date_iso)
    guarded_write(RADAR_SOURCES / f"{date_iso}-context.md", context, date_iso)

    # Run agents (smoke-gated, parallel, per-agent cache reuse)
    cached = manifest.get("agents", {})
    todo = []
    results = {}
    for a in roster:
        prev = cached.get(a["id"])
        if prev and prev.get("status") == "substantive" and prev.get("candidates"):
            # Reconstruct a FULL result dict: the cached manifest entry omits id/role, and
            # downstream code does a["id"] / a.get("role") — reusing it raw crashed every
            # re-run with KeyError('id') (Codex stop-review 2026-06-22).
            results[a["id"]] = {"id": a["id"], "status": prev["status"],
                                "rc": prev.get("rc", 0), "out_path": prev.get("out_path", ""),
                                "candidates": prev["candidates"], "role": a.get("role")}
        else:
            todo.append(a)

    def _do(adapter):
        if not smoke_agent(adapter):
            log(f"{adapter['id']}: smoke failed; skipping real pass")
            return {"id": adapter["id"], "status": "missing", "rc": -1,
                    "out_path": "", "candidates": [], "role": adapter.get("role")}
        return run_agent(adapter, date_iso, context)

    if todo:
        ex = futures.ThreadPoolExecutor(max_workers=min(8, len(todo)))
        futs = {ex.submit(_do, a): a for a in todo}
        try:
            for fut in futures.as_completed(futs, timeout=CEILING_S):
                r = fut.result()
                results[r["id"]] = r
            ex.shutdown(wait=True)
        except futures.TimeoutError:
            # ceiling: SIGKILL stragglers and do NOT block on the executor
            kill_all_active()
            ex.shutdown(wait=False, cancel_futures=True)
            for fut, a in futs.items():
                if fut.done() and not fut.cancelled():
                    try:
                        r = fut.result()
                        results[r["id"]] = r
                    except Exception:
                        pass
            log(f"{date_iso}: ceiling {CEILING_S}s hit; stragglers killed, proceeding")

    agents = []
    for a in roster:
        r = results.get(a["id"], {"id": a["id"], "status": "missing", "rc": -1,
                                  "out_path": "", "candidates": [], "role": a.get("role")})
        agents.append(r)
        manifest["agents"][a["id"]] = {"status": r["status"], "rc": r["rc"],
                                       "out_path": r["out_path"],
                                       "candidates": r["candidates"], "ts": now_iso()}
        guarded_write(RADAR_SOURCES / f"{date_iso}-{a['id']}.md",
                      render_agent_note(date_iso, r), date_iso)

    substantive = [a for a in agents if a["status"] == "substantive"]

    # availability cap-out path
    if not substantive:
        if manifest["attempts"] >= MAX_DAILY_ATTEMPTS:
            return _finish_unavailable(date_iso, agents, manifest, before)
        manifest["status"] = "failed"
        manifest["error"] = "no substantive agent captures (transient)"
        save_manifest(date_iso, manifest)
        update_streak(date_iso, healthy=False, reason="no substantive captures")
        v = guard_check(before, date_iso)
        if v:
            return _guard_fail(date_iso, manifest, v)
        log(f"{date_iso}: zero substantive, attempts<{MAX_DAILY_ATTEMPTS}; rc=1 retry")
        return 1

    # Merge / corroborate / validate / rank (NO filtering — only drop title-less)
    by_agent = {a["id"]: a["candidates"] for a in substantive}
    clusters = cluster_candidates(by_agent)
    ranked, nogo = [], []
    for cl in clusters:
        ok, reason = validate_candidate(cl["candidate"])
        if ok:
            cl["rank_score"] = rank_score(cl)
            ranked.append(cl)
        else:
            nogo.append((cl["candidate"], reason))
    ranked.sort(key=lambda r: (-r["rank_score"],
                               -(_num(r["candidate"].get("money_real")) or 0.0),
                               -(_num(r["candidate"].get("pain_intensity")) or 0.0),
                               -(_num(r["candidate"].get("audience_density_score")) or 0.0),
                               -r["corroboration"], (r["candidate"].get("title") or "")))
    ranked, others = select_finds(ranked)   # 1-2 finds, band-diverse (owner 2026-06-21)
    for r in others:
        nogo.append((r["candidate"], f"[{r['candidate'].get('band','?')}] not in today's top {len(ranked)}"))
    annotate_liveness(ranked)
    confidence = "high" if len(substantive) >= 3 else ("medium" if len(substantive) == 2 else "low")

    report = render_report(date_iso, ranked, nogo, agents, confidence)
    guarded_write(RADAR_REPORTS / f"{date_iso}.md", report, date_iso)
    # required-section self-check (downstream-fault guard)
    for sec in ("## Quorum status", "## Top finds", "## Scoring table",
                "## Awareness / not pursued", "## Sources"):
        if sec not in report:
            manifest["status"] = "failed"
            manifest["error"] = f"report missing section {sec}"
            save_manifest(date_iso, manifest)
            update_streak(date_iso, healthy=False, reason=f"report missing section {sec}")
            return 1

    digest = render_digest(date_iso, ranked, agents, confidence, nogo, unavailable=False)
    guarded_write(RADAR_REPORTS / f"{date_iso}-digest.txt", digest, date_iso)
    # Also mirror the rendered prose digest into ORCH so hub-anchored kb-morning-digest can
    # find it as its preferred money block (spec D9-producer). ORCH allowlist already permits
    # any money-radar-<date>* name (is_allowlisted).
    guarded_write(ORCH / f"money-radar-{date_iso}-digest.txt", digest, date_iso)

    manifest["report"] = {"ranked": [r["candidate"].get("title") for r in ranked],
                          "nogo": [c.get("title") for c, _ in nogo],
                          "confidence": confidence}
    manifest["status"] = "completed"
    manifest["error"] = None
    save_manifest(date_iso, manifest)

    # Guard MUST gate delivery — if an agent escaped its sandbox and wrote out-of-band, we
    # must NOT ship the digest to Telegram first and warn after (Codex sweep 2026-06-21).
    v = guard_check(before, date_iso)
    if v:
        return _guard_fail(date_iso, manifest, v)

    rc = deliver_digest(date_iso, digest, manifest)
    if rc != 0:
        manifest["status"] = "failed"
        save_manifest(date_iso, manifest)
        update_streak(date_iso, healthy=False, reason=manifest.get("error", "delivery failed"))
        return 1
    save_manifest(date_iso, manifest)

    update_streak(date_iso, healthy=True, reason="")
    log(f"{date_iso}: completed; execute={len(ranked)} nogo={len(nogo)} confidence={confidence}")
    return 0


def _finish_unavailable(date_iso, agents, manifest, before) -> int:
    report = render_report(date_iso, [], [], agents, "low")
    guarded_write(RADAR_REPORTS / f"{date_iso}.md", report, date_iso)
    digest = render_digest(date_iso, [], agents, "low", [], unavailable=True)
    guarded_write(RADAR_REPORTS / f"{date_iso}-digest.txt", digest, date_iso)
    # Mirror to ORCH for kb-morning-digest (spec D9-producer); see completed path.
    guarded_write(ORCH / f"money-radar-{date_iso}-digest.txt", digest, date_iso)
    manifest["status"] = "degraded-unavailable"
    manifest["error"] = None
    save_manifest(date_iso, manifest)
    v = guard_check(before, date_iso)   # guard gates delivery (see completed path)
    if v:
        return _guard_fail(date_iso, manifest, v)
    rc = deliver_digest(date_iso, digest, manifest)
    if rc != 0:
        manifest["status"] = "failed"
        save_manifest(date_iso, manifest)
        update_streak(date_iso, healthy=False, reason="delivery failed (unavailable digest)")
        return 1
    save_manifest(date_iso, manifest)
    update_streak(date_iso, healthy=False, reason="agents unavailable (cap-out)")
    log(f"{date_iso}: agents unavailable cap-out; honest degraded-success rc=0")
    return 0


def _guard_fail(date_iso, manifest, violations) -> int:
    manifest["status"] = "failed"
    manifest["out_of_band_write"] = violations
    save_manifest(date_iso, manifest)
    marker = f"money-radar out-of-band write"
    line = f"\n## [{date_iso}] {marker}: {violations[:3]}\n"
    try:
        existing = ESCAL.read_text(encoding="utf-8") if ESCAL.exists() else ""
        if f"[{date_iso}] {marker}" not in existing:  # dedup: once per day
            with ESCAL.open("a", encoding="utf-8") as f:
                f.write(line)
    except OSError:
        pass
    update_streak(date_iso, healthy=False, reason="out-of-band write (guard fail)")
    log(f"{date_iso}: SAFETY GUARD FAIL — out-of-band writes: {violations}")
    return 3


def main() -> int:
    ap = argparse.ArgumentParser(description="kb-money-radar daily opportunity radar")
    ap.add_argument("--text-only", action="store_true", help="no audio (default; compat)")
    ap.add_argument("--force", action="store_true", help="wipe today's manifest and rerun all agents")
    ap.add_argument("--with-social", action="store_true", help="allow social/web adapters (supervised)")
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--date", default=today_iso(), help="YYYY-MM-DD (testing)")
    args = ap.parse_args()
    if "MONEY_RADAR_PROJECT" not in os.environ and not (PROJ / "knowledge").is_dir():
        print("MONEY_RADAR_PROJECT is required unless cwd is a project root with knowledge/.", file=sys.stderr)
        return 2
    try:
        return run(args.date, args.force, args.with_social, args.dry_run)
    except Exception as exc:  # never leave kb-tick without an rc
        log(f"{args.date}: unhandled error: {exc!r}")
        return 1


if __name__ == "__main__":
    sys.exit(main())
