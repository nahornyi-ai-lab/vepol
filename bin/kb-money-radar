OVERLAP_LIMIT = 0.34
OVERLAP_MIN_SHARED = 2          # min shared salient tokens to merge (false-merge guard)
# Money Radar v2 (spec money-radar-spec-2026-06-21): a pain-first fast-money
# intelligence feed.
# NO mechanical filters — no capital/time/score caps, no demand-proof gate. The owner
# is the filter; the radar just surfaces 1-2 of the most interesting real money flows.
# Owner update 2026-06-26: money is usually hiding where people complain in numbers, so
