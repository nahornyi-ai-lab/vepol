#!/usr/bin/env python3
"""Install the pinned Qwen3-TTS runtime and model without creating a service."""

from __future__ import annotations

import argparse
import fcntl
import hashlib
import json
import os
import platform
import shutil
import subprocess
import sys
import uuid
from contextlib import contextmanager
from pathlib import Path
from typing import Callable, Iterator

PYTHON_VERSION = "3.12.9"
MLX_AUDIO_VERSION = "0.4.5"
MODEL_ID = "mlx-community/Qwen3-TTS-12Hz-1.7B-VoiceDesign-bf16"
MODEL_REVISION = "7d3824abff87e49756bb0f83fb5411de75d160c4"
MAIN_HASH = "96ae28bec2205ec0b5e0c750bea2b8a5deac4f14d33a8a25a5f753299486b70e"
TOKENIZER_HASH = "836b7b357f5ea43e889936a3709af68dfe3751881acefe4ecf0dbd30ba571258"
EXPECTED_MODEL_FILES = {
    "model.safetensors": MAIN_HASH,
    "speech_tokenizer/model.safetensors": TOKENIZER_HASH,
}
RELEASE_NAME = f"bf16-{MODEL_REVISION[:12]}-{MAIN_HASH[:12]}"


def run(command: list[str], *, env: dict[str, str] | None = None) -> None:
    print("+", " ".join(command), flush=True)
    subprocess.run(command, check=True, env=env)


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for chunk in iter(lambda: stream.read(8 * 1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def verify_model_release(
    model: Path, *, expected: dict[str, str] = EXPECTED_MODEL_FILES
) -> None:
    if not model.is_dir():
        raise RuntimeError(f"model release is missing: {model}")
    for relative, wanted in expected.items():
        path = model / relative
        if not path.is_file():
            raise RuntimeError(f"model release is incomplete: {path} missing")
        actual = sha256(path)
        if actual != wanted:
            raise RuntimeError(
                f"model integrity failure for {relative}: expected {wanted}, got {actual}"
            )


def atomic_json(
    path: Path,
    payload: dict[str, object],
    *,
    replace_fn: Callable[[os.PathLike[str] | str, os.PathLike[str] | str], None] = os.replace,
) -> None:
    temp = path.with_name(f".{path.name}.tmp-{os.getpid()}-{uuid.uuid4().hex}")
    try:
        temp.write_text(
            json.dumps(payload, ensure_ascii=False, indent=2) + "\n", encoding="utf-8"
        )
        replace_fn(temp, path)
    finally:
        try:
            temp.unlink()
        except FileNotFoundError:
            pass


def preserve_rollback_marker(
    home: Path,
    release_name: str,
    *,
    replace_fn: Callable[[os.PathLike[str] | str, os.PathLike[str] | str], None] = os.replace,
) -> Path | None:
    marker = home / "install.json"
    if not marker.is_file():
        return None
    rollback = home / "rollback" / f"install-before-{release_name}.json"
    if rollback.exists():
        if not rollback.is_file() or rollback.stat().st_size == 0:
            raise RuntimeError(f"rollback marker collision is invalid: {rollback}")
        return rollback
    rollback.parent.mkdir(parents=True, exist_ok=True)
    temp = rollback.with_name(f".{rollback.name}.tmp-{os.getpid()}-{uuid.uuid4().hex}")
    try:
        temp.write_bytes(marker.read_bytes())
        replace_fn(temp, rollback)
    finally:
        try:
            temp.unlink()
        except FileNotFoundError:
            pass
    return rollback


@contextmanager
def installation_lock(path: Path) -> Iterator[None]:
    path.parent.mkdir(parents=True, exist_ok=True)
    stream = path.open("a+", encoding="utf-8")
    os.chmod(path, 0o600)
    acquired = False
    try:
        try:
            fcntl.flock(stream.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
            acquired = True
        except BlockingIOError as exc:
            raise RuntimeError(f"another TTS installer is already running ({path})") from exc
        yield
    finally:
        try:
            if acquired:
                fcntl.flock(stream.fileno(), fcntl.LOCK_UN)
        finally:
            stream.close()


def promote_verified_release(
    home: Path,
    staged: Path | None,
    release_name: str,
    marker_payload: dict[str, object],
    *,
    expected: dict[str, str] = EXPECTED_MODEL_FILES,
    replace_fn: Callable[[os.PathLike[str] | str, os.PathLike[str] | str], None] = os.replace,
) -> Path:
    if Path(release_name).name != release_name or release_name in {"", ".", ".."}:
        raise RuntimeError(f"invalid model release name: {release_name!r}")
    home = home.expanduser().resolve()
    models = home / "models"
    models.mkdir(parents=True, exist_ok=True)
    final = models / release_name

    if final.exists():
        verify_model_release(final, expected=expected)
    else:
        if staged is None:
            raise RuntimeError(f"verified model release is missing: {final}")
        staged = staged.resolve()
        if staged.parent != models.resolve() or not staged.name.startswith(".stage-"):
            raise RuntimeError(f"refusing non-owned staging directory: {staged}")
        verify_model_release(staged, expected=expected)
        replace_fn(staged, final)
        verify_model_release(final, expected=expected)

    payload = dict(marker_payload)
    payload["model_path"] = str(final.resolve())
    preserve_rollback_marker(home, release_name, replace_fn=replace_fn)
    atomic_json(home / "install.json", payload, replace_fn=replace_fn)
    return final.resolve()


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args()

    here = Path(__file__).resolve().parent
    runtime = here / "_kb_tts"
    lock = runtime / "requirements.lock"
    downloader = runtime / "install_model.py"
    home = Path(os.environ.get("KB_TTS_HOME", "~/.local/share/vepol-qwen-tts")).expanduser().resolve()
    venv = home / "venv"
    python = venv / "bin/python"
    models = home / "models"
    release = models / RELEASE_NAME
    uv = os.environ.get("KB_TTS_UV") or shutil.which("uv")

    print(f"Runtime home: {home}")
    print(f"Pinned runtime: CPython {PYTHON_VERSION}; mlx-audio=={MLX_AUDIO_VERSION}")
    print(f"Pinned model: {MODEL_ID}@{MODEL_REVISION}")
    print(f"Main weight SHA-256: {MAIN_HASH}")
    print(f"Tokenizer weight SHA-256: {TOKENIZER_HASH}")
    print(f"Model storage: immutable verified release {RELEASE_NAME}; atomic install.json promotion")
    print("Lifecycle: on-demand process only; no daemon, server, LaunchAgent, cron, or Docker")
    if args.dry_run:
        return 0

    if platform.system() != "Darwin" or platform.machine() != "arm64":
        raise SystemExit("this installer requires Apple Silicon macOS")
    if not uv:
        raise SystemExit("uv is required; install it first")
    for command in ("ffmpeg", "ffprobe", "lsof"):
        if not shutil.which(command):
            raise SystemExit(f"required command is missing: {command}")
    if not lock.is_file() or "mlx-audio==0.4.5" not in lock.read_text(encoding="utf-8"):
        raise SystemExit(f"hashed dependency lock is missing or invalid: {lock}")

    home.mkdir(parents=True, exist_ok=True)
    with installation_lock(home / "install.lock"):
        run([uv, "python", "install", PYTHON_VERSION])
        if not python.is_file():
            run([uv, "venv", "--python", PYTHON_VERSION, str(venv)])
        actual_python = subprocess.check_output(
            [str(python), "-c", "import platform; print(platform.python_version())"], text=True
        ).strip()
        if actual_python != PYTHON_VERSION:
            raise SystemExit(
                f"wrong runtime Python: expected {PYTHON_VERSION}, got {actual_python}"
            )

        run([uv, "pip", "sync", "--python", str(python), "--require-hashes", str(lock)])
        actual_mlx = subprocess.check_output(
            [str(python), "-c", "import importlib.metadata as m; print(m.version('mlx-audio'))"],
            text=True,
        ).strip()
        if actual_mlx != MLX_AUDIO_VERSION:
            raise SystemExit(
                f"wrong mlx-audio version: expected {MLX_AUDIO_VERSION}, got {actual_mlx}"
            )

        stage: Path | None = None
        try:
            if release.exists():
                verify_model_release(release)
            else:
                free = shutil.disk_usage(home).free
                if free < 10 * 1024**3:
                    raise SystemExit(
                        "at least 10 GiB free disk is required to stage BF16; "
                        f"found {free / 1024**3:.1f} GiB"
                    )
                models.mkdir(parents=True, exist_ok=True)
                stage = models / f".stage-{RELEASE_NAME}-{os.getpid()}-{uuid.uuid4().hex}"
                env = os.environ.copy()
                env.update({
                    "HF_HOME": str(home / "huggingface"),
                    "HF_HUB_DISABLE_TELEMETRY": "1",
                })
                run([str(python), str(downloader), "--model-dir", str(stage)], env=env)

            promote_verified_release(
                home,
                stage,
                RELEASE_NAME,
                {
                    "schema": 1,
                    "python_version": PYTHON_VERSION,
                    "mlx_audio_version": MLX_AUDIO_VERSION,
                    "model_id": MODEL_ID,
                    "model_revision": MODEL_REVISION,
                    "no_resident_service": True,
                },
            )
        finally:
            if stage is not None and stage.exists():
                shutil.rmtree(stage)
    print(f"Installed successfully: {home}")
    print("Nothing was started; run kb-tts-render only when audio is needed.")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except subprocess.CalledProcessError as exc:
        print(f"install failed (exit {exc.returncode}): {' '.join(exc.cmd)}", file=sys.stderr)
        raise SystemExit(exc.returncode)
    except (OSError, RuntimeError) as exc:
        print(f"install failed: {exc}", file=sys.stderr)
        raise SystemExit(1)
