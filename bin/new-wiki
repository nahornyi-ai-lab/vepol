#!/usr/bin/env bash
# new-wiki — bootstrap a local wiki inside a project and register it in the hub.
# Creates <project>/AGENTS.md (canonical; Claude Code reads it directly, no CLAUDE.md needed)
# and <project>/knowledge/ with the full structure, symlinks knowledge/ into
# ~/knowledge/projects/<slug>, logs the event in the hub and adds a `seeded` row
# to a hand-written ~/knowledge/registry.md (otherwise it prints how to register).
# A project's own AGENTS.md is never rewritten: new-wiki appends one marked
# Vepol block to it (once) so Codex and other agents load the startup context.
# Antigravity CLI (`agy`) reads the project AGENTS.md natively via `agy --add-dir <path>` —
# no separate GEMINI.md adapter is created (Gemini CLI deprecation 2026-06-18).
#
# Usage: new-wiki <path-to-project> [slug] [category] [description]
#   category: lab | order | pet | job | personal (default: personal)
#   description: one line for the registry row (default: empty)

set -euo pipefail

HUB="${KNOWLEDGE_HUB:-$HOME/knowledge}"
TEMPLATE="$HUB/_template"

if [[ $# -lt 1 ]]; then
  echo "Usage: new-wiki <project-path> [slug] [category] [description]" >&2
  exit 1
fi

if [[ ! -d "$1" ]]; then
  echo "new-wiki: folder not found: $1" >&2
  exit 1
fi

PROJECT_PATH="$(cd "$1" && pwd)"
PROJECT_NAME="$(basename "$PROJECT_PATH")"
SLUG="${2:-$(echo "$PROJECT_NAME" | tr '[:upper:] ' '[:lower:]-' | tr -cd 'a-z0-9-')}"
CATEGORY="${3:-personal}"
DESCRIPTION="${4:-}"
DATE="$(date +%Y-%m-%d)"

echo "→ Project:  $PROJECT_NAME"
echo "→ Path:     $PROJECT_PATH"
echo "→ Slug:     $SLUG"
echo "→ Category: $CATEGORY"

# 1. Create the knowledge/ structure
mkdir -p "$PROJECT_PATH/knowledge/raw/assets"
mkdir -p "$PROJECT_PATH/knowledge/sources"
mkdir -p "$PROJECT_PATH/knowledge/daily"
mkdir -p "$PROJECT_PATH/knowledge/reports"
mkdir -p "$PROJECT_PATH/knowledge/agents"
: > "$PROJECT_PATH/knowledge/daily/.gitkeep"
: > "$PROJECT_PATH/knowledge/reports/.gitkeep"

# 2. Render templates
render() {
  local src="$1" dst="$2"
  if [[ -e "$dst" ]]; then
    echo "  ⚠ skip (exists): $dst"
    return
  fi
  sed -e "s|{{PROJECT_NAME}}|$PROJECT_NAME|g" \
      -e "s|{{PROJECT_SLUG}}|$SLUG|g" \
      -e "s|{{CATEGORY}}|$CATEGORY|g" \
      -e "s|{{DATE}}|$DATE|g" \
      "$src" > "$dst"
  echo "  ✓ $dst"
}

# The project's own AGENTS.md: keep the user's text and append one marked
# block with the startup-context line (worded as in _template/AGENTS.md), so
# Codex and other hook-less agents load Vepol's context. Never added twice:
# a file that has the block, or already runs kb-session-start --print (an
# AGENTS.md new-wiki rendered earlier), is left as it is.
AGENTS_FILE="$PROJECT_PATH/AGENTS.md"
VEPOL_BLOCK_BEGIN="<!-- BEGIN VEPOL — added by new-wiki; edit the text freely, keep these markers -->"
VEPOL_BLOCK_END="<!-- END VEPOL -->"
STARTUP_LINE='~/knowledge/bin/kb-session-start --print --cwd "$PWD"'
AGENTS_RESULT="created"
if [[ -L "$AGENTS_FILE" || ( -e "$AGENTS_FILE" && ! -f "$AGENTS_FILE" ) ]]; then
  AGENTS_RESULT="manual"
  echo "  ⚠ $AGENTS_FILE is a link or not a regular file — not changed"
elif [[ -f "$AGENTS_FILE" ]]; then
  if grep -Fq "BEGIN VEPOL" "$AGENTS_FILE" || grep -Fq "kb-session-start --print" "$AGENTS_FILE"; then
    AGENTS_RESULT="present"
    echo "  ✓ $AGENTS_FILE already loads Vepol's startup context — left as is"
  elif [[ ! -w "$AGENTS_FILE" ]]; then
    AGENTS_RESULT="manual"
    echo "  ⚠ $AGENTS_FILE is not writable — not changed"
  else
    # A file that does not end with a newline gets one before the block.
    if [[ -s "$AGENTS_FILE" && -n "$(tail -c 1 "$AGENTS_FILE")" ]]; then
      echo "" >> "$AGENTS_FILE"
    fi
    {
      echo ""
      echo "$VEPOL_BLOCK_BEGIN"
      echo "## Vepol knowledge base"
      echo ""
      echo "This project's wiki is \`knowledge/\` (state, log, backlog); the rules for it are in"
      echo "[\`~/knowledge/AGENTS.md\`](~/knowledge/AGENTS.md). At every new session start, before the"
      echo "first substantive answer or action, have the project's startup context: if no"
      echo "\`Startup Context Manifest\` was injected (hook-less runtime), run \`$STARTUP_LINE\`."
      echo "$VEPOL_BLOCK_END"
    } >> "$AGENTS_FILE"
    AGENTS_RESULT="appended"
    echo "  ✓ $AGENTS_FILE kept; Vepol block appended (startup context + knowledge/)"
  fi
else
  render "$TEMPLATE/AGENTS.md" "$AGENTS_FILE"
fi
# Project CLAUDE.md adapter retired 2026-10-01: Claude Code >= 2.1.277 reads
# AGENTS.md natively, and a CLAUDE.md anywhere above a project disables it.
# Project-level GEMINI.md adapter removed 2026-05-22 — Antigravity CLI reads
# AGENTS.md natively via `agy --add-dir <path>`. Legacy template guarded for
# backward compatibility with old `~/knowledge/_template/` checkouts.
if [[ -f "$TEMPLATE/GEMINI.md" ]]; then
  echo "  ⚠ legacy $TEMPLATE/GEMINI.md found — skipping (deprecated 2026-05-22)"
fi
render "$TEMPLATE/knowledge/README.md"  "$PROJECT_PATH/knowledge/README.md"
render "$TEMPLATE/knowledge/index.md"   "$PROJECT_PATH/knowledge/index.md"
render "$TEMPLATE/knowledge/log.md"     "$PROJECT_PATH/knowledge/log.md"
render "$TEMPLATE/knowledge/state.md"   "$PROJECT_PATH/knowledge/state.md"
render "$TEMPLATE/knowledge/backlog.md"      "$PROJECT_PATH/knowledge/backlog.md"
render "$TEMPLATE/knowledge/escalations.md"  "$PROJECT_PATH/knowledge/escalations.md"
render "$TEMPLATE/knowledge/incidents.md"    "$PROJECT_PATH/knowledge/incidents.md"
render "$TEMPLATE/knowledge/strategies.md"   "$PROJECT_PATH/knowledge/strategies.md"
# Agent card example (agent-card-schema Stage 3 contract, 2026-05-12).
# Project's first agent copies _example.md → agent-card.md and fills it.
if [[ -f "$TEMPLATE/knowledge/agents/_example.md" ]]; then
  render "$TEMPLATE/knowledge/agents/_example.md" "$PROJECT_PATH/knowledge/agents/_example.md"
fi

# Phase 2: ship the canonical report template + .orchestration.yaml so this
# project participates in the orchestration cycle once `cycle_enabled` flips.
render "$TEMPLATE/knowledge/reports/_template.md" "$PROJECT_PATH/knowledge/reports/_template.md"
render "$TEMPLATE/knowledge/.orchestration.yaml"  "$PROJECT_PATH/knowledge/.orchestration.yaml"

# 2.5. Add knowledge/ and .kb-ignore to .gitignore (the wiki is not tracked by git).
GITIGNORE="$PROJECT_PATH/.gitignore"
ensure_gitignore_line() {
  local line="$1"
  if [[ -f "$GITIGNORE" ]] && grep -Fxq "$line" "$GITIGNORE"; then
    return
  fi
  if [[ ! -f "$GITIGNORE" ]]; then
    {
      echo "# Knowledge base (personal wiki, curated outside git)"
      echo "# See ~/knowledge/AGENTS.md"
    } > "$GITIGNORE"
  fi
  echo "$line" >> "$GITIGNORE"
  echo "  ✓ .gitignore += $line"
}
ensure_gitignore_line "knowledge/"
ensure_gitignore_line ".kb-ignore"

# 3. Symlink into the hub (target = knowledge/, NOT the project root — so code stays out of Obsidian)
LINK="$HUB/projects/$SLUG"
if [[ -L "$LINK" || -e "$LINK" ]]; then
  echo "  ⚠ symlink exists: $LINK"
else
  ln -s "$PROJECT_PATH/knowledge" "$LINK"
  echo "  ✓ symlink: $LINK → $PROJECT_PATH/knowledge"
fi

# 4. Log entry in the hub
{
  echo ""
  echo "## [$DATE] hub | $SLUG | wiki created via new-wiki ($CATEGORY)"
  echo "Path: \`$PROJECT_PATH\`. Symlink: \`projects/$SLUG → $PROJECT_PATH/knowledge\`."
} >> "$HUB/log.md"

# 5. Register the project in the hub registry (status `seeded`).
# A hand-written registry.md gets one row in the projects table (the table
# under the matching `## <category>` heading when there is one, else the last
# `| slug | …` table), with the columns its header names; the 4-column form is
# the `| slug | status | `path` | description |` row kb-rebuild-registry reads.
# A registry generated by kb-rebuild-registry (DERIVED/HUB-MANAGED blocks) is
# never edited here: `kb-rebuild-registry check` would report drift and the
# orchestrator cycle would refuse to run. Re-running new-wiki adds no second row.
REGISTRY="$HUB/registry.md"
REGISTRY_PATH_CELL="$PROJECT_PATH"
if [[ "$PROJECT_PATH" == "$HOME"/* ]]; then
  REGISTRY_PATH_CELL="~${PROJECT_PATH#"$HOME"}"
fi
REGISTRY_ROW="| $SLUG | seeded | \`$REGISTRY_PATH_CELL\` | ${DESCRIPTION//|//} |"
# The heredoc lives in a function, not inside $(...): macOS /bin/bash 3.2
# mis-parses quotes in a heredoc nested in a command substitution.
registry_add_row() {
  python3 - "$@" <<'PY'
import os, re, stat, sys, tempfile

path, slug, status, category, path_cell, desc = sys.argv[1:7]
# Registry readers split rows on "|" (kb-rebuild-registry's row regex cannot
# read an escaped "\|" either), so a pipe in the description becomes "/".
desc = desc.replace("|", "/")
path = os.path.realpath(path)
with open(path, encoding="utf-8") as fh:
    text = fh.read()
lines = text.splitlines(keepends=True)


def cells(line):
    s = line.strip()
    if not s.startswith("|"):
        return None
    return [c.strip().strip("`").strip() for c in s.strip("|").split("|")]


# A generated registry is checked first: its rows are edited through the
# migration table, never here, even when the project is already listed.
if "<!-- DERIVED-BEGIN -->" in text or "<!-- HUB-MANAGED-BEGIN -->" in text:
    print("generated")
    sys.exit(0)
for line in lines:
    c = cells(line)
    if c and c[0] == slug:
        print("present")
        sys.exit(0)

tables = []  # (header line index, last row index, lower-cased header cells)
i = 0
while i < len(lines):
    c = cells(lines[i])
    if c and c[0].lower() == "slug":
        j = i
        while j + 1 < len(lines) and lines[j + 1].strip().startswith("|"):
            j += 1
        tables.append((i, j, [x.lower() for x in c]))
        i = j + 1
        continue
    i += 1
if not tables:
    print("no-table")
    sys.exit(0)

table = tables[-1]
heading = re.compile(r"^(#{1,6})\s+" + re.escape(category) + r"\b", re.IGNORECASE)
for h, line in enumerate(lines):
    m = heading.match(line)
    if not m:
        continue
    level = len(m.group(1))
    for t in tables:
        if t[0] <= h:
            continue
        between = lines[h + 1:t[0]]
        if not any(re.match(r"^#{1,%d}\s" % level, x) for x in between):
            table = t
        break
    break

values = {
    "slug": slug, "status": status, "статус": status,
    "category": category, "категория": category, "parent": "hub",
    "path": f"`{path_cell}`", "путь": f"`{path_cell}`",
    "description": desc, "описание": desc,
}
row = "| " + " | ".join(values.get(col, "") for col in table[2]) + " |\n"
last = table[1]
if not lines[last].endswith("\n"):
    lines[last] += "\n"
lines.insert(last + 1, row)

directory = os.path.dirname(path)
fd, tmp = tempfile.mkstemp(prefix=".registry.md.", dir=directory)
try:
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        fh.write("".join(lines))
    os.chmod(tmp, stat.S_IMODE(os.stat(path).st_mode))
    os.replace(tmp, path)
except BaseException:
    if os.path.exists(tmp):
        os.unlink(tmp)
    raise
print("added")
PY
}
REGISTRY_RESULT="missing"
if [[ -f "$REGISTRY" ]]; then
  if ! REGISTRY_RESULT="$(registry_add_row "$REGISTRY" "$SLUG" "seeded" "$CATEGORY" "$REGISTRY_PATH_CELL" "$DESCRIPTION")"; then
    REGISTRY_RESULT="error"
  fi
fi
case "$REGISTRY_RESULT" in
  added)   echo "  ✓ $REGISTRY += $SLUG (seeded)" ;;
  present) echo "  ⚠ $REGISTRY already lists $SLUG — left as is" ;;
esac

MIGRATION="$HUB/migration-2026-04-25.yaml"
# The entry kb-rebuild-registry bootstrap would write for this project, for a
# hub whose registry.md is generated: appended to the end of the migration
# table it registers the project on the next `kb-rebuild-registry apply`.
# Values are double-quoted the way the table's reader unquotes them.
migration_entry() {
  python3 - "$SLUG" "$CATEGORY" "$PROJECT_PATH" "$HUB" "$DESCRIPTION" <<'PY'
import sys

slug, category, project, hub, desc = sys.argv[1:6]


def q(value):
    return '"' + value.replace("\\", "\\\\").replace('"', '\\"') + '"'


print(f"  - slug: {slug}")
print("    registry_source: derived")
print("    wiki_backed: true")
print("    orchestration_eligible: true")
print("    status: seeded")
print(f"    category: {q(category)}")
print("    parent: hub")
print(f"    knowledge_path: {q(project + '/knowledge')}")
print(f"    expected_symlink: {q(hub + '/projects/' + slug)}")
print(f"    project_path: {q(project)}")
if desc:  # one line; a pipe becomes "/", as in the registry row
    print(f"    description: {q(' '.join(desc.replace('|', '/').split()))}")
PY
}

echo ""
echo "✅ Wiki created. Next steps:"
case "$AGENTS_RESULT" in
  created)
    echo "  1. Open $AGENTS_FILE and fill in the project description and categories sections." ;;
  appended)
    echo "  1. $AGENTS_FILE is your own file: your text is unchanged; the Vepol block at its end"
    echo "     tells Codex and other agents to load the project's startup context." ;;
  present)
    echo "  1. $AGENTS_FILE already loads Vepol's startup context; it was left as is." ;;
  *)
    echo "  1. So that Codex and other agents load the project's startup context, add this line to"
    echo "     $AGENTS_FILE: at every new session start, run $STARTUP_LINE" ;;
esac
echo "  2. Open $PROJECT_PATH/knowledge/README.md and write 1-2 sentences describing the project."
MIGRATION_LISTS_SLUG=0
if [[ -f "$MIGRATION" ]] && grep -Eq "^  - slug: \"?$SLUG\"?[[:space:]]*\$" "$MIGRATION"; then
  MIGRATION_LISTS_SLUG=1
fi
print_migration_step() {  # how to add the project to an existing migration table
  echo "     Append these lines, indented exactly as shown, to the end of $MIGRATION:"
  migration_entry || echo "     (could not print the entry: python3 failed)"
  echo "     then run: $HUB/bin/kb-rebuild-registry apply"
  echo "     (not bootstrap: it would rebuild that table and lose its categories, statuses and descriptions)."
}
case "$REGISTRY_RESULT" in
  added|present)
    FILL_DESC="."
    [[ -n "$DESCRIPTION" ]] || FILL_DESC=", and fill in the description."
    echo "  3. Check the $SLUG row in $REGISTRY: set the status to live once the wiki is in use$FILL_DESC"
    if [[ -f "$MIGRATION" && "$MIGRATION_LISTS_SLUG" == 0 ]]; then
      echo "     This hub also has a migration table for kb-rebuild-registry."
      print_migration_step
    fi ;;
  generated)
    if [[ "$MIGRATION_LISTS_SLUG" == 1 ]]; then
      echo "  3. $MIGRATION already lists $SLUG; to refresh $REGISTRY run: $HUB/bin/kb-rebuild-registry apply"
    elif [[ ! -f "$MIGRATION" ]]; then
      # Appending to a missing table would create one without the other
      # projects, and apply would then regenerate the registry without them.
      echo "  3. Register the project: $REGISTRY is generated by kb-rebuild-registry, but its migration"
      echo "     table $MIGRATION is missing. Restore it from a backup, then append these lines to its end:"
      migration_entry || echo "     (could not print the entry: python3 failed)"
      echo "     and run: $HUB/bin/kb-rebuild-registry apply"
      echo "     (Without a backup, kb-rebuild-registry bootstrap rebuilds the table from projects/, this"
      echo "     project included; check every category, status and description in it before apply.)"
    else
      echo "  3. Register the project: $REGISTRY is generated by kb-rebuild-registry from its migration table."
      print_migration_step
    fi ;;
  missing)
    echo "  3. Register the project: $REGISTRY does not exist yet. Create it with this table:"
    echo "       | slug | status | path | description |"
    echo "       |---|---|---|---|"
    echo "       $REGISTRY_ROW" ;;
  *)
    echo "  3. Register the project: add this row to the projects table in $REGISTRY:"
    echo "       $REGISTRY_ROW" ;;
esac
echo "  4. Drop your first source into $PROJECT_PATH/knowledge/raw/ and tell your agent \"ingest\"."
