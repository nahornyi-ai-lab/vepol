#!/usr/bin/env bash
# kb-demo — wrapper that points any kb-* command at the demo wiki instead
#          of the user's real ~/knowledge/ hub.
#
# Use this to explore Vepol's commands against the synthetic demo data
# without touching your real knowledge base. Especially useful for the
# first-run aha sequence after install.
#
# Spec reference: README.md and demo/README.md in this repo.
#
# Usage:
#   kb-demo brief                    # equivalent to KB_HUB=<demo> kb-brief
#   kb-demo retro
#   kb-demo search "client renewal"
#   kb-demo backlog --open
#   kb-demo task "my new task"       # writes into the demo copy, not your real KB
#   kb-demo path                     # prints the demo copy's path and exits
#   kb-demo reset                    # starts the demo copy over from the repo
#
# Commands run against a private copy of the repo's demo/knowledge in
# ~/.vepol/demo-knowledge (KB_DEMO_HUB overrides), so trying the demo never
# changes files in your Vepol clone (upgrade.sh refuses a clone with local edits).

set -euo pipefail

# Locate this repo's demo/ dir.
# When installed via the standard symlink layout (see install.sh), kb-demo
# lives in ~/knowledge/bin/ as a symlink to <repo>/bin/kb-demo. We resolve
# the symlink to find the repo root.
SCRIPT_REAL_PATH="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || python3 -c "import os,sys; print(os.path.realpath(sys.argv[1]))" "${BASH_SOURCE[0]}")"
REPO_ROOT="$(cd "$(dirname "$SCRIPT_REAL_PATH")/.." && pwd)"
DEMO_SRC="$REPO_ROOT/demo/knowledge"
DEMO_HUB="${KB_DEMO_HUB:-$HOME/.vepol/demo-knowledge}"
DEMO_MARK=".vepol-demo-copy"

if [[ ! -d "$DEMO_SRC" ]]; then
  echo "✘ Demo hub not found at: $DEMO_SRC" >&2
  echo "  Expected the demo/knowledge/ directory to exist in the Vepol repo." >&2
  exit 1
fi

# 'reset' removes the copy (only one this script made) so it is created again below.
if [[ "${1:-}" == "reset" ]]; then
  if [[ -d "$DEMO_HUB" ]]; then
    if [[ ! -f "$DEMO_HUB/$DEMO_MARK" ]]; then
      echo "✘ $DEMO_HUB was not created by kb-demo; not removing it." >&2
      exit 1
    fi
    rm -rf "$DEMO_HUB"
  fi
  shift
  [[ $# -eq 0 ]] && set -- path
fi

# Create the private copy on first use; bring its task boards to the current
# kb-board format so 'kb-demo task' can write to them.
if [[ ! -d "$DEMO_HUB" ]]; then
  mkdir -p "$(dirname "$DEMO_HUB")"
  cp -R "$DEMO_SRC" "$DEMO_HUB"
  : > "$DEMO_HUB/$DEMO_MARK"
  while IFS= read -r board; do
    "$REPO_ROOT/bin/kb-board" check "$board" >/dev/null 2>&1 \
      || "$REPO_ROOT/bin/kb-board" migrate "$board" --write >/dev/null 2>&1 || true
  done < <(find "$DEMO_HUB" -name backlog.md -type f)
fi

# Special command: 'path' just prints the demo copy's path and exits
if [[ "${1:-}" == "path" ]]; then
  echo "$DEMO_HUB"
  exit 0
fi

if [[ $# -lt 1 ]]; then
  cat <<HELP
kb-demo — run kb-* commands against the Vepol demo wiki.

Demo hub: $DEMO_HUB (a private copy of $DEMO_SRC)

Usage:
  kb-demo brief                Run kb-brief on the demo
  kb-demo retro                Run kb-retro on the demo
  kb-demo search "<query>"     Run kb-search on the demo
  kb-demo backlog [--open]     Run kb-backlog on the demo
  kb-demo task "<text>"        Run kb-task on the demo (writes to the demo copy)
  kb-demo doctor               Run kb-doctor on the demo
  kb-demo path                 Print the demo copy's directory and exit
  kb-demo reset                Start the demo copy over from the repo
  kb-demo help                 Show this message

Any other kb-* subcommand also works:
  kb-demo <subcommand> [args...]
HELP
  exit 0
fi

# Resolve sub-command
SUBCMD="$1"
shift
TARGET_BIN="$REPO_ROOT/bin/kb-$SUBCMD"

if [[ ! -x "$TARGET_BIN" ]]; then
  # Try locating it in PATH (e.g. when installed via symlink)
  if command -v "kb-$SUBCMD" >/dev/null 2>&1; then
    TARGET_BIN="$(command -v "kb-$SUBCMD")"
  else
    echo "✘ kb-$SUBCMD not found at $REPO_ROOT/bin/ or in PATH" >&2
    echo "  Available subcommands: brief retro search backlog task doctor planner ..." >&2
    exit 1
  fi
fi

# Keep the demo synthetic. The demo hub has no bin/, so kb-brief resolves its
# helpers (agenda, mail, ideas, preflight, sender) from this repo's bin/ — which
# means they could otherwise reach the user's real calendar connector or, through
# TELEGRAM_* variables exported in the shell, the user's real Telegram chat.
#   KB_CALENDAR_DISABLE=1  — the calendar reader answers "disabled", never connects
#   KB_BRIEF_DRY=1         — kb-brief prints the brief and exits before delivery
#   KB_RETRO_DRY=1         — kb-retro prints the retro instead of sending it
export KB_CALENDAR_DISABLE=1
export KB_BRIEF_DRY="${KB_BRIEF_DRY:-1}"
export KB_RETRO_DRY="${KB_RETRO_DRY:-1}"

# Run the kb-* command with the demo hub.
# Different scripts read different env-var names — set both to be safe:
#   KB_HUB         — used by kb-brief, kb-retro, kb-task, kb-backlog, kb-doctor
#   KNOWLEDGE_HUB  — used by kb-search and a few older scripts
KB_HUB="$DEMO_HUB" KNOWLEDGE_HUB="$DEMO_HUB" exec "$TARGET_BIN" "$@"
