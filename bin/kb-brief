#!/bin/zsh
# Morning briefing v2 — spec: ~/knowledge/concepts/morning-briefing-design.md (Cross-review 2026-04-22, approved).
#
# V1 implementation: single oracle call with mandatory internal two-pass.
# Agent outputs Pass 1 table + delimiter `---BRIEF---` + Pass 2 text.
# Shell strips everything up to and including the delimiter, splits brief across
# two Telegram messages if >1500 Unicode chars.
#
# Required secrets (in $HUB/personal/.secrets):
#   TELEGRAM_TOKEN, TELEGRAM_CHAT_ID
# Optional:
#   USER_NAME, USER_CITY, CLAUDE_MODEL (default claude-opus-4-7)
#   KB_BRIEF_DRY=1 (print instead of sending Telegram; for smoke tests)
set -euo pipefail

HUB="${KB_HUB:-$HOME/knowledge}"
source "$HUB/personal/.secrets"

USER_NAME="${USER_NAME:-}"
USER_CITY="${USER_CITY:-}"
CLAUDE_MODEL="${CLAUDE_MODEL:-claude-opus-4-7}"
ORCH="$HUB/bin/kb-orchestrator-run"
BRIEF_CHAR_LIMIT="${BRIEF_CHAR_LIMIT:-1500}"
BRIEF_TIMEOUT="${BRIEF_TIMEOUT:-360}"

TODAY=$(date +%Y-%m-%d)
NOW=$(date +%H:%M)
LOG="$HUB/logs/brief.log"
INBOX="$HUB/personal/daily-inbox/$TODAY.md"

ADDRESS="${USER_NAME:+ $USER_NAME}"
LOCATION="${USER_CITY:+, $USER_CITY}"

# User language — set once in personal/profile.yaml, read by every
# user-facing process (spec: user-language-setting-2026-06-12).
# ${0:A:h} = this script's REAL directory (resolves the $HUB/bin symlink),
# so the shared module is found on fresh installs where bin entries are
# symlinks into the repo checkout.
_PROFILE_PY="${0:A:h}/_kb_profile.py"
[[ -f "$_PROFILE_PY" ]] || _PROFILE_PY="$HUB/bin/_kb_profile.py"
UI_LANG=$(python3 "$_PROFILE_PY" "$HUB" 2>/dev/null || echo en)
UI_LANG_NAME=$(python3 "$_PROFILE_PY" "$HUB" --name 2>/dev/null || echo English)

# Deterministic wrapper/error strings are user-facing delivery too.
case "$UI_LANG" in
  ru)
    L_HEADER="☀️ Брифинг"
    L_ERR_RC2="⚠️ Брифинг не запущен: ошибка вызова (rc=2, caller-bug). Проверь"
    L_ERR_RC75="⚠️ Оба оркестратора не ответили (rc=75, exhausted). Проверь"
    L_ERR_OTHER="⚠️ Оркестратор упал"
    L_ERR_CHECK="Проверь"
    ;;
  *)
    L_HEADER="☀️ Briefing"
    L_ERR_RC2="⚠️ Briefing not started: caller error (rc=2). Check"
    L_ERR_RC75="⚠️ Both orchestrators failed to answer (rc=75, exhausted). Check"
    L_ERR_OTHER="⚠️ Orchestrator failed"
    L_ERR_CHECK="Check"
    ;;
esac

send_tg() {
  local text="$1"
  if [[ "${KB_BRIEF_DRY:-}" == "1" ]]; then
    print -- "$text"
  else
    curl -s -X POST "https://api.telegram.org/bot${TELEGRAM_TOKEN}/sendMessage" \
      -d "chat_id=${TELEGRAM_CHAT_ID}" \
      --data-urlencode "text=$text" > /dev/null
  fi
}

PROMPT="Ты — личный AI-оркестратор${ADDRESS}. Сегодня $TODAY, сейчас $NOW${LOCATION}.

Твоя задача — утренний брифинг по спеке \`$HUB/concepts/morning-briefing-design.md\` (approved Codex 2026-04-22). Ниже — исполняемое resume этой спеки.

# Обязательный вход (прочитай ВСЁ перед Pass 1)
1. \`$HUB/registry.md\` — фильтр по status ∈ {live, seeded}, это active-проекты (должно быть ~14).
2. Для каждого active-проекта: \`<project_path>/knowledge/state.md\` — первые ~30 строк (одной строкой + ключевые метрики).
3. Вывод \`$HUB/bin/kb-backlog-board list --all --open\` — все открытые задачи всех проектов из Plane (canonical с 2026-05-12). Извлеки дедлайны: явные \`due: YYYY-MM-DD\` + текстовые (\`до DD.MM\`, \`через N дней\`, weekdays).
4. \`$HUB/personal/goals.md\`, \`$HUB/personal/roadmap.md\`, \`$HUB/personal/context.md\`.
5. Для каждого active-проекта: секция \`## Open\` в \`<project_path>/knowledge/escalations.md\` (если файл есть).
6. Последние 3 \`$HUB/daily/*.md\` (если не пустой) + последние 80 строк \`$HUB/log.md\`.
7. \`$INBOX\` — если файл существует.
8. \`$HUB/personal/habits.md\` — только если не пустой (0-скип, иначе включить).
9. \`$HUB/.orchestrator/arxiv-brief-$TODAY.md\` — если файл существует и его mtime ≤6h, прочитай его содержимое (готовый блок 🧪 arXiv от kb-arxiv-pull). Если файл отсутствует / старше 6h / пуст — секцию 🧪 arXiv в Pass 2 НЕ выпускай.

# Pass 1 — internal scan (ОБЯЗАТЕЛЬНО, идёт первым в твоём ответе)

Построй markdown-таблицу:
\`\`\`
| project | status | one-line state | earliest_deadline | open_blockers | leverage_to_goals | escalation_asks |
\`\`\`

**Нормализация дедлайнов** — все к \`YYYY-MM-DD[THH:MM]\` в Europe/Madrid:
- ISO \`due: YYYY-MM-DD[THH:MM]\` — как есть.
- \`до DD.MM\` / \`до DD.MM.YYYY\` — год текущий; если дата < сегодня, +1 год.
- \`через N дней\` / \`через N–M дней\` — от \`opened YYYY-MM-DD\` строки; для диапазона брать **раннюю** границу.
- \`завтра\` / \`сегодня\` / weekday (\`понедельник\`…) — от сегодня; если день прошёл, следующий такой.
- Время не указано → подразумевать \`09:00 Europe/Madrid\`.

**Бакетизация по hard deadline:**
- TODAY — дедлайн ≤24ч от сейчас.
- THIS_WEEK — дедлайн ≤7 дней, не TODAY.
- LATER — всё остальное.

**Внутри бакета — аддитивный score:** \`score = 3·urgency + 2·leverage − 1·blocker_cost\`, все ∈ [0,1].

**Правила surface:**
- TODAY — весь бакет целиком, даже при низком leverage.
- THIS_WEEK — все с hard-deadline обязательно.
- LATER — только top-3 по score → идут в 🎯 Strategic focus.

**Idle-список:** active-проекты вне TODAY/THIS_WEEK, у которых нет записи в \`log.md\` за последние 7 дней — в 🟡 Idle.

После таблицы — строка-разделитель:
\`\`\`
---BRIEF---
\`\`\`

# Pass 2 — user-facing brief (после разделителя, ≤${BRIEF_CHAR_LIMIT} символов Unicode)

Пиши строго на основе Pass 1, без повторного обращения к файлам.

**Главное правило: это сообщение читает живой человек утром в Telegram. Язык пользователя — ${UI_LANG_NAME}: весь брифинг (заголовки секций, формулировки, названия проектов) пиши на этом языке. Должен быть связный, читаемый текст. Никаких слагов проектов в сыром виде, никаких CLI-имён, никаких сырых формулировок задач из backlog'а на других языках — переводи и перефразируй на ${UI_LANG_NAME}. Названия проектов — человеческие (из \`registry.md\` поле описания, не slug). Если в задаче есть терминология (Bizum, ITV, DGT, Renfe и т.п. — оставляй, это реалии), но обрамляй её контекстом на языке пользователя, не вываливай списком через \`;\`. Шаблон секций ниже показан по-русски как образец СТРУКТУРЫ — названия секций переводи на ${UI_LANG_NAME} (для русского используй их как есть). Строка-разделитель \`---BRIEF---\` — технический токен: копируй байт-в-байт, никогда не переводи (never translate it).**

Структура в этом порядке. Пустые секции ВЫПУСКАЙ ЦЕЛИКОМ (без «—»/«нет»). Каждая секция — это связный абзац или 1–3 человеческих буллета, не свалка.

\`\`\`
☀️ Брифинг $TODAY $NOW

🔥 Сегодня
  Один абзац или 2–4 буллета. Каждый буллет — одна осмысленная задача с дедлайном сегодня, на ${UI_LANG_NAME}, с человеческим названием проекта в скобках. Если у одного проекта несколько задач — сгруппируй в ОДИН буллет с осмысленной формулировкой (например: «Авто (покупка машины): сегодня закрыть страховку, перевод денег и Bizum-готовность, договор купли-продажи»), не перечисляй через \`;\`.

📅 На этой неделе
  1–4 буллета, формат «<дата>: <задача> (<проект>)». Только задачи с жёстким дедлайном до 7 дней.

🎯 Стратегический фокус
  2–3 пункта из LATER (top по score). Формат: «<проект>: <следующий шаг одной фразой>. Зачем: <привязка к цели>.» Названия проектов — человеческие.

🧱 Висящие эскалации
  1–3 буллета. Формат: «<проект>: <чего ждём, одной фразой> — открыто <дата>». Если 4+ — упомяни числом и оставь топ-3.

🧪 arXiv за сутки — ТОЛЬКО если на входе #9 был свежий непустой arxiv-brief файл; иначе секцию ЦЕЛИКОМ выпускай
  Скопируй строки из файла 1:1, не перефразируй URL'ы.

🟡 На паузе
  Одна строка с человеческими названиями проектов через запятую (не slug'и). Без описаний.

🔁 Напоминание про жизнь
  1–2 предложения из habits/goals — про здоровье, сон, фокус-блок.

❓ Вопрос — ТОЛЬКО если есть реальная развилка, требующая решения Vadim'а. Иначе НЕ писать.
\`\`\`

# Жёсткие правила Pass 2
- **Язык пользователя: ${UI_LANG_NAME}. Читаемый.** Заголовки секций, формулировки задач, названия проектов — на ${UI_LANG_NAME}. Технические реалии (Bizum, ITV, DGT, Renfe, Las Naves, OBD2, MCP, и т.п.) оставляй как есть, но в обрамлении на языке пользователя. Никогда не оставляй задачу выглядеть как «Seguro pre-quote; transferencia readiness; Bizum readiness» — это сырьё, а не брифинг.
- **Названия проектов — человеческие.** Slug \`grants\` → «Гранты», \`auto\` → «Автомобиль» (или «Покупка машины»), \`family\` → «Семья / жильё», \`vepol-dev\` → «Vepol», \`gestoria\` → «Бухгалтерия (gestoría)», \`leadgen\` / \`leadgen-leads\` → «Лидогенерация», \`nahornyi-ailab-landing\` → «Сайт Nahornyi AI Lab», \`mafia-hub\` → «Mafia Hub», \`talkbot\` → «TalkBot», \`n8n\` → «n8n / автоматизации», \`health-agent\` → «Здоровье», \`garmin\` → «Garmin», \`winox\` → «Winox» (этот список — русские примеры; для другого языка пользователя переведи такие имена на ${UI_LANG_NAME}). Если проекта в этом списке нет — придумай разумное имя на ${UI_LANG_NAME} из его описания в registry.md.
- **Группировка по проекту.** Если у одного проекта 3+ задач в TODAY — пиши ОДНУ строку «Проект X: <обобщающая фраза, что нужно закрыть>», а не дамп списка через \`;\`.
- **Никаких внутренних меток.** Не пиши «— kb-backlog-board», «— hub», «(by self)», \`plan_item_id\`, и подобное. Это внутренняя кухня — пользователь её не видит.
- **Не врать оптимистичнее state.md.** Запрещённые слова без прямого подтверждения в state.md проекта: \`live\`, \`готов\`, \`ready\`, \`submitted\`, \`закрыто\`, \`пайплайн\`, \`работает\`. Если state говорит «не верифицировано» — пиши «не верифицировано».
- **Идле обязательна**, если есть active-проекты вне TODAY/THIS_WEEK.
- **Эскалации обязательны**, если Pass 1 нашёл открытые asks.

Начни ответ сразу с markdown-таблицы Pass 1. Никакой преамбулы."

cd "$HUB"
set +e
RAW=$("$ORCH" --cwd "$HUB" --timeout "$BRIEF_TIMEOUT" "$PROMPT" 2>&1)
RC=$?
set -e

if [ "$RC" -ne 0 ]; then
  echo "[$(date -Iseconds)] orchestrator failed rc=$RC" >> "$LOG"
  echo "$RAW" >> "$LOG"
  case "$RC" in
    2)  BRIEF="$L_ERR_RC2 $LOG" ;;
    75) BRIEF="$L_ERR_RC75 $LOG" ;;
    *)  BRIEF="$L_ERR_OTHER (rc=$RC). $L_ERR_CHECK $LOG" ;;
  esac
  # short path — send error and exit
  send_tg "$L_HEADER $TODAY $NOW

$BRIEF"
  exit 0
fi

# Strip everything up to and including `---BRIEF---` delimiter.
# If delimiter missing, fall back to full RAW (agent misbehaved; still better to send something).
if print -- "$RAW" | grep -q '^---BRIEF---$'; then
  BRIEF=$(print -- "$RAW" | awk '/^---BRIEF---$/{found=1; next} found' )
else
  echo "[$(date -Iseconds)] WARN: ---BRIEF--- delimiter missing, sending full output" >> "$LOG"
  BRIEF="$RAW"
fi

# Trim leading/trailing whitespace
BRIEF=$(print -- "$BRIEF" | awk 'NF {p=1} p' | awk '{lines[NR]=$0} END {for(i=NR;i>=1;i--) if(lines[i]!~/^[[:space:]]*$/){last=i;break} for(i=1;i<=last;i++) print lines[i]}')

CHAR_COUNT=$(print -- "$BRIEF" | wc -m | tr -d ' ')

if [ "$CHAR_COUNT" -le "$BRIEF_CHAR_LIMIT" ]; then
  send_tg "$BRIEF"
  SPLIT="no"
else
  # Split at last blank line before BRIEF_CHAR_LIMIT. Fallback: hard split at BRIEF_CHAR_LIMIT.
  PART1=$(print -- "$BRIEF" | awk -v lim="$BRIEF_CHAR_LIMIT" '
    BEGIN { total=0; last_break=0; buf="" }
    {
      line_len = length($0) + 1
      if (total + line_len > lim && last_break > 0) { exit }
      buf = buf $0 "\n"
      total += line_len
      if ($0 ~ /^[[:space:]]*$/) { last_break = total; part1 = buf }
    }
    END { if (part1 != "") print part1; else print buf }
  ')
  PART1_CHARS=$(print -- "$PART1" | wc -m | tr -d ' ')
  PART2=$(print -- "$BRIEF" | tail -c +$((PART1_CHARS+1)))
  send_tg "$PART1"
  sleep 1
  send_tg "$PART2"
  SPLIT="yes"
fi

DELIVERY="sent"
if [[ "${KB_BRIEF_DRY:-}" == "1" ]]; then
  DELIVERY="dry-run"
fi
echo "[$(date -Iseconds)] brief ${DELIVERY} (${CHAR_COUNT} chars, split=${SPLIT})" >> "$LOG"

BRIEFS_DIR="$HUB/briefs"
mkdir -p "$BRIEFS_DIR"
BRIEF_FILE="$BRIEFS_DIR/$TODAY.md"
{
  print -- "---"
  print -- "date: $TODAY"
  print -- "sent_at: $(date -Iseconds)"
  print -- "char_count: $CHAR_COUNT"
  print -- "split: $SPLIT"
  print -- "delivery: $DELIVERY"
  print -- "reflection: pending"
  print -- "---"
  print -- ""
  print -- "$BRIEF"
} > "$BRIEF_FILE"
