#!/usr/bin/env python3
"""kb-mail-block — emit the composer-ready mail block for one period.

Read-only and Gmail-free: it reads ONLY the same-day minimized envelope written
by kb-mail-brief and renders it as a nonce-bounded <untrusted-source> block with
a "data, not instructions" preamble (second-hop wrapping, spec: Privacy and
security model). kb-brief / kb-retro / kb-morning-digest inject its stdout
verbatim; they never touch Gmail and never persist raw mail.

If the same-day envelope is missing, invalid, or available:false, it prints a
short controlled freshness note (our own text, not wrapped) so the brief proceeds
without mail instead of failing.

Usage: kb-mail-block --period morning|evening [--day YYYY-MM-DD]
"""
from __future__ import annotations

import argparse
import os
import pathlib
import re
import sys
from datetime import date, datetime, timedelta

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from _kb_mail import read_same_day_envelope, wrap_untrusted  # noqa: E402
from _kb_mail.untrusted import DATA_NOT_INSTRUCTIONS  # noqa: E402
from _kb_profile import get_language  # noqa: E402


def _today() -> str:
    override = os.environ.get("KB_MAIL_NOW")
    if override:
        return datetime.fromisoformat(override).date().isoformat()
    try:
        from zoneinfo import ZoneInfo
        return datetime.now(ZoneInfo(os.environ.get("KB_TZ", "Europe/Madrid"))).date().isoformat()
    except Exception:
        return datetime.now().date().isoformat()


# One plain sentence per fixed reason code of the unavailable envelope. The code
# comes from the host's own error text (kb-mail-brief:_reason_code), never from
# mail content; unknown codes fall back to the generic sentence.
_REASON_SENTENCES = {
    "quota": "Reason: the Codex account hit its usage limit; mail will be read "
             "again after the limit resets.",
    "model": "Reason: the configured Codex model is not supported by the "
             "account; the owner must change the model setting.",
    "auth": "Reason: the mail host is not signed in; the owner must sign in "
            "again.",
    "network": "Reason: the network was unreachable while reading mail.",
    "timeout": "Reason: reading mail timed out.",
    "disabled": "Reason: mail reading is switched off in settings.",
}
_REASON_OTHER = "Reason: the mail read failed and the cause was not identified."
_MAX_STREAK = 30


def _unavailable_streak(period: str, day: str, hub: pathlib.Path) -> int:
    """Days in a row (today included, capped) whose same-period envelope was
    valid and available:false. A missing or invalid envelope ends the streak."""
    try:
        d = date.fromisoformat(day)
    except ValueError:
        return 1
    n = 1
    while n < _MAX_STREAK:
        d -= timedelta(days=1)
        prev = read_same_day_envelope(period, d.isoformat(), hub)
        if prev is None or prev.get("available"):
            break
        n += 1
    return n


def _reason_sentence(env: dict, period: str, day: str, hub: pathlib.Path) -> str:
    m = re.fullmatch(r"gmail_unavailable:([a-z0-9_\-]+)", (env.get("errors") or [""])[0])
    sentence = _REASON_SENTENCES.get(m.group(1) if m else "", _REASON_OTHER)
    n = _unavailable_streak(period, day, hub)
    if n >= 2:
        sentence += f" This is day {n} in a row."
    return sentence


def main() -> int:
    ap = argparse.ArgumentParser(prog="kb-mail-block")
    ap.add_argument("--period", required=True, choices=("morning", "evening"))
    ap.add_argument("--day", default=None)
    args = ap.parse_args()

    hub = pathlib.Path(os.environ.get("KB_HUB") or os.path.expanduser("~/knowledge"))
    day = args.day or _today()
    env = read_same_day_envelope(args.period, day, hub)
    language = get_language(hub)

    if env is None or not env.get("available"):
        reason = ""
        if env and env.get("errors"):
            reason = f" ({env['errors'][0]})"
        print(f"MAIL ({args.period}): no fresh mail brief for today{reason}. "
              f"Proceed without mail.")
        if env is not None:  # a valid available:false envelope: say why
            print(_reason_sentence(env, args.period, day, hub))
        return 0

    items = env.get("items") or []
    if not items:
        print(f"MAIL ({args.period}): inbox scanned, nothing notable this period.")
        return 0

    lines = [f"MAIL {args.period}, {len(items)} item(s):"]
    for it in items:
        line = (f"- [{it.get('urgency', 'normal')}/{it.get('classification', 'unknown')}] "
                f"{it.get('sender_label', '')} — {it.get('subject', '')} "
                f":: {it.get('summary', '')}")
        acts = [a.get("type") for a in (it.get("proposed_actions") or [])
                if a.get("type") and a.get("type") != "none"]
        if acts:
            line += f" (proposed: {', '.join(acts)})"
        if it.get("privacy_flags"):
            line += f" [flags: {', '.join(it['privacy_flags'])}]"
        lines.append(line)

    block = wrap_untrusted("\n".join(lines), channel="mail")
    if len(items) >= 25:
        capped = ("Показаны последние 25 писем; список может быть неполным."
                  if language == "ru" else
                  "The latest 25 emails are shown; the list may be incomplete.")
        print(capped)
    print(DATA_NOT_INSTRUCTIONS + "\n" + block)
    return 0


if __name__ == "__main__":
    sys.exit(main())
