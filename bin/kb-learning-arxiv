def now_iso() -> str:
    return datetime.datetime.now().astimezone().isoformat(timespec="seconds")


def today_iso() -> str:
    return datetime.date.today().isoformat()


def log(msg: str) -> None:
    LOG.parent.mkdir(parents=True, exist_ok=True)
    with LOG.open("a", encoding="utf-8") as f:
        f.write(f"[{now_iso()}] learning-arxiv: {msg}\n")


def atomic_write(path: pathlib.Path, content: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=str(path.parent), prefix=f".{path.name}.", suffix=".tmp")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(content)
        os.replace(tmp, path)
    except Exception:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def rel(path: pathlib.Path) -> str:
    try:
        return str(path.relative_to(HUB))
    except ValueError:
        return str(path)


# --------------------------------------------------------------------------
# Config (read-only; legacy keys are ignored with a single log line)
# --------------------------------------------------------------------------

def load_config() -> dict:
    cfg = {
        "learning_topic": "ai_agents",
        "max_papers": MAX_PAPERS_DEFAULT,
        "arxiv_categories": list(DEFAULT_CATEGORIES),
        "social_check": "grok",
    }
    if not CONFIG_PATH.is_file():
        return cfg
    legacy_present = []
    for raw in CONFIG_PATH.read_text(encoding="utf-8").splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or ":" not in line:
            continue
        # Inline comments ("max_papers: 3 # limit") must not poison values.
        line = re.split(r"\s+#", line, maxsplit=1)[0].strip()
        if ":" not in line:
            continue
        key, val = line.split(":", 1)
        key, val = key.strip(), val.strip().strip("'\"")
        if key in LEGACY_KEYS:
            legacy_present.append(key)
            continue
        if key == "max_papers":
            try:
                # The scheduled contract is "up to three papers" — a config
                # typo must not flood the digest.
                cfg["max_papers"] = max(1, min(3, int(val)))
            except ValueError:
                pass
        elif key == "arxiv_categories":
            m = re.match(r"^\[(.*)\]$", val)
            if m:
                cats = [c.strip().strip("'\"") for c in m.group(1).split(",") if c.strip()]
                if cats:
                    cfg["arxiv_categories"] = cats
        elif key in ("learning_topic", "social_check", "focus_project"):
            if val:
                cfg[key] = val
    if legacy_present:
        log(f"legacy config keys ignored: {', '.join(sorted(legacy_present))}")
    return cfg


# --------------------------------------------------------------------------
# Paths / manifest / lock
# --------------------------------------------------------------------------

def manifest_path(d: str) -> pathlib.Path:
    return ORCH / f"learning-arxiv-{d}.json"


def lock_path(d: str) -> pathlib.Path:
    return ORCH / f"learning-arxiv-{d}.lock"


def report_path(d: str) -> pathlib.Path:
    return REPORTS / f"learning-arxiv-summary-{d}.md"


def snapshot_path(d: str) -> pathlib.Path:
    return SOURCES / f"arxiv-learning-snapshot-{d}.md"


def social_path(d: str) -> pathlib.Path:
    return SOURCES / f"arxiv-learning-social-grok-{d}.md"


def translation_path(d: str) -> pathlib.Path:
    return SOURCES / f"arxiv-learning-translation-codex-{d}.md"


def load_manifest(d: str) -> dict:
    p = manifest_path(d)
    if not p.is_file():
        return {}
    try:
        return json.loads(p.read_text(encoding="utf-8"))
    except Exception as exc:
        log(f"{d}: manifest parse failed: {exc}; starting fresh")
        return {}


def save_manifest(d: str, manifest: dict) -> None:
    atomic_write(manifest_path(d), json.dumps(manifest, ensure_ascii=False, indent=2) + "\n")


def acquire_lock(d: str):
    """Advisory flock — auto-released on process exit/crash; a stale lock
    file on disk never blocks future runs (spec: Manifest Schema). Opened
    in append mode so a contender that fails the flock never truncates the
    holder's pid/started_at metadata."""
    ORCH.mkdir(parents=True, exist_ok=True)
    fh = lock_path(d).open("a", encoding="utf-8")
    try:
        fcntl.flock(fh.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        fh.close()
        return None
    fh.seek(0)
    fh.truncate(0)
    fh.write(f"pid={os.getpid()} started_at={now_iso()}\n")
    fh.flush()
    return fh


# --------------------------------------------------------------------------
# arXiv fetch + parse
# --------------------------------------------------------------------------

def build_query(categories: list) -> str:
    cat_clause = "+OR+".join(f"cat:{c}" for c in categories)
    return (
        f"{API_BASE}?search_query=({cat_clause})"
        f"&sortBy=submittedDate&sortOrder=descending&max_results=100"
    )


def fetch_atom(categories: list) -> str:
    fixture = os.environ.get("KB_LEARNING_ARXIV_FIXTURE", "").strip()
    if fixture:
        return pathlib.Path(fixture).read_text(encoding="utf-8")
    if os.environ.get("KB_LEARNING_ARXIV_DISABLE_NETWORK", "").strip() in {"1", "true", "yes"}:
        raise RuntimeError("network disabled and no fixture provided")
    url = build_query(categories)
    log(f"GET {url}")
    proc = subprocess.run(
        ["curl", "-sSL", "--fail", "--max-time", str(HTTP_TIMEOUT), "-A", USER_AGENT, url],
        capture_output=True, text=True, check=False, stdin=subprocess.DEVNULL,
    )
    if proc.returncode != 0:
        raise RuntimeError(
            f"curl rc={proc.returncode}: {(proc.stderr or '').strip()[:200]}"
        )
    return proc.stdout


def parse_atom(xml_text: str) -> list:
    out = []
    root = ET.fromstring(xml_text)
    for entry in root.findall("a:entry", ATOM_NS):
        try:
            entry_id = (entry.findtext("a:id", default="", namespaces=ATOM_NS) or "").strip()
            arxid = re.sub(r"v\d+$", "", entry_id.rsplit("/", 1)[-1])
            if not arxid:
                continue
            title = re.sub(r"\s+", " ", (entry.findtext("a:title", default="", namespaces=ATOM_NS) or "").strip())
            abstract = re.sub(r"\s+", " ", (entry.findtext("a:summary", default="", namespaces=ATOM_NS) or "").strip())
            published = (entry.findtext("a:published", default="", namespaces=ATOM_NS) or "").strip()
            authors = []
            for a in entry.findall("a:author", ATOM_NS):
                n = a.findtext("a:name", default="", namespaces=ATOM_NS)
                if n:
                    authors.append(n.strip())
            cat_el = entry.find("arxiv:primary_category", ATOM_NS)
            primary_cat = cat_el.attrib.get("term", "") if cat_el is not None else ""
            out.append({
                "id": arxid,
                "title": title,
                "abstract": abstract,
                "authors": authors,
                "published": published,
                "primary_category": primary_cat,
                "link": f"https://arxiv.org/abs/{arxid}",
            })
        except Exception as exc:
            log(f"skip entry parse error: {exc}")
    return out


# --------------------------------------------------------------------------
# Deterministic scoring + selection (spec: Deterministic scoring formula v1)
# --------------------------------------------------------------------------

def topic_groups(text: str) -> set:
    return {name for name, rx in TOPIC_GROUPS if rx.search(text)}


def score_paper(paper: dict) -> dict:
    title, abstract = paper["title"], paper["abstract"]
    title_groups = topic_groups(title)
    abstract_groups = topic_groups(abstract)
    topic_relevance = min(10, 2 * len(title_groups) + len(abstract_groups))
    abstract_signal = sum(1 for rx in (PROBLEM_RE, METHOD_RE, RESULT_RE, QUANT_RE) if rx.search(abstract))
    practicality = 0
    if PRACT_CODE_RE.search(f"{title} {abstract}"):
        practicality += 1
    if len(title_groups | abstract_groups) >= 2:
        practicality += 1
    if PRACT_DEPLOY_RE.search(f"{title} {abstract}"):
        practicality += 1
    scores = {
        "topic_relevance": topic_relevance,
        "abstract_signal": min(4, abstract_signal),
        "novelty_practicality": min(3, practicality),
        "author_signal": 0,  # v1: never guess affiliations
    }
    scores["final"] = (3 * scores["topic_relevance"] + 2 * scores["abstract_signal"]
                       + 2 * scores["novelty_practicality"])
    paper["scores"] = scores
    paper["_groups"] = sorted(title_groups | abstract_groups)
    return scores


def jaccard_tokens(paper: dict) -> set:
    words = re.findall(r"[a-z]{4,}", f"{paper['title']} {paper['abstract']}".lower())
    return {w for w in words if w not in STOP_WORDS}


def jaccard(a: set, b: set) -> float:
    if not a or not b:
        return 0.0
    return len(a & b) / len(a | b)


def rank_candidates(papers: list) -> list:
    """Sort by final score desc, then newer published, then smaller arXiv id
    (chained stable sorts — fully reproducible for the same input)."""
    ranked = sorted(papers, key=lambda p: p["id"])
    ranked.sort(key=lambda p: p.get("published", ""), reverse=True)
    ranked.sort(key=lambda p: p["scores"]["final"], reverse=True)
    return ranked


def select_papers(papers: list, max_papers: int) -> tuple:
    relevant = [p for p in papers if score_paper(p)["topic_relevance"] > 0]
    ranked = rank_candidates(relevant)
    selected, skipped_dup = [], []
    for cand in ranked:
        if len(selected) >= max_papers:
            break
        toks = jaccard_tokens(cand)
        dup_of = next(
            (s for s in selected if jaccard(toks, jaccard_tokens(s)) > JACCARD_LIMIT),
            None,
        )
        if dup_of is not None:
            cand["_dup_of"] = dup_of["id"]
            skipped_dup.append(cand)
            continue
        cand["reason"] = (
            f"final={cand['scores']['final']} "
            f"(topics: {', '.join(cand['_groups']) or '—'})"
        )
        selected.append(cand)
    # Diversity escape hatch: if duplicates were skipped and we still have
    # room, take them back in rank order and note the cluster.
    if len(selected) < max_papers:
        for cand in skipped_dup:
            if len(selected) >= max_papers:
                break
            cand["reason"] = (
                f"final={cand['scores']['final']} — near-duplicate cluster with "
                f"{cand['_dup_of']}, taken to fill the selection"
            )
            selected.append(cand)
    selected_ids = {p["id"] for p in selected}
    runner_ups = [
        {"id": p["id"], "title": p["title"], "scores": p["scores"],
         "reason_rejected": ("near-duplicate of " + p["_dup_of"]) if p.get("_dup_of")
         else "lower final score"}
        for p in ranked if p["id"] not in selected_ids
    ]
    return selected, runner_ups, len(relevant)


# --------------------------------------------------------------------------
# Deterministic Russian summaries (bounded by title+abstract; no invention)
# --------------------------------------------------------------------------

def split_sentences(text: str) -> list:
    return [s.strip() for s in re.split(r"(?<=[.!?])\s+", text.strip()) if s.strip()]


def truncate_sentence(text: str, max_chars: int) -> str:
    if len(text) <= max_chars:
        return text
    cut = text[:max_chars]
    last = max(cut.rfind(". "), cut.rfind("? "), cut.rfind("! "))
    if last > 40:
        return cut[: last + 1]
    last_space = cut.rfind(" ")
    return (cut[:last_space] + "…") if last_space > 0 else cut + "…"


def studied_text(paper: dict, limit: int = 240) -> str:
    sents = split_sentences(paper["abstract"])
    for s in sents:
        if PROBLEM_RE.search(s):
            return truncate_sentence(s, limit)
    return truncate_sentence(sents[0], limit) if sents else "—"


def found_text(paper: dict, limit: int = 240) -> str:
    sents = split_sentences(paper["abstract"])
    for s in sents:
        if RESULT_RE.search(s) and not PROBLEM_RE.search(s):
            return truncate_sentence(s, limit)
    for s in sents:
        if RESULT_RE.search(s):
            return truncate_sentence(s, limit)
    return L("no_result")


def method_text(paper: dict, limit: int = 240) -> str:
    sents = split_sentences(paper["abstract"])
    for s in sents:
        if METHOD_RE.search(s):
            return truncate_sentence(s, limit)
    return L("method_unavailable")


def why_text(paper: dict) -> str:
    """Per-paper practical sentence: Grok's specific one when available,
    else the topic-group template (degraded mode)."""
    loc = _loc_field(paper, "why")
    if loc:
        return loc
    templates = L("why_templates")
    for name, _rx in TOPIC_GROUPS:
        if name in paper.get("_groups", []):
            return templates[name]
    return templates["_default"]


def studied_display(paper: dict, limit: int = 240) -> str:
    """Localized summary (Codex bounded translation) when available; otherwise
    the deterministic English abstract extract — an honest degraded mode,
    marked in the manifest as summary_source=fallback_en."""
    loc = _loc_field(paper, "studied")
    if loc:
        return truncate_sentence(loc, limit)
    return studied_text(paper, limit)


def found_display(paper: dict, limit: int = 240) -> str:
    loc = _loc_field(paper, "found")
    if loc:
        return truncate_sentence(loc, limit)
    return found_text(paper, limit)


def method_display(paper: dict, limit: int = 240) -> str:
    loc = _loc_field(paper, "method")
    if loc:
        return truncate_sentence(loc, limit)
    return method_text(paper, limit)


def abstract_display(paper: dict, limit: int = 700) -> str:
    loc = _loc_field(paper, "abstract")
    if loc:
        return truncate_sentence(loc, limit)
    return L("abstract_unavailable")


def build_summary(paper: dict) -> str:
    return (
        f"{L('studied')}: {studied_display(paper)} "
        f"{L('method')}: {method_display(paper)} "
        f"{L('found')}: {found_display(paper)} "
        f"{L('why')}: {why_text(paper)}"
    )


def render_authors(authors: list) -> str:
    if not authors:
        return "—"
    if len(authors) <= 3:
        return ", ".join(authors)
    return ", ".join(authors[:3]) + " et al."


# --------------------------------------------------------------------------
# Grok social check (one call covering all selected papers)
# --------------------------------------------------------------------------

def grok_bin() -> str:
    configured = os.environ.get("KB_LEARNING_ARXIV_GROK_BIN", "").strip()
    if configured:
        return configured
    return str(pathlib.Path.home() / ".grok" / "bin" / "grok")


def codex_bin() -> str:
    configured = os.environ.get("KB_LEARNING_ARXIV_TRANSLATE_BIN", "").strip()
    if configured:
        return configured
    return "/Applications/Codex.app/Contents/Resources/codex"


def run_codex(date_iso: str, papers: list) -> tuple:
    """Offline translation/analysis via Codex. Returns (message, rc,
    stderr_tail). Never raises. `codex exec --sandbox read-only` (no edits)
    with `--output-last-message <file>` capturing ONLY the final agent message
    (clean; smoke-confirmed it writes under read-only). stdin=DEVNULL is
    mandatory (codex 0.138+ hangs on open stdin). Prompt is a positional arg.
    Falls back to stdout if the capture file is empty — parse_loc tolerates
    banner noise via outermost-brace extraction."""
    prompt = codex_prompt(date_iso, papers)
    prompt_file = ORCH / f"learning-arxiv-codex-prompt-{date_iso}.md"
    atomic_write(prompt_file, prompt)
    out_file = ORCH / f"learning-arxiv-codex-out-{date_iso}.txt"
    try:
        out_file.unlink()
    except OSError:
        pass
    timeout = int(os.environ.get("KB_LEARNING_ARXIV_CODEX_TIMEOUT", str(CODEX_TIMEOUT_DEFAULT)))
    cmd = [
        codex_bin(), "exec",
        "-C", str(HUB),
        "--skip-git-repo-check",
        "--sandbox", "read-only",
        "--output-last-message", str(out_file),
        prompt,
    ]
    try:
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout,
                              check=False, stdin=subprocess.DEVNULL)
    except subprocess.TimeoutExpired:
        return "", -1, "codex timeout"
    except Exception as exc:
        return "", -1, str(exc)[-300:]
    msg = ""
    try:
        if out_file.is_file():
            msg = out_file.read_text(encoding="utf-8")
    except OSError:
        msg = ""
    if not msg.strip():
        msg = proc.stdout or ""
    return msg, proc.returncode, (proc.stderr or "")[-300:]


def grok_prompt(date_iso: str, papers: list) -> str:
    """X/Reddit social-context prompt ONLY. Translation/analysis moved to the
    Codex call (spec: learning-arxiv-split-translation-social-2026-06-17), so
    Grok no longer carries any *_loc field — only the social search it alone
    can do. prior_context stays in the user's language."""
    blocks = []
    for p in papers:
        phrases = ", ".join(p.get("_groups", [])[:5]) or "AI research"
        blocks.append(
            f"- id: {p['id']}\n  title: {p['title']}\n"
            f"  authors: {render_authors(p['authors'])}\n  link: {p['link']}\n"
            f"  key phrases: {phrases}\n"
            f"  abstract: {p['abstract'][:1200]}"
        )
    papers_block = "\n".join(blocks)
    return f"""# Social context check for today's arXiv learning digest ({date_iso})

The user's language is: {UI_LANG_NAME}.

For EACH paper below, search X/Twitter and Reddit for discussion of the exact
paper (title/authors/arXiv id) AND broader prior discussion of its core idea.
Separate exact-paper discussion from prior idea discussion. Do NOT translate or
summarize the paper — that is handled elsewhere; only report social signal.

Papers:
{papers_block}

Return ONLY one JSON object, no prose before or after, exactly this shape:
{{"papers": [{{"id": "<arxiv id>", "x_status": "found|weak|not_found|degraded",
"reddit_status": "found|weak|not_found|degraded", "evidence": "<short links/snippets>",
"prior_context": "<one sentence in {UI_LANG_NAME} about prior discussion of the idea>"}}]}}

Rules: use `not_found` only when the search WORKED and found nothing; if a
search surface failed or was blocked, use `degraded` for that channel. Never
invent a `not_found` for a search you could not run.
"""


def codex_prompt(date_iso: str, papers: list) -> str:
    """Offline translation/analysis prompt for Codex. Bounded strictly to the
    given title+abstract — no web, no social, no invented numbers. Emits the
    same `{{"papers": [...]}}` envelope Grok used so parse_loc()'s outermost-
    brace extraction works (a bare top-level array would break find/rfind)."""
    blocks = []
    for p in papers:
        blocks.append(
            f"- id: {p['id']}\n  title: {p['title']}\n"
            f"  abstract: {p['abstract'][:1200]}"
        )
    papers_block = "\n".join(blocks)
    return f"""# Translate + analyze today's arXiv papers ({date_iso})

The user's language is: {UI_LANG_NAME}. For EACH paper below, summarize it in
{UI_LANG_NAME}, STRICTLY from the given title+abstract — no outside claims, no
invented numbers, no web search:
- `title_loc`: short title translation in {UI_LANG_NAME} (<= 120 chars)
- `abstract_loc`: 2-4 sentences in {UI_LANG_NAME} translating/compressing the abstract only, with every acronym and technical term expanded inline on first mention per paper (<= 800 chars)
- `studied_loc`: 1-2 sentences in {UI_LANG_NAME} — what exactly they studied (<= 280 chars)
- `method_loc`: 1-2 sentences in {UI_LANG_NAME} — how they studied it and on what exact data/benchmark/experiment/model/setup, if stated in the abstract; if not stated, say that the abstract does not specify this (<= 280 chars)
- `found_loc`: 1-2 sentences in {UI_LANG_NAME} — what they found/claim, with numbers from the abstract when present (<= 280 chars)
- `why_loc`: one practical sentence in {UI_LANG_NAME} — why THIS paper matters to a user building a local AI orchestrator with agents, memory/KB and tool-use (derived from the abstract, <= 160 chars)

Papers:
{papers_block}

Return ONLY one JSON object, no prose before or after, exactly this shape:
{{"papers": [{{"id": "<arxiv id>",
"title_loc": "<title in {UI_LANG_NAME}>",
"abstract_loc": "<translated/compressed abstract in {UI_LANG_NAME}, terms expanded inline>",
"studied_loc": "<sentences in {UI_LANG_NAME}>",
"method_loc": "<how it was researched, and on what data/benchmark/experiment/setup; or 'not specified in the abstract' in {UI_LANG_NAME}>",
"found_loc": "<sentences in {UI_LANG_NAME}>",
"why_loc": "<practical sentence in {UI_LANG_NAME}>"}}]}}

Rules: `studied_loc`/`method_loc`/`found_loc`/`abstract_loc` are
translations/compressions of the provided abstract only — never add facts the
abstract does not state. For `method_loc`, prefer concrete nouns from the
abstract such as dataset, benchmark, experiment, user study, simulation, proof,
corpus, model family, evaluation setup, or deployment setup. If the abstract
does not say how/on what the work was evaluated, explicitly say that this is
not specified in the abstract.
`abstract_loc` is the user's main quick-understanding field. Expand acronyms
and technical terms inline on first mention for each paper in the form
`ACRONYM (English expansion, rendering in {UI_LANG_NAME})` — e.g.
`LLM (large language model, …)`, `RAG (retrieval-augmented generation, …)`,
`MCP (Model Context Protocol, …)` — filling each `…` with the
{UI_LANG_NAME} rendering (when the target IS English, the two parts coincide).
Write the prose genuinely in {UI_LANG_NAME}: translate the phrasing, do not
copy English sentences from the abstract; keep Latin script only for proper
nouns, model/dataset/benchmark names and established terms (MCP, RAG).
"""


def run_grok(date_iso: str, papers: list) -> tuple:
    """Returns (stdout, rc, stderr_tail). Never raises."""
    prompt_file = ORCH / f"learning-arxiv-grok-prompt-{date_iso}.md"
    atomic_write(prompt_file, grok_prompt(date_iso, papers))
    timeout = int(os.environ.get("KB_LEARNING_ARXIV_GROK_TIMEOUT", str(GROK_TIMEOUT_DEFAULT)))
    cmd = [
        grok_bin(),
        "--cwd", str(HUB),
        "--prompt-file", str(prompt_file),
        "--output-format", "plain",
        "--permission-mode", "acceptEdits",
        "--max-turns", "120",
        "--no-subagents",
        "--no-memory",
    ]
    try:
        # stdin=DEVNULL: CLI agents crash or hang on an inherited closed/open
        # stdin under background runners (same class as the codex>=0.138
        # spawner incident 2026-06-11; grok 0.2.22 SIGSEGVs, repro 2026-06-12).
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout,
                              check=False, stdin=subprocess.DEVNULL)
        return proc.stdout, proc.returncode, (proc.stderr or "")[-300:]
    except subprocess.TimeoutExpired:
        return "", -1, "grok timeout"
    except Exception as exc:
        return "", -1, str(exc)[-300:]


def parse_papers_json(text: str) -> dict:
    """Best-effort: outermost JSON object → {paper_id: record}. Used for both
    the Codex translation message (clean -o capture) and Grok social stdout.
    A bare top-level array would NOT parse here — both prompts pin the
    {"papers": [...]} envelope on purpose (a malformed/array envelope degrades
    ALL papers wholesale, not per-paper)."""
    text = (text or "").strip()
    start, end = text.find("{"), text.rfind("}")
    if start == -1 or end <= start:
        return {}
    try:
        data = json.loads(text[start:end + 1])
    except json.JSONDecodeError:
        return {}
    out = {}
    for rec in data.get("papers", []) if isinstance(data, dict) else []:
        if isinstance(rec, dict) and rec.get("id"):
            out[str(rec["id"])] = rec
    return out


def accept_loc(text: str) -> bool:
    """For ru the Cyrillic check reliably catches an English slip; for all
    other targets accept non-empty (documented degraded validation — spec:
    user-language-setting-2026-06-12)."""
    if not text:
        return False
    if UI_LANG == "ru":
        return bool(CYRILLIC_RE.search(text))
    return True


def translate_check(date_iso: str, papers: list) -> tuple:
    """Codex offline translation/analysis. Mutates papers in place with the
    *_loc fields + per-paper abstract_source (codex|unavailable) and
    summary_source (codex|fallback_en). Returns (status, codex_rc,
    stderr_tail, raw_message). INDEPENDENT of the Grok social call: a Codex
    failure degrades only translation, never the social signal. status is
    `degraded` (whole call failed), `partial` (some papers fell back to the
    deterministic English extract), or `ok`."""
    if not papers:
        return "ok", None, "", ""
    msg, rc, stderr_tail = run_codex(date_iso, papers)
    by_id = parse_papers_json(msg) if rc == 0 and msg.strip() else {}
    whole_call_failed = rc != 0 or not msg.strip() or not by_id
    any_fallback = False
    for p in papers:
        rec = by_id.get(p["id"], {})
        # Codex's bounded translation of title+abstract. Missing/rejected →
        # deterministic English-extract fallback, explicitly marked, so the
        # digest is honest about its source.
        abstract_loc = truncate_sentence(str(rec.get("abstract_loc", "") or "").strip(), 800)
        if accept_loc(abstract_loc):
            p["abstract_loc"] = abstract_loc
            p["abstract_source"] = "codex"
        else:
            p["abstract_source"] = "unavailable"
            any_fallback = True
        studied_loc = truncate_sentence(str(rec.get("studied_loc", "") or "").strip(), 300)
        method_loc = truncate_sentence(str(rec.get("method_loc", "") or "").strip(), 300)
        found_loc = truncate_sentence(str(rec.get("found_loc", "") or "").strip(), 300)
        if accept_loc(studied_loc) and accept_loc(method_loc) and accept_loc(found_loc):
            p["studied_loc"] = studied_loc
            p["method_loc"] = method_loc
            p["found_loc"] = found_loc
            p["summary_source"] = "codex"
        else:
            p["summary_source"] = "fallback_en"
            any_fallback = True
        title_loc = truncate_sentence(str(rec.get("title_loc", "") or "").strip(), 140)
        if accept_loc(title_loc):
            p["title_loc"] = title_loc
        why_loc = truncate_sentence(str(rec.get("why_loc", "") or "").strip(), 180)
        if accept_loc(why_loc):
            p["why_loc"] = why_loc
    if whole_call_failed:
        status = "degraded"
    elif any_fallback:
        status = "partial"
    else:
        status = "ok"
    return status, rc, stderr_tail, msg


def social_check(date_iso: str, papers: list) -> tuple:
    """X/Reddit social signal via Grok ONLY (translation moved to Codex).
    Mutates papers in place with per-paper p['social']. Returns
    (social_check_status, grok_rc, stderr_tail, raw_stdout). INDEPENDENT of
    translation: a Grok failure degrades only the social lines."""
    if not papers:
        return "ok", None, "", ""
    stdout, rc, stderr_tail = run_grok(date_iso, papers)
    by_id = parse_papers_json(stdout) if rc == 0 and stdout.strip() else {}
    whole_call_failed = rc != 0 or not stdout.strip() or not by_id
    any_degraded = False
    all_parsed = True
    for p in papers:
        rec = by_id.get(p["id"], {})
        social = {}
        for ch in ("x_status", "reddit_status"):
            val = str(rec.get(ch, "")).strip()
            if whole_call_failed or val not in SOCIAL_STATUSES:
                # Search failure or unparseable value is degraded — never an
                # invented not_found (spec hard rule).
                social[ch] = "degraded"
                any_degraded = True
                all_parsed = False
            else:
                social[ch] = val
                if val == "degraded":
                    any_degraded = True
        social["evidence"] = str(rec.get("evidence", "") or "")[:500]
        social["prior_context"] = truncate_sentence(str(rec.get("prior_context", "") or ""), 200)
        p["social"] = social
    if whole_call_failed:
        status = "degraded"
    elif any_degraded or not all_parsed:
        status = "partial"
    else:
        status = "ok"
    return status, rc, stderr_tail, stdout


# --------------------------------------------------------------------------
# Renderers
# --------------------------------------------------------------------------

def render_status(value: str) -> str:
    return L("statuses").get(value, value)


def _loc_field(paper: dict, key: str):
    """Localized LLM field with legacy `_ru` fallback (target ru only)."""
    val = paper.get(f"{key}_loc")
    if not val and UI_LANG == "ru":
        val = paper.get(f"{key}_ru")
    return val


def title_display(paper: dict, limit: int = 160) -> str:
    loc = _loc_field(paper, "title")
    if loc:
        return truncate_sentence(loc, limit)
    return truncate_sentence(paper.get("title", ""), limit)


def reason_text(paper: dict) -> str:
    """Human-readable localized selection reason, computable from manifest
    fields alone (works on the stage-cache path too)."""
    group_names = L("groups")
    groups = [group_names.get(g, g) for g in paper.get("_groups", [])]
    s = paper.get("scores", {})
    parts = []
    if groups:
        parts.append(f"{L('topics')}: {', '.join(groups)}")
    sig = s.get("abstract_signal")
    if sig is not None:
        parts.append(L("signal").format(sig=sig))
    if s.get("final") is not None:
        parts.append(L("score").format(final=s["final"]))
    if paper.get("_dup_of"):
        parts.append(L("dup_fill").format(dup=paper["_dup_of"]))
    return "; ".join(parts) or L("relevant_default")


def render_snapshot(date_iso: str, papers: list, runner_ups: list, fetched: int, relevant: int) -> str:
    lines = [
        "---",
        "type: source",
        "kind: arxiv-learning-snapshot",
        f"date: {date_iso}",
        f"total_fetched: {fetched}",
        f"total_relevant: {relevant}",
        f"selected: {len(papers)}",
        "generator: kb-learning-arxiv v1",
        "---",
        "",
        f"# arXiv learning snapshot — {date_iso}",
        "",
        "## Selected",
        "",
    ]
    for p in papers:
        lines.append(
            f"- **{p['title']}** — {render_authors(p['authors'])}\n"
            f"  {p['link']} · {p.get('primary_category', '')} · {p.get('published', '')[:10]}\n"
            f"  scores: {json.dumps(p['scores'])}\n"
            f"  reason: {p['reason']}\n"
            f"  {p['abstract'][:600]}\n"
        )
    if runner_ups:
        lines.append("## Runner-ups\n")
        for r in runner_ups:
            lines.append(f"- {r['id']} **{r['title']}** — {r['reason_rejected']} (final={r['scores']['final']})")
    return "\n".join(lines) + "\n"


def render_social_source(date_iso: str, papers: list, status: str, rc, stderr_tail: str, raw: str) -> str:
    lines = [
        "---",
        "type: source",
        "kind: arxiv-learning-social-grok",
        f"date: {date_iso}",
        f"social_check: {status}",
        f"grok_rc: {rc if rc is not None else 'null'}",
        "generator: kb-learning-arxiv v1",
        "---",
        "",
        f"# Grok social check — {date_iso}",
        "",
    ]
    for p in papers:
        s = p.get("social", {})
        lines.append(
            f"## {p['id']} {p['title']}\n"
            f"- X: {s.get('x_status', 'degraded')}\n"
            f"- Reddit: {s.get('reddit_status', 'degraded')}\n"
            f"- Evidence: {s.get('evidence', '') or '—'}\n"
            f"- Prior context: {s.get('prior_context', '') or '—'}\n"
        )
    if stderr_tail:
        lines.append(f"## Grok stderr tail\n\n```\n{stderr_tail}\n```\n")
    lines.append("## Raw stdout\n\n```\n" + (raw or "")[:4000] + "\n```")
    return "\n".join(lines) + "\n"


def render_translation_source(date_iso: str, papers: list, status: str, rc, stderr_tail: str, raw: str) -> str:
    lines = [
        "---",
        "type: source",
        "kind: arxiv-learning-translation-codex",
        f"date: {date_iso}",
        f"translate_check: {status}",
        f"codex_rc: {rc if rc is not None else 'null'}",
        "generator: kb-learning-arxiv v1",
        "---",
        "",
        f"# Codex translation/analysis — {date_iso}",
        "",
    ]
    for p in papers:
        lines.append(
            f"## {p['id']} {p['title']}\n"
            f"- abstract_source: {p.get('abstract_source', 'unavailable')}\n"
            f"- summary_source: {p.get('summary_source', 'fallback_en')}\n"
            f"- title_loc: {p.get('title_loc', '') or '—'}\n"
            f"- abstract_loc: {p.get('abstract_loc', '') or '—'}\n"
            f"- method_loc: {p.get('method_loc', '') or '—'}\n"
        )
    if stderr_tail:
        lines.append(f"## Codex stderr tail\n\n```\n{stderr_tail}\n```\n")
    lines.append("## Raw message\n\n```\n" + (raw or "")[:4000] + "\n```")
    return "\n".join(lines) + "\n"


def render_report(date_iso: str, papers: list, runner_ups: list, social_status: str,
                  relevant: int, fetched: int = 0) -> str:
    lines = [
        f"# {L('report_title').format(date=date_iso)}",
        "",
        L("report_stats").format(
            fetched=fetched, relevant=relevant, n=len(papers),
            social=L("social_check").get(social_status, social_status)),
        "",
    ]
    for i, p in enumerate(papers, 1):
        s = p.get("social", {})
        lines.extend([
            f"## {i}. {title_display(p, 200)}",
            "",
            f"- {L('report_original')}: {p['title']}",
            f"- {L('report_authors')}: {render_authors(p['authors'])}",
            f"- arXiv: {p['link']}",
            f"- {L('report_category')}: {p.get('primary_category', '—')} · {p.get('published', '')[:10]}",
            f"- {L('reason')}: {reason_text(p)}",
            f"- {L('report_scores')}: `{json.dumps(p['scores'])}`",
            "",
            f"**{L('studied')}:** {studied_display(p, 500)}",
            "",
            f"**{L('method')}:** {method_display(p, 500)}",
            "",
            f"**{L('found')}:** {found_display(p, 500)}",
            "",
            f"**X:** {render_status(s.get('x_status', 'degraded'))} · "
            f"**Reddit:** {render_status(s.get('reddit_status', 'degraded'))}",
            f"**{L('report_prior')}:** {s.get('prior_context', '') or '—'}",
            f"**{L('report_evidence')}:** {s.get('evidence', '') or '—'}",
            "",
            f"**{L('why')}:** {why_text(p)}",
            "",
            f"**{L('report_abstract')}:** {abstract_display(p, 800)}",
            "",
        ])
    if runner_ups:
        lines.append(f"## {L('report_runner_ups')}")
        lines.append("")
        for r in runner_ups:
            lines.append(f"- `{r['id']}` {r['title']} — {r['reason_rejected']} (final={r['scores']['final']})")
        lines.append("")
    lines.append(f"{L('report_sources')}: [[arxiv-learning-snapshot-{date_iso}]], [[arxiv-learning-translation-codex-{date_iso}]], [[arxiv-learning-social-grok-{date_iso}]]")
    return "\n".join(lines) + "\n"


def render_digest(date_iso: str, papers: list, relevant: int, max_papers: int,
                  fetched: int = 0) -> str:
    header = [f"🧪 arXiv learning — {date_iso}", ""]
    scanned = (
        L("scanned").format(fetched=fetched, relevant=relevant)
        if fetched else
        L("scanned_nofetch").format(relevant=relevant)
    )
    report_rel = f"reports/learning-arxiv-summary-{date_iso}.md"
    if not papers:
        header.append(f"{scanned} {L('zero')}")
        header.append("")
        header.append(L("footer").format(path=report_rel))
        return "\n".join(header)
    if len(papers) < max_papers:
        header.append(f"{scanned} {L('fewer').format(n=len(papers))}")
    else:
        header.append(f"{scanned} {L('picked').format(n=len(papers))}")
    header.append("")

    def paper_block(p: dict, idx: int, text_limit: int) -> str:
        s = p.get("social", {})
        line_limit = max(70, min(220, text_limit))
        social_line = (
            f"X: {render_status(s.get('x_status', 'degraded'))} / "
            f"Reddit: {render_status(s.get('reddit_status', 'degraded'))}"
        )
        prior = s.get("prior_context", "")
        if prior:
            social_line += f" — {prior}"
        return (
            f"{idx}. {title_display(p)} — {render_authors(p['authors'])}\n"
            f"   arXiv: {p['link']}\n"
            f"   {L('reason')}: {reason_text(p)}\n"
            f"   {L('abstract')}: {abstract_display(p, text_limit)}\n"
            f"   {L('studied')}: {studied_display(p, line_limit)}\n"
            f"   {L('method')}: {method_display(p, line_limit)}\n"
            f"   {L('found')}: {found_display(p, line_limit)}\n"
            f"   {social_line}\n"
            f"   {L('why')}: {why_text(p)}"
        )

    footer = ["", L("footer").format(path=report_rel)]
    text_limit = 320
    while True:
        blocks = [paper_block(p, i, text_limit) for i, p in enumerate(papers, 1)]
        digest = "\n".join(header + ["\n\n".join(blocks)] + footer)
        if len(digest) <= DIGEST_BUDGET or text_limit <= 60:
            return digest
        text_limit -= 30


# --------------------------------------------------------------------------
# Delivery
# --------------------------------------------------------------------------

def process_outputs() -> set:
    raw = os.environ.get("KB_PROCESS_OUTPUTS", "telegram,file")
    return {part.strip() for part in raw.split(",") if part.strip()}


def resolve_channel_send_bin() -> str:
    hub_bin = HUB / "bin" / "kb-channel-send"
    if hub_bin.exists():
        return str(hub_bin)
    default_bin = pathlib.Path.home() / "knowledge" / "bin" / "kb-channel-send"
    if default_bin.exists():
        return str(default_bin)
    return ""


def deliver_digest(date_iso: str, digest: str, manifest: dict) -> int:
    outputs = process_outputs()
    manifest["outputs"] = sorted(outputs)
    manifest["digest"] = digest
    if "telegram" not in outputs:
        manifest["digest_delivered"] = False
        manifest["status"] = "completed"
        manifest["error"] = None
        save_manifest(date_iso, manifest)
        log(f"{date_iso}: completed without telegram output (outputs={sorted(outputs)})")
        return 0
    sender = resolve_channel_send_bin()
    if not sender:
        return _delivery_failed(date_iso, manifest, "kb-channel-send not found")
    try:
        proc = subprocess.run(
            [sender, "learning-arxiv", digest],
            capture_output=True, text=True, timeout=60, check=False,
            stdin=subprocess.DEVNULL,
        )
    except Exception as exc:
        # A hung/crashed sender must record a failed manifest, not crash
        # the runner with an unwritten state (TimeoutExpired included).
        return _delivery_failed(date_iso, manifest, f"telegram delivery failed: {exc}")
    if proc.returncode != 0:
        detail = proc.stderr.strip() or proc.stdout.strip() or f"rc={proc.returncode}"
        return _delivery_failed(date_iso, manifest, f"telegram delivery failed: {detail}")
    manifest["digest_delivered"] = True
    manifest["status"] = "completed"
    manifest["error"] = None
    save_manifest(date_iso, manifest)
    log(f"{date_iso}: digest delivered")
    return 0


def _delivery_failed(date_iso: str, manifest: dict, error: str) -> int:
    manifest["digest_delivered"] = False
    manifest["status"] = "failed"
    manifest["error"] = error
    maybe_suggest_incident(date_iso, manifest)
    save_manifest(date_iso, manifest)
    log(f"{date_iso}: {error}")
    return 1


def maybe_suggest_incident(date_iso: str, manifest: dict) -> None:
    if int(manifest.get("attempts") or 0) >= INCIDENT_ATTEMPTS and not manifest.get("incident_suggested"):
        manifest["incident_suggested"] = True
        log(f"{date_iso}: ESCALATE — {manifest['attempts']} failed attempts today; "
            f"suggest incident review (runner never auto-writes incidents.md)")


# --------------------------------------------------------------------------
# Main flow
# --------------------------------------------------------------------------

def run(date_iso: str, force: bool, dry_run: bool) -> int:
    cfg = load_config()
    if dry_run:
        print(f"[dry] would fetch arXiv Atom ({cfg['arxiv_categories']}), select up to "
              f"{cfg['max_papers']} papers, run grok social check, deliver the "
              f"telegram digest in {UI_LANG_NAME}, write {rel(report_path(date_iso))}")
        return 0

    lock_fh = acquire_lock(date_iso)
    manifest = load_manifest(date_iso)
    if lock_fh is None:
        if manifest.get("digest_delivered"):
            log(f"{date_iso}: lock held but digest already delivered; rc=0")
            return 0
        log(f"{date_iso}: another run holds the lock and no delivered digest; rc=1")
        return 1
    try:
        return _run_locked(date_iso, cfg, manifest, force)
    finally:
        fcntl.flock(lock_fh.fileno(), fcntl.LOCK_UN)
        lock_fh.close()


def _run_locked(date_iso: str, cfg: dict, manifest: dict, force: bool) -> int:
    if not force:
        if manifest.get("digest_delivered"):
            log(f"{date_iso}: digest already delivered; idempotent rc=0")
            return 0
        # Terminal-ness follows the CURRENT process outputs: a day completed
        # file-only stays terminal only while telegram is still not required;
        # if the config later adds telegram, fall through to the stage cache
        # and deliver.
        if manifest.get("status") == "completed" and "telegram" not in process_outputs():
            log(f"{date_iso}: already completed and telegram not required; rc=0")
            return 0
    if force:
        manifest = {"attempts": int(manifest.get("attempts") or 0)}

    cached_language = manifest.get("language") or "ru"  # pre-profile manifests were Russian
    # Capture cache-eligibility from the PRE-update manifest: the manifest.update
    # below stamps manifest_version=MANIFEST_VERSION, so reading it after would
    # always look current and defeat the migration gate (spec blocker fix).
    cached_version = int(manifest.get("manifest_version") or 1)
    cached_has_translate = bool(manifest.get("translate_check"))
    if cached_language != UI_LANG and manifest.get("selected_papers") is not None:
        # Language switched: the cached localized state belongs to the old
        # target. Drop it NOW, before the manifest is stamped with the new
        # language — otherwise a failed re-fetch would leave old *_loc
        # content under the new language stamp and a later retry would
        # serve stale-language text from the cache (codex impl-review
        # blocker 2026-06-12).
        log(f"{date_iso}: language switch {cached_language} -> {UI_LANG}; dropping cached selection")
        for stale_key in ("selected_papers", "runner_ups", "social_check",
                          "grok_rc", "grok_stderr_tail", "translate_check",
                          "codex_rc", "codex_stderr_tail", "digest"):
            manifest.pop(stale_key, None)
    manifest.update({
        "date": date_iso,
        "status": manifest.get("status") or "started",
        "attempts": int(manifest.get("attempts") or 0) + 1,
        "last_attempt_at": now_iso(),
        "language": UI_LANG,
        "learning_topic": cfg.get("learning_topic", "ai_agents"),
        "manifest_version": MANIFEST_VERSION,
    })
    manifest.setdefault("incident_suggested", False)
    manifest.setdefault("arxiv_fetched", 0)
    manifest.setdefault("arxiv_relevant", 0)
    save_manifest(date_iso, manifest)

    max_papers = int(cfg.get("max_papers") or MAX_PAPERS_DEFAULT)

    # Stage cache (spec): selection+translation+social already done, only
    # delivery failed → re-render and re-deliver from the manifest; never
    # re-fetch arXiv or re-invoke Codex/Grok.
    # `selected_papers is not None` (not truthiness): a completed zero-paper
    # day must also recover from the cache instead of re-fetching arXiv.
    # Language-gated: cached fields were produced for the cached language;
    # after a profile switch the cache is bypassed so no stale-language
    # content leaks (spec: user-language-setting-2026-06-12).
    # Version-gated: a v1 manifest written by the old combined-Grok runner has
    # no Codex translation; a v2 manifest has Codex translation but no
    # method_loc. Neither may satisfy the stage cache for the current output
    # contract. Require translate_check present AND
    # manifest_version >= MANIFEST_VERSION (both read from the PRE-update snapshot).
    cached = (
        not force
        and manifest.get("selected_papers") is not None
        and manifest.get("social_check")
        and cached_has_translate
        and cached_version >= MANIFEST_VERSION
        and cached_language == UI_LANG
    )
    if cached:
        log(f"{date_iso}: reusing cached selection+translation+social from manifest (stage cache)")
        papers = manifest["selected_papers"]
        digest = render_digest(
            date_iso, papers, int(manifest.get("arxiv_relevant") or len(papers)),
            max_papers, fetched=int(manifest.get("arxiv_fetched") or 0),
        )
        return deliver_digest(date_iso, digest, manifest)

    try:
        xml_text = fetch_atom(cfg["arxiv_categories"])
        candidates = parse_atom(xml_text)
        if not candidates:
            raise RuntimeError("arXiv feed parsed to zero entries")
    except Exception as exc:
        manifest["status"] = "failed"
        manifest["error"] = f"arxiv fetch failed: {exc}"
        maybe_suggest_incident(date_iso, manifest)
        save_manifest(date_iso, manifest)
        log(f"{date_iso}: arxiv fetch failed: {exc}")
        return 1

    selected, runner_ups, relevant = select_papers(candidates, max_papers)
    for p in selected:
        p["summary_loc"] = build_summary(p)
    manifest.update({
        "status": "selected",
        "arxiv_fetched": len(candidates),
        "arxiv_relevant": relevant,
        "selected_papers": [
            {k: p[k] for k in ("id", "title", "authors", "link", "abstract",
                               "published", "primary_category", "scores",
                               "reason", "summary_loc", "_groups")}
            for p in selected
        ],
        "runner_ups": runner_ups,
        "error": None,
    })
    save_manifest(date_iso, manifest)
    atomic_write(snapshot_path(date_iso),
                 render_snapshot(date_iso, selected, runner_ups, len(candidates), relevant))

    # Codex translation/analysis (offline) — independent of the Grok social
    # call below; a Codex failure degrades only translation (fallback_en /
    # unavailable), never the social signal.
    t_status, codex_rc, codex_stderr, codex_raw = translate_check(date_iso, selected)
    manifest["translate_check"] = t_status
    manifest["codex_rc"] = codex_rc
    manifest["codex_stderr_tail"] = codex_stderr

    # Grok X/Reddit social — independent of the translation above; a Grok
    # failure degrades only the social lines (this is the 2026-06-17 fix).
    status, grok_rc, stderr_tail, raw = social_check(date_iso, selected)
    manifest["social_check"] = status
    manifest["grok_rc"] = grok_rc
    manifest["grok_stderr_tail"] = stderr_tail

    for m_p, p in zip(manifest["selected_papers"], selected):
        m_p["social"] = p.get("social", {})
        for k in ("title_loc", "abstract_loc", "abstract_source",
                  "studied_loc", "method_loc", "found_loc", "why_loc",
                  "summary_source"):
            if k in p:
                m_p[k] = p[k]
        # Rebuild now that the localized translation (or its absence) is known.
        p["summary_loc"] = build_summary(p)
        m_p["summary_loc"] = p["summary_loc"]
    save_manifest(date_iso, manifest)
    atomic_write(translation_path(date_iso),
                 render_translation_source(date_iso, selected, t_status, codex_rc, codex_stderr, codex_raw))
    atomic_write(social_path(date_iso),
                 render_social_source(date_iso, selected, status, grok_rc, stderr_tail, raw))

    atomic_write(report_path(date_iso),
                 render_report(date_iso, selected, runner_ups, status, relevant,
                               fetched=len(candidates)))
    manifest["status"] = "report_written"
    save_manifest(date_iso, manifest)

    digest = render_digest(date_iso, selected, relevant, max_papers,
                           fetched=len(candidates))
    return deliver_digest(date_iso, digest, manifest)


def main() -> int:
    parser = argparse.ArgumentParser(
        description="arXiv-only scheduled learning digest (3 papers, user-language, Grok social check)."
    )
    parser.add_argument("--date", default=today_iso(), help="Date in YYYY-MM-DD.")
    parser.add_argument("--text-only", action="store_true",
                        help="Text digest mode (default and only mode in v1; flag kept for the process contract).")
    parser.add_argument("--force", action="store_true", help="Redo everything for the date, resend digest.")
    parser.add_argument("--dry-run", action="store_true", help="Print intent, no network/disk/sends.")
    args = parser.parse_args()

    if not re.fullmatch(r"\d{4}-\d{2}-\d{2}", args.date):
        print(f"invalid --date: {args.date}", file=sys.stderr)
        return 2
    return run(args.date, force=args.force, dry_run=args.dry_run)


if __name__ == "__main__":
    sys.exit(main())
