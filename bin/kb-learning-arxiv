#!/usr/bin/env python3
"""kb-learning-arxiv — scheduled learning: arXiv-only 3-paper digest in the
user's language, with Codex for translation/analysis and optional Grok social
context when explicitly enabled.

Specs: learning-arxiv-implementation-spec-2026-06-12 +
user-language-setting-2026-06-12 + split-translation-social-2026-06-17
(KB decisions; all cross-reviewed).

Flow: fetch arXiv Atom → deterministic regex ranking → select up to 3 papers
→ one Codex call (offline, --sandbox read-only) for user-language
study/method/result summaries per paper, bounded by title+full paper text
when the PDF can be extracted, with explicit abstract fallback → short
Telegram digest + file artifacts. If `social_check: grok` is set explicitly,
Grok adds X/Reddit social context as an independent optional stage; a Grok
failure degrades only the social lines. The digest/report language comes from
personal/profile.yaml via _kb_profile.

Primary selection is arXiv-only by construction: no RSS/HN/GitHub/news
collector exists in this runner, so official-source links can never outrank
papers. NotebookLM is never called here — audio stays manual-only.

Artifacts per date:
  sources/arxiv-learning-snapshot-<DATE>.md
  sources/arxiv-learning-translation-codex-<DATE>.md
  sources/arxiv-learning-social-grok-<DATE>.md (only when social_check: grok)
  reports/learning-arxiv-summary-<DATE>.md
  .orchestrator/learning-arxiv-<DATE>.json (+ .lock)

Env:
  KB_HUB                            hub root (default ~/knowledge)
  KB_LEARNING_ARXIV_FIXTURE         path to Atom XML — bypasses network fetch
  KB_LEARNING_ARXIV_DISABLE_NETWORK 1 = fail fetch unless fixture is set
  KB_LEARNING_ARXIV_GROK_BIN        grok binary override (tests use a fake)
  KB_LEARNING_ARXIV_GROK_TIMEOUT    grok social seconds (default 600)
  KB_CODEX_BIN                      codex binary override (tests use a fake)
  KB_LEARNING_ARXIV_CODEX_TIMEOUT   codex translation seconds (default 300)
  KB_LEARNING_ARXIV_FULLTEXT_FIXTURE_DIR  test fixture dir with <arxiv-id>.txt
  KB_LEARNING_ARXIV_FULLTEXT_MAX_CHARS    safety cap per paper (default 180000)
  KB_PROCESS_OUTPUTS / KB_PROCESS_BACKGROUND  set by kb-tick
"""
from __future__ import annotations

import argparse
import datetime
import fcntl
import json
import os
import pathlib
import re
import shutil
import subprocess
import sys
import tempfile
import time
import xml.etree.ElementTree as ET

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import _kb_profile  # noqa: E402
from _kb_claude_runner import run_command as run_unbounded_command  # noqa: E402
from _kb_codex import CodexUnavailable, codex_bin  # noqa: E402

# NOTE: no urllib here, deliberately. On macOS, a urllib fetch in this
# process leaves CFNetwork/Obj-C state that makes a subsequently spawned
# Bun-based CLI (grok 0.2.22) SIGSEGV instantly — repro 2026-06-12: after
# urllib.request.urlopen, even `grok --version` exits -11. arXiv is fetched
# through a curl subprocess instead (same transport kb-channel-send uses).

HUB = pathlib.Path(os.environ.get("KB_HUB", os.path.expanduser("~/knowledge")))
CONFIG_PATH = HUB / "personal" / "daily-research.yaml"
REPORTS = HUB / "reports"
SOURCES = HUB / "sources"
ORCH = HUB / ".orchestrator"
LOG = HUB / "logs" / "learning-arxiv.log"

API_BASE = "https://export.arxiv.org/api/query"
USER_AGENT = os.environ.get(
    "KB_ARXIV_USER_AGENT", "kb-learning-arxiv/1.0 (mailto:user@example.com)"
)
ATOM_NS = {"a": "http://www.w3.org/2005/Atom", "arxiv": "http://arxiv.org/schemas/atom"}

DEFAULT_CATEGORIES = ["cs.AI", "cs.LG", "cs.CL", "cs.CV", "stat.ML"]
MAX_PAPERS_DEFAULT = 3
# Spec full-paper-messages-2026-07-29: delivery is 1 header + 1 message per
# paper, each ≤ TELEGRAM_MAX by construction (greedy section packing +
# fail-closed guard). The old single-message DIGEST_BUDGET shrink loop is gone.
# Env override exists for tests only (forcing the fail-closed path).
TELEGRAM_MAX = int(os.environ.get("KB_LEARNING_ARXIV_TELEGRAM_MAX", "4096"))
INCIDENT_ATTEMPTS = 8
# D12 (spec morning-digest-inputs-rebalance-2026-07-11): timeouts are generous
# with headroom so real generation work is never killed mid-flight. Env-
# overridable; the defaults carry slack, they are not tuned to the edge.
HTTP_TIMEOUT = int(os.environ.get("KB_LEARNING_ARXIV_HTTP_TIMEOUT", "60"))  # Atom feed (was 30)
JACCARD_LIMIT = 0.6
# Manifest contract version. v2 moved translation out of Grok into Codex.
# v3 adds first-class method/setup summaries (`method_loc`). v4 switches the
# Codex analysis input from abstract snippets to extracted full paper text
# when available. v6 (spec full-paper-messages-2026-07-29) replaces the
# one-line `why_loc` with the mandatory-two-clause `why_selected_loc` and adds
# per-message delivery bookkeeping. Older manifests must NOT satisfy the stage
# cache, or they would keep serving the retired short "why" line.
MANIFEST_VERSION = 6
# Grok now does X/Reddit social ONLY (translation moved to Codex), so its
# default timeout drops 900→600s. Codex translation is offline text work,
# fast; 300s is generous. Both overridable via env. Sequential worst case
# 300+600=900s fits the kb-tick PROCESS_TIMEOUT=1800s wrapper ceiling.
GROK_TIMEOUT_DEFAULT = 600
CODEX_TIMEOUT_DEFAULT = 300  # legacy run_codex single-path timeout (kept for compat)
FULLTEXT_HTTP_TIMEOUT = int(os.environ.get("KB_LEARNING_ARXIV_FULLTEXT_HTTP_TIMEOUT", "180"))  # per PDF (was 90)
FULLTEXT_MIN_CHARS = 200
FULLTEXT_MAX_CHARS_DEFAULT = 180000

# D1 — pluggable translate/analysis executor chain (spec morning-digest-inputs-
# rebalance-2026-07-11). Ported from kb-morning-digest's SYNTH_BACKENDS pattern.
# claude,codex — owner directive 2026-07-29 (chat): paper analysis/translation
# runs on Claude; Codex stays as the fallback lane only. (Original order
# codex,claude per owner OQ-1.) Prompt is ALWAYS delivered by pointer file,
# never argv.
TRANSLATE_AGENTS_DEFAULT = "claude,codex"
# Per-agent 900s (deep multi-paper analysis of up to 180KB full text is real
# generation work); whole-chain 1800s (room for two unhurried attempts).
TRANSLATE_TIMEOUT = int(os.environ.get("KB_LEARNING_ARXIV_TRANSLATE_TIMEOUT", "900"))
TRANSLATE_CHAIN_TIMEOUT = int(os.environ.get("KB_LEARNING_ARXIV_TRANSLATE_CHAIN_TIMEOUT", "1800"))
# Closed set of per-attempt failure reasons recorded in translate_attempts.
TRANSLATE_REASONS = {"launch_error", "timeout", "bad_json", "incomplete",
                     "language_rejected", "oversized", "ok"}

# D2 — target DEPTHS (content-quality guidance for the writer, NOT size caps).
# A field that parsed but ran pathologically over its target (>= OVERSIZE_FACTOR
# x target) is rejected as `oversized` → next agent, never silently truncated.
TARGET_ABSTRACT = 1500
TARGET_STUDIED = 500
TARGET_METHOD = 700
TARGET_FOUND = 700
# Spec full-paper-messages-2026-07-29 D3: 2-4 sentences, both clauses
# mandatory (why selected + what to apply in the owner's projects).
TARGET_WHY_SELECTED = 450
TARGET_TERM_DEF = 160
# Term NAME gate (spec D2): the definition was already gated, the name was
# not — the one field that could have broken the "every section ≤ 4096"
# guarantee of the greedy message packing.
TARGET_TERM_NAME = 60
OVERSIZE_FACTOR = 3
TERMS_MIN = 3
TERMS_MAX = 6

# D4 — since-last-seen watermark (no cross-day dedup ledger). One tz-aware UTC
# ISO timestamp: the newest submittedDate a DELIVERED digest looked at. Selection
# is half-open (watermark, now]; the window never reaches back further than
# WINDOW_MAX_HOURS. Exhaustive descending pagination to the cutoff, bounded by
# MAX_FETCH_PAGES as a pure anomaly backstop (cap-hit = abort, never partial).
WATERMARK_FILE = ORCH / "learning-arxiv-watermark"
WATERMARK_LOCK = ORCH / "learning-arxiv-watermark.lock"
WINDOW_MAX_HOURS = int(os.environ.get("KB_LEARNING_ARXIV_WINDOW_MAX_HOURS", "48"))
MAX_FETCH_PAGES = int(os.environ.get("KB_LEARNING_ARXIV_MAX_FETCH_PAGES", "5"))
FETCH_PAGE_SIZE = int(os.environ.get("KB_LEARNING_ARXIV_FETCH_PAGE_SIZE", "200"))

# Keys in personal/daily-research.yaml that belong to the legacy runner only.
# `language` is legacy too: personal/profile.yaml is the single source of
# truth for the user's language (spec: user-language-setting-2026-06-12).
LEGACY_KEYS = ("mode", "source_mode", "topic_override", "research_mode",
               "max_sources", "max_attempts", "language")

UI_LANG = _kb_profile.get_language(HUB)
UI_LANG_NAME = _kb_profile.language_directive(UI_LANG)


def L(key: str):
    pack = LABELS.get(UI_LANG, LABELS["en"])
    return pack.get(key, LABELS["en"].get(key, key))

SOCIAL_STATUSES = {"found", "weak", "not_found", "degraded"}
SOCIAL_OFF_VALUES = {"", "off", "none", "skip", "skipped", "disabled", "false", "0", "no"}
CYRILLIC_RE = re.compile(r"[А-Яа-яЁё]")

# Topic keyword groups for the deterministic ranker (spec: Deterministic
# scoring formula v1). Group name → compiled regex.
TOPIC_GROUPS = [
    ("agents", re.compile(r"\b(agents?|agentic|multi[- ]agent)\b", re.I)),
    ("reasoning", re.compile(r"\b(reasoning|chain[- ]of[- ]thought|planning)\b", re.I)),
    ("memory", re.compile(r"\b(memory|knowledge[- ]bases?|retrieval|\brag\b|retrieval[- ]augmented)\b", re.I)),
    ("tools", re.compile(r"\b(tool[- ]use|tools?|mcp|function[- ]calling)\b", re.I)),
    ("evaluation", re.compile(r"\b(evaluation|benchmark|evaluating)\b", re.I)),
    ("local", re.compile(r"\b(local|on[- ]device|efficient[- ]inference|quantization)\b", re.I)),
    ("safety", re.compile(r"\b(safety|alignment)\b", re.I)),
]

PROBLEM_RE = re.compile(r"\b(we study|we investigate|we analyze|problem|challenge|limitation)\b", re.I)
METHOD_RE = re.compile(r"\b(we propose|we introduce|we present|our (method|framework|approach))\b", re.I)
RESULT_RE = re.compile(r"\b(we show|results?|achieves?|improves?|outperforms?|state[- ]of[- ]the[- ]art)\b", re.I)
# Quantitative marker per the approved formula: a number ADJACENT to a metric
# token — bare "accuracy"/"score" without a number does not count.
QUANT_RE = re.compile(
    r"\d+(\.\d+)?\s*(%|x\b|points?\b|pp\b)"
    r"|\b(accuracy|score)\b[^.]{0,24}\d"
    r"|\d[^.]{0,24}\b(accuracy|score)\b",
    re.I,
)
PRACT_CODE_RE = re.compile(r"\b(open[- ]source|code is available|we release|release our code)\b", re.I)
PRACT_DEPLOY_RE = re.compile(r"\b(deploy(ment)?|production|local|on[- ]device)\b", re.I)

