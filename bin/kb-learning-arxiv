def now_iso() -> str:
    return datetime.datetime.now().astimezone().isoformat(timespec="seconds")


def today_iso() -> str:
    return datetime.date.today().isoformat()


def log(msg: str) -> None:
    LOG.parent.mkdir(parents=True, exist_ok=True)
    with LOG.open("a", encoding="utf-8") as f:
        f.write(f"[{now_iso()}] learning-arxiv: {msg}\n")


def atomic_write(path: pathlib.Path, content: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=str(path.parent), prefix=f".{path.name}.", suffix=".tmp")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(content)
        os.replace(tmp, path)
    except Exception:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def rel(path: pathlib.Path) -> str:
    try:
        return str(path.relative_to(HUB))
    except ValueError:
        return str(path)


# --------------------------------------------------------------------------
# Config (read-only; legacy keys are ignored with a single log line)
# --------------------------------------------------------------------------

def load_config() -> dict:
    cfg = {
        "learning_topic": "ai_agents",
        "max_papers": MAX_PAPERS_DEFAULT,
        "arxiv_categories": list(DEFAULT_CATEGORIES),
        "social_check": "off",
    }
    if not CONFIG_PATH.is_file():
        return cfg
    legacy_present = []
    for raw in CONFIG_PATH.read_text(encoding="utf-8").splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or ":" not in line:
            continue
        # Inline comments ("max_papers: 3 # limit") must not poison values.
        line = re.split(r"\s+#", line, maxsplit=1)[0].strip()
        if ":" not in line:
            continue
        key, val = line.split(":", 1)
        key, val = key.strip(), val.strip().strip("'\"")
        if key in LEGACY_KEYS:
            legacy_present.append(key)
            continue
        if key == "max_papers":
            try:
                # The scheduled contract is "up to three papers" — a config
                # typo must not flood the digest.
                cfg["max_papers"] = max(1, min(3, int(val)))
            except ValueError:
                pass
        elif key == "arxiv_categories":
            m = re.match(r"^\[(.*)\]$", val)
            if m:
                cats = [c.strip().strip("'\"") for c in m.group(1).split(",") if c.strip()]
                if cats:
                    cfg["arxiv_categories"] = cats
        elif key in ("learning_topic", "social_check", "focus_project",
                     "focus_context"):
            if val:
                cfg[key] = val
    if legacy_present:
        log(f"legacy config keys ignored: {', '.join(sorted(legacy_present))}")
    cfg["social_check"] = normalize_social_check(cfg.get("social_check"))
    return cfg


def normalize_social_check(value) -> str:
    raw = str(value or "").strip().lower()
    if raw == "grok":
        return "grok"
    if raw in SOCIAL_OFF_VALUES:
        return "off"
    log(f"unknown social_check={raw!r}; social disabled")
    return "off"


def social_enabled(cfg: dict) -> bool:
    return normalize_social_check(cfg.get("social_check")) == "grok"


def social_manifest_enabled(manifest: dict) -> bool:
    raw = str(manifest.get("social_check") or "").strip().lower()
    if raw in {"ok", "partial", "degraded"}:
        return True
    return normalize_social_check(raw) == "grok"


def should_render_social(social_status: str) -> bool:
    return str(social_status or "").strip().lower() != "skipped"


# --------------------------------------------------------------------------
# Paths / manifest / lock
# --------------------------------------------------------------------------

def manifest_path(d: str) -> pathlib.Path:
    return ORCH / f"learning-arxiv-{d}.json"


def lock_path(d: str) -> pathlib.Path:
    return ORCH / f"learning-arxiv-{d}.lock"


def report_path(d: str) -> pathlib.Path:
    return REPORTS / f"learning-arxiv-summary-{d}.md"


def snapshot_path(d: str) -> pathlib.Path:
    return SOURCES / f"arxiv-learning-snapshot-{d}.md"


def social_path(d: str) -> pathlib.Path:
    return SOURCES / f"arxiv-learning-social-grok-{d}.md"


def translation_path(d: str) -> pathlib.Path:
    return SOURCES / f"arxiv-learning-translation-codex-{d}.md"


def load_manifest(d: str) -> dict:
    p = manifest_path(d)
    if not p.is_file():
        return {}
    try:
        return json.loads(p.read_text(encoding="utf-8"))
    except Exception as exc:
        log(f"{d}: manifest parse failed: {exc}; starting fresh")
        return {}


def save_manifest(d: str, manifest: dict) -> None:
    atomic_write(manifest_path(d), json.dumps(manifest, ensure_ascii=False, indent=2) + "\n")


def acquire_lock(d: str):
    """Advisory flock — auto-released on process exit/crash; a stale lock
    file on disk never blocks future runs (spec: Manifest Schema). Opened
    in append mode so a contender that fails the flock never truncates the
    holder's pid/started_at metadata."""
    ORCH.mkdir(parents=True, exist_ok=True)
    fh = lock_path(d).open("a", encoding="utf-8")
    try:
        fcntl.flock(fh.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        fh.close()
        return None
    fh.seek(0)
    fh.truncate(0)
    fh.write(f"pid={os.getpid()} started_at={now_iso()}\n")
    fh.flush()
    return fh


# --------------------------------------------------------------------------
# arXiv fetch + parse
# --------------------------------------------------------------------------

def build_query(categories: list, start: int = 0, page_size: int = FETCH_PAGE_SIZE) -> str:
    cat_clause = "+OR+".join(f"cat:{c}" for c in categories)
    return (
        f"{API_BASE}?search_query=({cat_clause})"
        f"&sortBy=submittedDate&sortOrder=descending"
        f"&start={start}&max_results={page_size}"
    )


def fetch_atom_page(categories: list, start: int) -> str:
    """One submittedDate-descending page of the Atom feed (network path)."""
    if os.environ.get("KB_LEARNING_ARXIV_DISABLE_NETWORK", "").strip() in {"1", "true", "yes"}:
        raise RuntimeError("network disabled and no fixture provided")
    url = build_query(categories, start=start)
    log(f"GET {url}")
    proc = subprocess.run(
        ["curl", "-sSL", "--fail", "--max-time", str(HTTP_TIMEOUT), "-A", USER_AGENT, url],
        capture_output=True, text=True, check=False, stdin=subprocess.DEVNULL,
    )
    if proc.returncode != 0:
        raise RuntimeError(
            f"curl rc={proc.returncode}: {(proc.stderr or '').strip()[:200]}"
        )
    return proc.stdout


# --------------------------------------------------------------------------
# D4 — since-last-seen watermark (no cross-day dedup ledger)
# --------------------------------------------------------------------------

def now_utc() -> datetime.datetime:
    return datetime.datetime.now(datetime.timezone.utc)


def parse_utc(value: str) -> datetime.datetime:
    """Parse an ISO 8601 timestamp as timezone-AWARE UTC. Fails CLOSED (raises)
    on an offset-naive or malformed value — never a silent naive comparison
    (D4/AC-3h). arXiv submittedDate is UTC (`Z`)."""
    s = (value or "").strip()
    if not s:
        raise ValueError("empty timestamp")
    iso = (s[:-1] + "+00:00") if s.endswith("Z") else s
    dt_val = datetime.datetime.fromisoformat(iso)  # ValueError on malformed
    if dt_val.tzinfo is None:
        raise ValueError(f"offset-naive timestamp rejected: {s!r}")
    return dt_val.astimezone(datetime.timezone.utc)


def paper_submitted(paper: dict) -> datetime.datetime:
    """The paper's submittedDate as tz-aware UTC (arXiv Atom `published`)."""
    return parse_utc(paper.get("published", ""))


def read_watermark() -> datetime.datetime:
    """The stored watermark as tz-aware UTC, or None when absent (first run).
    A present-but-malformed/naive watermark raises (fail closed, AC-3h)."""
    if not WATERMARK_FILE.is_file():
        return None
    raw = WATERMARK_FILE.read_text(encoding="utf-8").strip()
    if not raw:
        return None
    return parse_utc(raw)


def effective_cutoff(watermark: datetime.datetime, now: datetime.datetime) -> datetime.datetime:
    """Lower bound of the half-open selection window (cutoff, now]. The window
    never reaches back further than WINDOW_MAX_HOURS even if the watermark is
    very stale (long outage) — a resumed pipeline shows the last ~2 days, not a
    full backlog. Absent watermark → the floor (first run)."""
    floor = now - datetime.timedelta(hours=WINDOW_MAX_HOURS)
    if watermark is None:
        return floor
    return max(watermark, floor)


def acquire_watermark_lock():
    """Global advisory flock guarding read→select→deliver→write of the watermark
    (the watermark is global but the per-date run lock is not, so a manual forced
    run could race the scheduled one). A contender that cannot take it skips
    cleanly (non-blocking, same convention as kb-money-radar)."""
    ORCH.mkdir(parents=True, exist_ok=True)
    fh = WATERMARK_LOCK.open("a", encoding="utf-8")
    try:
        fcntl.flock(fh.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        fh.close()
        return None
    return fh


def advance_watermark(new_dt: datetime.datetime) -> None:
    """Monotonic compare-and-set: the watermark only ever moves FORWARD
    (write = max(existing, new)), so an out-of-order or concurrent writer can
    never rewind it and re-surface already-seen papers (D4/AC-3g). Caller holds
    the watermark flock."""
    existing = read_watermark()
    if existing is not None and new_dt <= existing:
        return
    atomic_write(WATERMARK_FILE, new_dt.astimezone(datetime.timezone.utc).isoformat() + "\n")


def fetch_window(categories: list, cutoff: datetime.datetime) -> tuple:
    """Exhaustively fetch the half-open window (cutoff, now]. Returns
    (in_window_papers, fully_fetched). Paginate the submittedDate-descending
    feed until the first entry whose submittedDate <= cutoff (window complete)
    or the feed ends, bounded by MAX_FETCH_PAGES. A fixture is treated as the
    complete feed (single page). Selection is STRICTLY newer than the cutoff."""
    fixture = os.environ.get("KB_LEARNING_ARXIV_FIXTURE", "").strip()
    if fixture:
        entries = parse_atom(pathlib.Path(fixture).read_text(encoding="utf-8"))
        in_window = [e for e in entries if paper_submitted(e) > cutoff]
        return in_window, True
    in_window = []
    reached_cutoff = False
    for page in range(MAX_FETCH_PAGES):
        entries = parse_atom(fetch_atom_page(categories, page * FETCH_PAGE_SIZE))
        if not entries:
            reached_cutoff = True  # feed ended → window complete
            break
        for e in entries:
            if paper_submitted(e) > cutoff:
                in_window.append(e)
            else:
                reached_cutoff = True
        if reached_cutoff or len(entries) < FETCH_PAGE_SIZE:
            reached_cutoff = True
            break
    return in_window, reached_cutoff


def parse_atom(xml_text: str) -> list:
    out = []
    root = ET.fromstring(xml_text)
    for entry in root.findall("a:entry", ATOM_NS):
        try:
            entry_id = (entry.findtext("a:id", default="", namespaces=ATOM_NS) or "").strip()
            arxid = re.sub(r"v\d+$", "", entry_id.rsplit("/", 1)[-1])
            if not arxid:
                continue
            title = re.sub(r"\s+", " ", (entry.findtext("a:title", default="", namespaces=ATOM_NS) or "").strip())
            abstract = re.sub(r"\s+", " ", (entry.findtext("a:summary", default="", namespaces=ATOM_NS) or "").strip())
            published = (entry.findtext("a:published", default="", namespaces=ATOM_NS) or "").strip()
            authors = []
            for a in entry.findall("a:author", ATOM_NS):
                n = a.findtext("a:name", default="", namespaces=ATOM_NS)
                if n:
                    authors.append(n.strip())
            cat_el = entry.find("arxiv:primary_category", ATOM_NS)
            primary_cat = cat_el.attrib.get("term", "") if cat_el is not None else ""
            out.append({
                "id": arxid,
                "title": title,
                "abstract": abstract,
                "authors": authors,
                "published": published,
                "primary_category": primary_cat,
                "link": f"https://arxiv.org/abs/{arxid}",
            })
        except Exception as exc:
            log(f"skip entry parse error: {exc}")
    return out


# --------------------------------------------------------------------------
# Full-text PDF extraction for analysis input
# --------------------------------------------------------------------------

def fulltext_cache_dir() -> pathlib.Path:
    return ORCH / "arxiv-fulltext-cache"


def fulltext_cache_stem(arxiv_id: str) -> str:
    return re.sub(r"[^A-Za-z0-9._-]+", "_", arxiv_id)


def fulltext_fixture_path(arxiv_id: str):
    raw = os.environ.get("KB_LEARNING_ARXIV_FULLTEXT_FIXTURE_DIR", "").strip()
    if not raw:
        return None
    path = pathlib.Path(raw) / f"{fulltext_cache_stem(arxiv_id)}.txt"
    return path if path.is_file() else None


def clean_full_text(text: str) -> str:
    text = (text or "").replace("\x0c", "\n\n")
    text = re.sub(r"\r\n?", "\n", text)
    text = re.sub(r"[ \t]+", " ", text)
    text = re.sub(r"\n{3,}", "\n\n", text)
    return text.strip()


def fulltext_max_chars() -> int:
    raw = os.environ.get("KB_LEARNING_ARXIV_FULLTEXT_MAX_CHARS", "").strip()
    if not raw:
        return FULLTEXT_MAX_CHARS_DEFAULT
    try:
        return max(0, int(raw))
    except ValueError:
        log(f"invalid KB_LEARNING_ARXIV_FULLTEXT_MAX_CHARS={raw!r}; using default")
        return FULLTEXT_MAX_CHARS_DEFAULT


def bounded_analysis_text(text: str) -> tuple:
    limit = fulltext_max_chars()
    if limit > 0 and len(text) > limit:
        return text[:limit], True
    return text, False


def full_text_result(text: str) -> dict:
    cleaned = clean_full_text(text)
    if len(cleaned) < FULLTEXT_MIN_CHARS:
        raise RuntimeError(f"full text too short ({len(cleaned)} chars)")
    bounded, truncated = bounded_analysis_text(cleaned)
    return {
        "source": "full_text",
        "text": bounded,
        "chars": len(bounded),
        "truncated": truncated,
        "error": "",
    }


def load_full_text(paper: dict) -> dict:
    """Return extracted analysis text for one paper, preferring deterministic
    test fixtures, then cached text, then arXiv PDF download + pdftotext."""
    arxiv_id = paper["id"]
    fixture = fulltext_fixture_path(arxiv_id)
    if fixture is not None:
        return full_text_result(fixture.read_text(encoding="utf-8"))

    cache_dir = fulltext_cache_dir()
    stem = fulltext_cache_stem(arxiv_id)
    txt_path = cache_dir / f"{stem}.txt"
    pdf_path = cache_dir / f"{stem}.pdf"
    if txt_path.is_file():
        try:
            return full_text_result(txt_path.read_text(encoding="utf-8"))
        except Exception as exc:
            log(f"{arxiv_id}: cached full text unusable: {exc}")

    if os.environ.get("KB_LEARNING_ARXIV_DISABLE_NETWORK", "").strip() in {"1", "true", "yes"}:
        raise RuntimeError("full-text network disabled and no usable fixture/cache")

    pdftotext = shutil.which("pdftotext")
    if not pdftotext:
        raise RuntimeError("pdftotext not found")

    cache_dir.mkdir(parents=True, exist_ok=True)
    if not pdf_path.is_file():
        url = f"https://arxiv.org/pdf/{arxiv_id}"
        proc = subprocess.run(
            ["curl", "-sSL", "--fail", "--max-time", str(FULLTEXT_HTTP_TIMEOUT),
             "-A", USER_AGENT, "-o", str(pdf_path), url],
            capture_output=True, text=True, check=False, stdin=subprocess.DEVNULL,
        )
        if proc.returncode != 0:
            try:
                pdf_path.unlink()
            except OSError:
                pass
            raise RuntimeError(
                f"PDF download rc={proc.returncode}: {(proc.stderr or '').strip()[:200]}"
            )

    proc = subprocess.run(
        [pdftotext, "-layout", "-enc", "UTF-8", str(pdf_path), "-"],
        capture_output=True, text=True, check=False, stdin=subprocess.DEVNULL,
    )
    if proc.returncode != 0:
        raise RuntimeError(
            f"pdftotext rc={proc.returncode}: {(proc.stderr or '').strip()[:200]}"
        )
    result = full_text_result(proc.stdout)
    atomic_write(txt_path, result["text"])
    return result


def attach_analysis_text(papers: list) -> None:
    for p in papers:
        try:
            result = load_full_text(p)
            p["analysis_text"] = result["text"]
            p["analysis_source"] = result["source"]
            p["analysis_chars"] = result["chars"]
            p["analysis_truncated"] = bool(result.get("truncated"))
            p["analysis_error"] = ""
        except Exception as exc:
            abstract = p.get("abstract", "")
            err = str(exc).strip()[:300] or "full-text unavailable"
            p["analysis_text"] = abstract
            p["analysis_source"] = "abstract_fallback"
            p["analysis_chars"] = len(abstract)
            p["analysis_truncated"] = False
            p["analysis_error"] = err
            log(f"{p.get('id', 'unknown')}: full-text unavailable; abstract fallback: {err}")


# --------------------------------------------------------------------------
# Deterministic scoring + selection (spec: Deterministic scoring formula v1)
# --------------------------------------------------------------------------

def topic_groups(text: str) -> set:
    return {name for name, rx in TOPIC_GROUPS if rx.search(text)}


def score_paper(paper: dict) -> dict:
    title, abstract = paper["title"], paper["abstract"]
    title_groups = topic_groups(title)
    abstract_groups = topic_groups(abstract)
    topic_relevance = min(10, 2 * len(title_groups) + len(abstract_groups))
    abstract_signal = sum(1 for rx in (PROBLEM_RE, METHOD_RE, RESULT_RE, QUANT_RE) if rx.search(abstract))
    practicality = 0
    if PRACT_CODE_RE.search(f"{title} {abstract}"):
        practicality += 1
    if len(title_groups | abstract_groups) >= 2:
        practicality += 1
    if PRACT_DEPLOY_RE.search(f"{title} {abstract}"):
        practicality += 1
    scores = {
        "topic_relevance": topic_relevance,
        "abstract_signal": min(4, abstract_signal),
        "novelty_practicality": min(3, practicality),
        "author_signal": 0,  # v1: never guess affiliations
    }
    scores["final"] = (3 * scores["topic_relevance"] + 2 * scores["abstract_signal"]
                       + 2 * scores["novelty_practicality"])
    paper["scores"] = scores
    paper["_groups"] = sorted(title_groups | abstract_groups)
    return scores


def jaccard_tokens(paper: dict) -> set:
    words = re.findall(r"[a-z]{4,}", f"{paper['title']} {paper['abstract']}".lower())
    return {w for w in words if w not in STOP_WORDS}


def jaccard(a: set, b: set) -> float:
    if not a or not b:
        return 0.0
    return len(a & b) / len(a | b)


def rank_candidates(papers: list) -> list:
    """Sort by final score desc, then newer published, then smaller arXiv id
    (chained stable sorts — fully reproducible for the same input)."""
    ranked = sorted(papers, key=lambda p: p["id"])
    ranked.sort(key=lambda p: p.get("published", ""), reverse=True)
    ranked.sort(key=lambda p: p["scores"]["final"], reverse=True)
    return ranked


def select_papers(papers: list, max_papers: int) -> tuple:
    relevant = [p for p in papers if score_paper(p)["topic_relevance"] > 0]
    ranked = rank_candidates(relevant)
    selected, skipped_dup = [], []
    for cand in ranked:
        if len(selected) >= max_papers:
            break
        toks = jaccard_tokens(cand)
        dup_of = next(
            (s for s in selected if jaccard(toks, jaccard_tokens(s)) > JACCARD_LIMIT),
            None,
        )
        if dup_of is not None:
            cand["_dup_of"] = dup_of["id"]
            skipped_dup.append(cand)
            continue
        cand["reason"] = (
            f"final={cand['scores']['final']} "
            f"(topics: {', '.join(cand['_groups']) or '—'})"
        )
        selected.append(cand)
    # Diversity escape hatch: if duplicates were skipped and we still have
    # room, take them back in rank order and note the cluster.
    if len(selected) < max_papers:
        for cand in skipped_dup:
            if len(selected) >= max_papers:
                break
            cand["reason"] = (
                f"final={cand['scores']['final']} — near-duplicate cluster with "
                f"{cand['_dup_of']}, taken to fill the selection"
            )
            selected.append(cand)
    selected_ids = {p["id"] for p in selected}
    runner_ups = [
        {"id": p["id"], "title": p["title"], "scores": p["scores"],
         "reason_rejected": ("near-duplicate of " + p["_dup_of"]) if p.get("_dup_of")
         else "lower final score"}
        for p in ranked if p["id"] not in selected_ids
    ]
    return selected, runner_ups, len(relevant)


# --------------------------------------------------------------------------
# Deterministic fallback summaries (bounded by title+abstract; no invention)
# --------------------------------------------------------------------------

def split_sentences(text: str) -> list:
    return [s.strip() for s in re.split(r"(?<=[.!?])\s+", text.strip()) if s.strip()]


def truncate_sentence(text: str, max_chars) -> str:
    # max_chars=None → render in FULL (D2: report shows each field whole, no
    # display truncation; the Telegram digest still passes an integer budget).
    if max_chars is None or len(text) <= max_chars:
        return text
    cut = text[:max_chars]
    last = max(cut.rfind(". "), cut.rfind("? "), cut.rfind("! "))
    if last > 40:
        return cut[: last + 1]
    last_space = cut.rfind(" ")
    return (cut[:last_space] + "…") if last_space > 0 else cut + "…"


def studied_text(paper: dict, limit: int = 240) -> str:
    sents = split_sentences(paper["abstract"])
    for s in sents:
        if PROBLEM_RE.search(s):
            return truncate_sentence(s, limit)
    return truncate_sentence(sents[0], limit) if sents else "—"


def found_text(paper: dict, limit: int = 240) -> str:
    sents = split_sentences(paper["abstract"])
    for s in sents:
        if RESULT_RE.search(s) and not PROBLEM_RE.search(s):
            return truncate_sentence(s, limit)
    for s in sents:
        if RESULT_RE.search(s):
            return truncate_sentence(s, limit)
    return L("no_result")


def method_text(paper: dict, limit: int = 240) -> str:
    sents = split_sentences(paper["abstract"])
    for s in sents:
        if METHOD_RE.search(s):
            return truncate_sentence(s, limit)
    return L("method_unavailable")


def why_selected_text(paper: dict) -> str:
    """«Почему выбрана» prose (spec full-paper-messages D3): the LLM's
    two-clause why_selected_loc when available, else the topic-group template
    (documented degraded mode — never the scoring kitchen)."""
    loc = _loc_field(paper, "why_selected")
    if loc:
        return loc
    templates = L("why_templates")
    for name, _rx in TOPIC_GROUPS:
        if name in paper.get("_groups", []):
            return templates[name]
    return templates["_default"]


def studied_display(paper: dict, limit: int = 240) -> str:
    """Localized summary (LLM, oversize-gated) when available; otherwise the
    deterministic English abstract extract — an honest degraded mode, marked
    in the manifest as summary_source=fallback_en. limit=None renders the
    VALIDATED loc field whole; the ungated fallback keeps its own bound
    (spec full-paper-messages D2: raw-feed input must not be able to reach
    the fail-closed size guard)."""
    loc = _loc_field(paper, "studied")
    if loc:
        return truncate_sentence(loc, limit)
    return studied_text(paper, 240 if limit is None else limit)


def found_display(paper: dict, limit: int = 240) -> str:
    loc = _loc_field(paper, "found")
    if loc:
        return truncate_sentence(loc, limit)
    return found_text(paper, 240 if limit is None else limit)


def method_display(paper: dict, limit: int = 240) -> str:
    loc = _loc_field(paper, "method")
    if loc:
        return truncate_sentence(loc, limit)
    return method_text(paper, 240 if limit is None else limit)


def abstract_display(paper: dict, limit: int = 700) -> str:
    loc = _loc_field(paper, "abstract")
    if loc:
        return truncate_sentence(loc, limit)
    return L("abstract_unavailable")


def build_summary(paper: dict) -> str:
    return (
        f"{L('studied')}: {studied_display(paper)} "
        f"{L('method')}: {method_display(paper)} "
        f"{L('found')}: {found_display(paper)} "
        f"{L('reason')}: {why_selected_text(paper)}"
    )


def render_authors(authors: list) -> str:
    if not authors:
        return "—"
    if len(authors) <= 3:
        return ", ".join(authors)
    return ", ".join(authors[:3]) + " et al."


# --------------------------------------------------------------------------
# Grok social check (one call covering all selected papers)
# --------------------------------------------------------------------------

def grok_bin() -> str:
    configured = os.environ.get("KB_LEARNING_ARXIV_GROK_BIN", "").strip()
    if configured:
        return configured
    return str(pathlib.Path.home() / ".grok" / "bin" / "grok")


# --------------------------------------------------------------------------
# D1 — pluggable translate/analysis executor chain (ported from
# kb-morning-digest's SYNTH_BACKENDS pattern). The prompt is ALWAYS delivered
# by pointer file (today's prompt is hundreds of KB — it must never ride argv);
# each backend's argv carries only a short instruction naming that file.
# --------------------------------------------------------------------------

def _resolve_agent_bin(name: str, candidates: list) -> str:
    """KB_<NAME>_BIN env override → first existing absolute candidate → PATH.
    Launchd's PATH omits ~/.local/bin, so absolute fallbacks are required."""
    env = os.environ.get(f"KB_{name.upper()}_BIN", "").strip()
    if env:
        return env
    for c in candidates:
        c = os.path.expanduser(c)
        if os.path.exists(c):
            return c
    return shutil.which(name) or name


def _run_agent(
    argv: list,
    timeout: int,
    capture_file: pathlib.Path = None,
    *,
    unbounded: bool = False,
) -> tuple:
    """Run a CLI agent headlessly. Claude uses the durable unbounded runner.

    Other providers retain their wall-clock cap. stdin is ALWAYS
    /dev/null (codex 0.138+ hangs on open stdin; a Bun/Node agent that inherits a
    live stdin can stall too). Returns (text|None, rc, reason, err_tail): reason
    is 'launch_error'/'timeout' for launch/timeout failures (caught per-agent,
    never crashing the run), else '' (the chain does the semantic validation)."""
    try:
        if unbounded:
            proc = run_unbounded_command(
                argv,
                cwd=HUB,
                output_mode="text",
                kind="claude",
                metadata={"caller": "kb-learning-arxiv"},
            )
        else:
            proc = subprocess.run(
                argv, stdin=subprocess.DEVNULL, capture_output=True, text=True,
                timeout=timeout, cwd=str(HUB), check=False,
            )
    except subprocess.TimeoutExpired:
        return None, -1, "timeout", "agent timeout"
    except Exception as exc:  # noqa: BLE001 (OSError/FileNotFoundError etc.)
        return None, -1, "launch_error", f"{type(exc).__name__}: {str(exc)[:200]}"
    text = ""
    if capture_file is not None:
        try:
            if capture_file.is_file():
                text = capture_file.read_text(encoding="utf-8")
        except OSError:
            text = ""
    if not text.strip():
        text = proc.stdout or ""
    return text, proc.returncode, "", (proc.stderr or "")[-300:]


def _pointer_instruction(prompt_file: pathlib.Path) -> str:
    return (f"Read the full prompt file at {prompt_file} and return ONLY the "
            "required JSON object. Do not edit files.")


def _translate_codex(prompt_file: pathlib.Path, date_iso: str, timeout: int) -> tuple:
    out_file = ORCH / f"learning-arxiv-codex-out-{date_iso}.txt"
    try:
        out_file.unlink()
    except OSError:
        pass
    try:
        binary = codex_bin()
    except CodexUnavailable as exc:
        return None, -1, "launch_error", str(exc)[-300:]
    argv = [binary, "exec", "-C", str(HUB), "--skip-git-repo-check",
            "--sandbox", "read-only", "--output-last-message", str(out_file),
            _pointer_instruction(prompt_file)]
    return _run_agent(argv, timeout, capture_file=out_file)


def _translate_claude(prompt_file: pathlib.Path, date_iso: str, timeout: int) -> tuple:
    bin_ = _resolve_agent_bin("claude", ["/opt/homebrew/bin/claude"])
    argv = [bin_, "-p", _pointer_instruction(prompt_file),
            "--output-format", "text", "--no-session-persistence"]
    return _run_agent(argv, timeout, unbounded=True)


def _translate_agy(prompt_file: pathlib.Path, date_iso: str, timeout: int) -> tuple:
    bin_ = _resolve_agent_bin("agy", ["~/.local/bin/agy"])
    argv = [bin_, "--add-dir", str(HUB), "--print", _pointer_instruction(prompt_file),
            "--print-timeout", "5m"]
    return _run_agent(argv, timeout)


TRANSLATE_BACKENDS = {
    "codex": _translate_codex,
    "claude": _translate_claude,
    "agy": _translate_agy,
}


def translate_agents() -> list:
    raw = os.environ.get("KB_LEARNING_ARXIV_TRANSLATE_AGENTS", TRANSLATE_AGENTS_DEFAULT)
    return [a.strip() for a in raw.split(",") if a.strip()]


def run_codex(date_iso: str, papers: list) -> tuple:
    """Offline translation/analysis via Codex. Returns (message, rc,
    stderr_tail). Never raises. `codex exec --sandbox read-only` (no edits)
    with `--output-last-message <file>` capturing ONLY the final agent message
    (clean; smoke-confirmed it writes under read-only). stdin=DEVNULL is
    mandatory (codex 0.138+ hangs on open stdin). The large full-text prompt is
    written to a file; argv carries only a short instruction pointing at it.
    Falls back to stdout if the capture file is empty — parse_loc tolerates
    banner noise via outermost-brace extraction."""
    prompt = codex_prompt(date_iso, papers)
    prompt_file = ORCH / f"learning-arxiv-codex-prompt-{date_iso}.md"
    atomic_write(prompt_file, prompt)
    out_file = ORCH / f"learning-arxiv-codex-out-{date_iso}.txt"
    try:
        out_file.unlink()
    except OSError:
        pass
    timeout = int(os.environ.get("KB_LEARNING_ARXIV_CODEX_TIMEOUT", str(CODEX_TIMEOUT_DEFAULT)))
    try:
        binary = codex_bin()
    except CodexUnavailable as exc:
        return "", -1, str(exc)[-300:]
    cmd = [
        binary, "exec",
        "-C", str(HUB),
        "--skip-git-repo-check",
        "--sandbox", "read-only",
        "--output-last-message", str(out_file),
        (f"Read the full prompt file at {prompt_file} and return ONLY the "
         "required JSON object. Do not edit files."),
    ]
    try:
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout,
                              check=False, stdin=subprocess.DEVNULL)
    except subprocess.TimeoutExpired:
        return "", -1, "codex timeout"
    except Exception as exc:
        return "", -1, str(exc)[-300:]
    msg = ""
    try:
        if out_file.is_file():
            msg = out_file.read_text(encoding="utf-8")
    except OSError:
        msg = ""
    if not msg.strip():
        msg = proc.stdout or ""
    return msg, proc.returncode, (proc.stderr or "")[-300:]


def grok_prompt(date_iso: str, papers: list) -> str:
    """X/Reddit social-context prompt ONLY. Translation/analysis moved to the
    Codex call (spec: learning-arxiv-split-translation-social-2026-06-17), so
    Grok no longer carries any *_loc field — only the social search it alone
    can do. prior_context stays in the user's language."""
    blocks = []
    for p in papers:
        phrases = ", ".join(p.get("_groups", [])[:5]) or "AI research"
        blocks.append(
            f"- id: {p['id']}\n  title: {p['title']}\n"
            f"  authors: {render_authors(p['authors'])}\n  link: {p['link']}\n"
            f"  key phrases: {phrases}\n"
            f"  abstract: {p['abstract'][:1200]}"
        )
    papers_block = "\n".join(blocks)
    return f"""# Social context check for today's arXiv learning digest ({date_iso})

The user's language is: {UI_LANG_NAME}.

For EACH paper below, search X/Twitter and Reddit for discussion of the exact
paper (title/authors/arXiv id) AND broader prior discussion of its core idea.
Separate exact-paper discussion from prior idea discussion. Do NOT translate or
summarize the paper — that is handled elsewhere; only report social signal.

Papers:
{papers_block}

Return ONLY one JSON object, no prose before or after, exactly this shape:
{{"papers": [{{"id": "<arxiv id>", "x_status": "found|weak|not_found|degraded",
"reddit_status": "found|weak|not_found|degraded", "evidence": "<short links/snippets>",
"prior_context": "<one sentence in {UI_LANG_NAME} about prior discussion of the idea>"}}]}}

Rules: use `not_found` only when the search WORKED and found nothing; if a
search surface failed or was blocked, use `degraded` for that channel. Never
invent a `not_found` for a search you could not run.
"""


def codex_prompt(date_iso: str, papers: list) -> str:
    """Offline translation/analysis prompt for Codex. Bounded strictly to the
    supplied per-paper `analysis_text` — full extracted paper text when
    available, explicit abstract fallback otherwise. No web, no social, no
    invented numbers. Emits the
    same `{{"papers": [...]}}` envelope Grok used so parse_loc()'s outermost-
    brace extraction works (a bare top-level array would break find/rfind)."""
    blocks = []
    for p in papers:
        analysis_text = p.get("analysis_text") or p.get("abstract", "")
        analysis_truncated = str(bool(p.get("analysis_truncated"))).lower()
        blocks.append(
            f"- id: {p['id']}\n  title: {p['title']}\n"
            f"  analysis_source: {p.get('analysis_source', 'abstract_fallback')}\n"
            f"  analysis_chars: {p.get('analysis_chars', len(analysis_text))}\n"
            f"  analysis_truncated: {analysis_truncated}\n"
            f"  analysis_text:\n"
            f"<<<ANALYSIS_TEXT\n{analysis_text}\nANALYSIS_TEXT"
        )
    papers_block = "\n".join(blocks)
    # Spec D3: the owner's project focus grounds why_selected_loc. focus_project
    # is the project slug; focus_context is an optional owner-curated line about
    # what is being built right now (anti-formulaic grounding).
    cfg = load_config()
    focus_lines = ["The user's project context: a local AI orchestrator with "
                   "agents, memory/KB in markdown and tool-use (Vepol)."]
    if cfg.get("focus_project"):
        focus_lines.append(f"Focus project: {cfg['focus_project']}.")
    if cfg.get("focus_context"):
        focus_lines.append(f"Current focus: {cfg['focus_context']}.")
    FOCUS_BLOCK = " ".join(focus_lines)
    return f"""# Translate + analyze today's arXiv papers ({date_iso})

The user's language is: {UI_LANG_NAME}. For EACH paper below, summarize it in
{UI_LANG_NAME}, STRICTLY from the supplied `analysis_text` — no outside claims,
no invented numbers, no web search:
- `analysis_source: full_text` means `analysis_text` is extracted from the full
  arXiv PDF. Use the whole supplied text, including method/evaluation sections.
- `analysis_source: abstract_fallback` means full text was unavailable; analyze
  only the supplied abstract and do not pretend to have read the full paper.
Explain these papers PROPERLY — a real summary, terms defined, method and
numbers. The lengths below are TARGET DEPTHS telling you how thorough to be
(content-quality guidance), NOT hard caps — a genuinely richer paper may run a
bit longer and that is fine; only a runaway dump of the whole paper is wrong:
- `title_loc`: short title translation in {UI_LANG_NAME}
- `abstract_loc`: a full 5-8 sentence plain-language summary in {UI_LANG_NAME}
  (target ~{TARGET_ABSTRACT} chars), every acronym and technical term expanded
  inline on first mention per paper
- `studied_loc`: what exactly they studied in {UI_LANG_NAME} (target ~{TARGET_STUDIED} chars)
- `method_loc`: how they studied it and on what exact data/benchmark/experiment/model/setup, if stated in `analysis_text`; if not stated, say the supplied text does not specify this (target ~{TARGET_METHOD} chars)
- `found_loc`: what they found/claim in {UI_LANG_NAME}, with concrete numbers from `analysis_text` mandatory when present (target ~{TARGET_FOUND} chars)
- `why_selected_loc`: 2-4 sentences in {UI_LANG_NAME} with BOTH clauses
  mandatory: (a) why THIS paper made today's selection — its topic in plain
  words, and (b) what concretely to apply or check in the user's own projects
  (derived from `analysis_text`, target ~{TARGET_WHY_SELECTED} chars).
  {FOCUS_BLOCK}
- `terms`: {TERMS_MIN}-{TERMS_MAX} glossary entries per paper, each a plain-language
  definition of a key acronym/technical term used in the summary — the glossary
  the user asked for. Each entry {{"term": "<name>", "def": "<plain-language definition in {UI_LANG_NAME}, target ~{TARGET_TERM_DEF} chars>"}}

Papers:
{papers_block}

Return ONLY one JSON object, no prose before or after, exactly this shape:
{{"papers": [{{"id": "<arxiv id>",
"title_loc": "<title in {UI_LANG_NAME}>",
"abstract_loc": "<full plain-language summary in {UI_LANG_NAME}, terms expanded inline>",
"studied_loc": "<sentences in {UI_LANG_NAME}>",
"method_loc": "<how it was researched, and on what data/benchmark/experiment/setup; or 'not specified in the supplied text' in {UI_LANG_NAME}>",
"found_loc": "<sentences in {UI_LANG_NAME}, numbers when present>",
"why_selected_loc": "<2-4 sentences in {UI_LANG_NAME}: why selected + what to apply in the user's projects>",
"terms": [{{"term": "<name>", "def": "<plain-language definition in {UI_LANG_NAME}>"}}]}}]}}

Rules: `studied_loc`/`method_loc`/`found_loc`/`abstract_loc` are
translations/compressions of the provided `analysis_text` only — never add
facts the supplied text does not state. For `method_loc`, prefer concrete nouns
from the supplied text such as dataset, benchmark, experiment, user study,
simulation, proof, corpus, model family, evaluation setup, or deployment setup.
If the supplied text does not say how/on what the work was evaluated,
explicitly say that this is not specified in the supplied text.
`abstract_loc` is the user's main quick-understanding field. Expand acronyms
and technical terms inline on first mention for each paper in the form
`ACRONYM (English expansion, rendering in {UI_LANG_NAME})` — e.g.
`LLM (large language model, …)`, `RAG (retrieval-augmented generation, …)`,
`MCP (Model Context Protocol, …)` — filling each `…` with the
{UI_LANG_NAME} rendering (when the target IS English, the two parts coincide).
Write the prose genuinely in {UI_LANG_NAME}: translate the phrasing, do not
copy English sentences from the supplied text; keep Latin script only for proper
nouns, model/dataset/benchmark names and established terms (MCP, RAG).
"""


def run_grok(date_iso: str, papers: list) -> tuple:
    """Returns (stdout, rc, stderr_tail). Never raises."""
    prompt_file = ORCH / f"learning-arxiv-grok-prompt-{date_iso}.md"
    atomic_write(prompt_file, grok_prompt(date_iso, papers))
    timeout = int(os.environ.get("KB_LEARNING_ARXIV_GROK_TIMEOUT", str(GROK_TIMEOUT_DEFAULT)))
    cmd = [
        grok_bin(),
        "--cwd", str(HUB),
        "--prompt-file", str(prompt_file),
        "--output-format", "plain",
        "--permission-mode", "acceptEdits",
        "--max-turns", "120",
        "--no-subagents",
        "--no-memory",
    ]
    try:
        # stdin=DEVNULL: CLI agents crash or hang on an inherited closed/open
        # stdin under background runners (same class as the codex>=0.138
        # spawner incident 2026-06-11; grok 0.2.22 SIGSEGVs, repro 2026-06-12).
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout,
                              check=False, stdin=subprocess.DEVNULL)
        return proc.stdout, proc.returncode, (proc.stderr or "")[-300:]
    except subprocess.TimeoutExpired:
        return "", -1, "grok timeout"
    except Exception as exc:
        return "", -1, str(exc)[-300:]


def parse_papers_json(text: str) -> dict:
    """Best-effort: outermost JSON object → {paper_id: record}. Used for both
    the Codex translation message (clean -o capture) and Grok social stdout.
    A bare top-level array would NOT parse here — both prompts pin the
    {"papers": [...]} envelope on purpose (a malformed/array envelope degrades
    ALL papers wholesale, not per-paper)."""
    text = (text or "").strip()
    start, end = text.find("{"), text.rfind("}")
    if start == -1 or end <= start:
        return {}
    try:
        data = json.loads(text[start:end + 1])
    except json.JSONDecodeError:
        return {}
    out = {}
    for rec in data.get("papers", []) if isinstance(data, dict) else []:
        if isinstance(rec, dict) and rec.get("id"):
            out[str(rec["id"])] = rec
    return out


def accept_loc(text: str) -> bool:
    """For ru the Cyrillic check reliably catches an English slip; for all
    other targets accept non-empty (documented degraded validation — spec:
    user-language-setting-2026-06-12)."""
    if not text:
        return False
    if UI_LANG == "ru":
        return bool(CYRILLIC_RE.search(text))
    return True


def _oversized(text: str, target: int) -> bool:
    """A field that parsed but ran pathologically over its D2 target depth
    (>= OVERSIZE_FACTOR x target). A genuinely richer summary that merely
    exceeds the target is fine — only a runaway (e.g. the whole paper dumped
    into one field) is rejected. NEVER silently truncated (D2)."""
    return bool(text) and len(text) >= OVERSIZE_FACTOR * target


def _valid_terms(raw) -> list:
    """Return the accepted glossary entries: {term, def} with a non-empty term
    whose NAME is not oversized (spec full-paper-messages D2: the name gate
    closes the "every rendered section ≤ TELEGRAM_MAX" guarantee) and a
    non-empty def that is accept_loc-valid and not oversized (D2)."""
    out = []
    if not isinstance(raw, list):
        return out
    for e in raw:
        if not isinstance(e, dict):
            continue
        term = str(e.get("term", "") or "").strip()
        definition = str(e.get("def", "") or "").strip()
        if not term or not definition:
            continue
        if _oversized(term, TARGET_TERM_NAME):
            continue
        if _oversized(definition, TARGET_TERM_DEF) or not accept_loc(definition):
            continue
        out.append({"term": term, "def": definition})
    return out


# Core required localized fields (present + accept_loc + not oversized) — the
# gate for a SEMANTIC-success attempt (D1). why_selected_loc/title_loc/terms are
# enrichment: their absence marks the run `partial`, never rejects the attempt.
_CORE_LOC_FIELDS = (
    ("abstract_loc", TARGET_ABSTRACT),
    ("studied_loc", TARGET_STUDIED),
    ("method_loc", TARGET_METHOD),
    ("found_loc", TARGET_FOUND),
)


def _has_papers_envelope(text: str) -> bool:
    """True when the outermost JSON object parses and is a dict carrying a
    `papers` list — used to tell an empty {"papers": []} (incomplete) apart
    from text with no JSON object at all (bad_json)."""
    t = (text or "").strip()
    start, end = t.find("{"), t.rfind("}")
    if start == -1 or end <= start:
        return False
    try:
        data = json.loads(t[start:end + 1])
    except json.JSONDecodeError:
        return False
    return isinstance(data, dict) and isinstance(data.get("papers"), list)


def _validate_translation(papers: list, by_id: dict) -> tuple:
    """Pure acceptance gate for one executor attempt (no mutation, so a rejected
    attempt never half-writes papers). Success requires a record for EVERY
    selected id with every core field present, accept_loc-valid and not
    oversized. Returns (accepted, reason ∈ {incomplete, language_rejected,
    oversized, ok})."""
    for p in papers:
        rec = by_id.get(p["id"])
        if not isinstance(rec, dict):
            return False, "incomplete"
        for key, target in _CORE_LOC_FIELDS:
            val = str(rec.get(key, "") or "").strip()
            if not val:
                return False, "incomplete"
            if _oversized(val, target):
                return False, "oversized"
            if not accept_loc(val):
                return False, "language_rejected"
    return True, "ok"


def _apply_translation(papers: list, by_id: dict, agent: str) -> bool:
    """Commit an ACCEPTED attempt's fields (validated by _validate_translation).
    Returns partial=True when any enrichment field (why_selected_loc / terms glossary)
    fell back for at least one paper."""
    partial = False
    for p in papers:
        rec = by_id[p["id"]]
        for key, _target in _CORE_LOC_FIELDS:
            p[key] = str(rec.get(key, "") or "").strip()
        p["abstract_source"] = agent
        p["summary_source"] = agent
        title_loc = str(rec.get("title_loc", "") or "").strip()
        if title_loc and accept_loc(title_loc) and not _oversized(title_loc, 200):
            p["title_loc"] = title_loc
        why_selected = str(rec.get("why_selected_loc", "") or "").strip()
        if (why_selected and accept_loc(why_selected)
                and not _oversized(why_selected, TARGET_WHY_SELECTED)):
            p["why_selected_loc"] = why_selected
        else:
            partial = True
        terms = _valid_terms(rec.get("terms"))
        if len(terms) >= TERMS_MIN:
            p["terms"] = terms[:TERMS_MAX]
        else:
            partial = True
    return partial


def translate_check(date_iso: str, papers: list) -> tuple:
    """D1 pluggable translate/analysis executor chain. Tries each configured
    agent (KB_LEARNING_ARXIV_TRANSLATE_AGENTS, default claude,codex) in order;
    the prompt is delivered by pointer FILE to every agent (never argv). SUCCESS
    IS SEMANTIC: an attempt counts only when its output parses as the JSON
    envelope, has a papers[] entry for every selected id, and every core field
    is present, accept_loc-valid and not oversized. rc=0-but-bad = failure →
    next agent. Launch errors / timeouts are caught per-agent, never crash the
    run. Mutates papers in place with the *_loc fields + abstract_source /
    summary_source (= the accepted agent name, else unavailable / fallback_en).
    Returns (status ∈ {ok, partial, degraded}, translate_agent|None,
    translate_attempts, raw_message). Independent of the Grok social call."""
    if not papers:
        return "ok", None, [], ""
    prompt = codex_prompt(date_iso, papers)
    prompt_file = ORCH / f"learning-arxiv-codex-prompt-{date_iso}.md"
    atomic_write(prompt_file, prompt)
    attempts = []
    deadline = time.monotonic() + TRANSLATE_CHAIN_TIMEOUT
    accepted_agent = None
    partial = False
    last_raw = ""
    for name in translate_agents():
        fn = TRANSLATE_BACKENDS.get(name)
        if fn is None:
            log(f"{date_iso}: unknown translate agent {name!r}; skipping")
            continue
        remaining = int(deadline - time.monotonic())
        if name != "claude" and remaining < 30:
            log(f"{date_iso}: translate chain budget exhausted before {name}")
            continue
        t0 = time.monotonic()
        lane_budget = (
            TRANSLATE_TIMEOUT
            if name == "claude"
            else min(TRANSLATE_TIMEOUT, remaining)
        )
        raw, rc, launch_reason, err_tail = fn(
            prompt_file, date_iso, lane_budget
        )
        secs = round(time.monotonic() - t0, 1)
        if raw:
            last_raw = raw
        if launch_reason in ("launch_error", "timeout"):
            attempts.append({"agent": name, "rc": rc, "secs": secs,
                             "reason": launch_reason, "err_tail": err_tail})
            log(f"{date_iso}: translate {name} {launch_reason}: {err_tail}")
            continue
        by_id = parse_papers_json(raw or "")
        if not by_id:
            # A well-formed {"papers": []} envelope (parsed but no records) is
            # `incomplete`; text with no JSON object at all is `bad_json`.
            reason = "incomplete" if _has_papers_envelope(raw or "") else "bad_json"
            attempts.append({"agent": name, "rc": rc, "secs": secs,
                             "reason": reason, "err_tail": (err_tail or "")[:200]})
            log(f"{date_iso}: translate {name} {reason} (rc={rc})")
            continue
        ok_attempt, reason = _validate_translation(papers, by_id)
        if ok_attempt:
            partial = _apply_translation(papers, by_id, name)
            attempts.append({"agent": name, "rc": rc, "secs": secs,
                             "reason": "ok", "err_tail": ""})
            accepted_agent = name
            log(f"{date_iso}: translate via {name}: accepted "
                f"({'partial' if partial else 'ok'})")
            break
        attempts.append({"agent": name, "rc": rc, "secs": secs,
                         "reason": reason, "err_tail": ""})
        log(f"{date_iso}: translate {name} rejected: {reason}; trying next")
    if accepted_agent is None:
        # All executors failed → every paper falls back to the deterministic
        # English extract, explicitly marked so the digest is honest (D5).
        for p in papers:
            p["abstract_source"] = "unavailable"
            p["summary_source"] = "fallback_en"
        status = "degraded"
    elif partial:
        status = "partial"
    else:
        status = "ok"
    return status, accepted_agent, attempts, last_raw


# D5 — degradation becomes visible. Exact owner-facing wording (spec); the
# report is voiced by the morning digest in the owner's language (ru).
TRANSLATE_WARNINGS = {
    "degraded": "⚠️ перевод недоступен — ниже английские выдержки",
    "partial": "⚠️ перевод получился не для всех статей — часть на английском",
}


def translate_warning(status: str) -> str:
    return TRANSLATE_WARNINGS.get(status, "")


def _translate_chain_reasons(attempts: list) -> str:
    return ", ".join(f"{a.get('agent', '?')}:{a.get('reason', '?')}" for a in attempts) or "no attempts"


def emit_translate_degradation(date_iso: str, status: str, attempts: list) -> None:
    """On translate_check != ok, append ONE grep-canonical line to
    ~/knowledge/log.md, deduped to one line per (date, state): forced or
    repeated runs on the same date with the same state do not re-append (D5).
    The runner never writes incidents.md."""
    if status == "ok":
        return
    voiced = "fallback_en" if status == "degraded" else "mixed"
    line = (f'## [{date_iso}] learning-arxiv | hub | "translate {status}: '
            f'chain {_translate_chain_reasons(attempts)} ; digest voiced {voiced}"')
    log_file = HUB / "log.md"
    marker = f'## [{date_iso}] learning-arxiv | hub | "translate {status}:'
    try:
        if log_file.is_file():
            for existing in log_file.read_text(encoding="utf-8").splitlines():
                if existing.startswith(marker):
                    return  # already recorded this (date, state)
    except OSError as exc:
        log(f"{date_iso}: could not read log.md for dedup: {exc}")
    try:
        log_file.parent.mkdir(parents=True, exist_ok=True)
        with log_file.open("a", encoding="utf-8") as f:
            f.write(line + "\n")
    except OSError as exc:
        log(f"{date_iso}: could not append translate degradation to log.md: {exc}")


def social_check(date_iso: str, papers: list) -> tuple:
    """X/Reddit social signal via Grok ONLY (translation moved to Codex).
    Mutates papers in place with per-paper p['social']. Returns
    (social_check_status, grok_rc, stderr_tail, raw_stdout). INDEPENDENT of
    translation: a Grok failure degrades only the social lines."""
    if not papers:
        return "ok", None, "", ""
    stdout, rc, stderr_tail = run_grok(date_iso, papers)
    by_id = parse_papers_json(stdout) if rc == 0 and stdout.strip() else {}
    whole_call_failed = rc != 0 or not stdout.strip() or not by_id
    any_degraded = False
    all_parsed = True
    for p in papers:
        rec = by_id.get(p["id"], {})
        social = {}
        for ch in ("x_status", "reddit_status"):
            val = str(rec.get(ch, "")).strip()
            if whole_call_failed or val not in SOCIAL_STATUSES:
                # Search failure or unparseable value is degraded — never an
                # invented not_found (spec hard rule).
                social[ch] = "degraded"
                any_degraded = True
                all_parsed = False
            else:
                social[ch] = val
                if val == "degraded":
                    any_degraded = True
        social["evidence"] = str(rec.get("evidence", "") or "")[:500]
        social["prior_context"] = truncate_sentence(str(rec.get("prior_context", "") or ""), 200)
        p["social"] = social
    if whole_call_failed:
        status = "degraded"
    elif any_degraded or not all_parsed:
        status = "partial"
    else:
        status = "ok"
    return status, rc, stderr_tail, stdout


# --------------------------------------------------------------------------
# Renderers
# --------------------------------------------------------------------------

def render_status(value: str) -> str:
    return L("statuses").get(value, value)


def _loc_field(paper: dict, key: str):
    """Localized LLM field with legacy `_ru` fallback (target ru only)."""
    val = paper.get(f"{key}_loc")
    if not val and UI_LANG == "ru":
        val = paper.get(f"{key}_ru")
    return val


def title_display(paper: dict, limit: int = 160) -> str:
    loc = _loc_field(paper, "title")
    if loc:
        return truncate_sentence(loc, limit)
    # Raw feed titles are ungated input — never render them unbounded.
    return truncate_sentence(paper.get("title", ""), 200 if limit is None else limit)


# NOTE: the old score-based reason_text (topics; abstract-signal; score) is
# gone from ALL user surfaces (spec full-paper-messages D4): «Почему выбрана»
# is why_selected_text everywhere; the raw scoring audit lives in the report's
# «Скоры» line and the snapshot's reason= field (p["reason"]).


def render_snapshot(date_iso: str, papers: list, runner_ups: list, fetched: int, relevant: int) -> str:
    lines = [
        "---",
        "type: source",
        "kind: arxiv-learning-snapshot",
        f"date: {date_iso}",
        f"total_fetched: {fetched}",
        f"total_relevant: {relevant}",
        f"selected: {len(papers)}",
        "generator: kb-learning-arxiv v1",
        "---",
        "",
        f"# arXiv learning snapshot — {date_iso}",
        "",
        "## Selected",
        "",
    ]
    for p in papers:
        lines.append(
            f"- **{p['title']}** — {render_authors(p['authors'])}\n"
            f"  {p['link']} · {p.get('primary_category', '')} · {p.get('published', '')[:10]}\n"
            f"  scores: {json.dumps(p['scores'])}\n"
            f"  reason: {p['reason']}\n"
            f"  {p['abstract'][:600]}\n"
        )
    if runner_ups:
        # Audit trail only: keep the top-10 ranked runner-ups here (the report
        # the digest reads no longer carries this list — spec D3).
        lines.append("## Runner-ups\n")
        for r in runner_ups[:10]:
            lines.append(f"- {r['id']} **{r['title']}** — {r['reason_rejected']} (final={r['scores']['final']})")
    return "\n".join(lines) + "\n"


def render_social_source(date_iso: str, papers: list, status: str, rc, stderr_tail: str, raw: str) -> str:
    lines = [
        "---",
        "type: source",
        "kind: arxiv-learning-social-grok",
        f"date: {date_iso}",
        f"social_check: {status}",
        f"grok_rc: {rc if rc is not None else 'null'}",
        "generator: kb-learning-arxiv v1",
        "---",
        "",
        f"# Grok social check — {date_iso}",
        "",
    ]
    for p in papers:
        s = p.get("social", {})
        lines.append(
            f"## {p['id']} {p['title']}\n"
            f"- X: {s.get('x_status', 'degraded')}\n"
            f"- Reddit: {s.get('reddit_status', 'degraded')}\n"
            f"- Evidence: {s.get('evidence', '') or '—'}\n"
            f"- Prior context: {s.get('prior_context', '') or '—'}\n"
        )
    if stderr_tail:
        lines.append(f"## Grok stderr tail\n\n```\n{stderr_tail}\n```\n")
    lines.append("## Raw stdout\n\n```\n" + (raw or "")[:4000] + "\n```")
    return "\n".join(lines) + "\n"


def render_translation_source(date_iso: str, papers: list, status: str,
                              agent, attempts: list, raw: str) -> str:
    lines = [
        "---",
        "type: source",
        "kind: arxiv-learning-translation-codex",
        f"date: {date_iso}",
        f"translate_check: {status}",
        f"translate_agent: {agent if agent is not None else 'null'}",
        "generator: kb-learning-arxiv v1",
        "---",
        "",
        f"# Translation/analysis — {date_iso}",
        "",
        "## Executor chain attempts",
        "",
    ]
    for a in attempts:
        tail = f" — {a.get('err_tail')}" if a.get("err_tail") else ""
        lines.append(f"- {a.get('agent')}: reason={a.get('reason')} "
                     f"rc={a.get('rc')} secs={a.get('secs')}{tail}")
    lines.append("")
    for p in papers:
        block = [
            f"## {p['id']} {p['title']}",
            f"- analysis_source: {p.get('analysis_source', 'abstract_fallback')}",
            f"- analysis_chars: {p.get('analysis_chars', 0)}",
            f"- analysis_truncated: {str(bool(p.get('analysis_truncated'))).lower()}",
        ]
        if p.get("analysis_error"):
            block.append(f"- analysis_error: {p.get('analysis_error')}")
        block.extend([
            f"- abstract_source: {p.get('abstract_source', 'unavailable')}",
            f"- summary_source: {p.get('summary_source', 'fallback_en')}",
            f"- title_loc: {p.get('title_loc', '') or '—'}",
            f"- abstract_loc: {p.get('abstract_loc', '') or '—'}",
            f"- method_loc: {p.get('method_loc', '') or '—'}",
            f"- terms: {len(p.get('terms', []))} entries",
            "",
        ])
        lines.append("\n".join(block))
    lines.append("## Raw message\n\n```\n" + (raw or "")[:4000] + "\n```")
    return "\n".join(lines) + "\n"


def render_report(date_iso: str, papers: list, runner_ups: list, social_status: str,
                  relevant: int, fetched: int = 0, translate_status: str = "ok") -> str:
    lines = [
        f"# {L('report_title').format(date=date_iso)}",
        "",
        L("report_stats").format(
            fetched=fetched, relevant=relevant, n=len(papers)),
        "",
    ]
    # D5: visible "Translation status" line in the report header on !=ok.
    warning = translate_warning(translate_status)
    if warning:
        lines.append(f"**{L('report_translate_status')}:** {warning}")
        lines.append("")
    render_social = should_render_social(social_status)
    for i, p in enumerate(papers, 1):
        s = p.get("social", {})
        # D2: each field rendered in FULL (limit=None) — no display truncation.
        block = [
            f"## {i}. {title_display(p, None)}",
            "",
            f"- {L('report_original')}: {p['title']}",
            f"- {L('report_authors')}: {render_authors(p['authors'])}",
            f"- arXiv: {p['link']}",
            f"- {L('report_category')}: {p.get('primary_category', '—')} · {p.get('published', '')[:10]}",
            f"- {L('reason')}: {why_selected_text(p)}",
            f"- {L('report_scores')}: `{json.dumps(p['scores'])}`",
            "",
            f"**{L('studied')}:** {studied_display(p, None)}",
            "",
            f"**{L('method')}:** {method_display(p, None)}",
            "",
            f"**{L('found')}:** {found_display(p, None)}",
            "",
        ]
        if render_social:
            block.extend([
                f"**X:** {render_status(s.get('x_status', 'degraded'))} · "
                f"**Reddit:** {render_status(s.get('reddit_status', 'degraded'))}",
                f"**{L('report_prior')}:** {s.get('prior_context', '') or '—'}",
                f"**{L('report_evidence')}:** {s.get('evidence', '') or '—'}",
                "",
            ])
        block.extend([
            f"**{L('report_abstract')}:** {abstract_display(p, None)}",
            "",
        ])
        terms = p.get("terms") or []
        if terms:
            block.append(f"**{L('report_terms')}:**")
            block.extend(f"- {t.get('term')}: {t.get('def')}" for t in terms)
            block.append("")
        lines.extend(block)
    # D3/spec: runner-ups list is UNNEEDED data in the report the digest reads —
    # it is removed entirely (the ranked top-10 stays in the sources/ snapshot).
    sources = [
        f"[[arxiv-learning-snapshot-{date_iso}]]",
        f"[[arxiv-learning-translation-codex-{date_iso}]]",
    ]
    if render_social:
        sources.append(f"[[arxiv-learning-social-grok-{date_iso}]]")
    lines.append(f"{L('report_sources')}: {', '.join(sources)}")
    return "\n".join(lines) + "\n"


class RenderOversize(RuntimeError):
    """A rendered Telegram message cannot fit TELEGRAM_MAX even after the
    terms-drop and section-split cascade — a render bug by construction
    (spec full-paper-messages D2 step 3). Delivery must fail closed: the
    sender is never handed a message it would truncate."""


def render_header_message(date_iso: str, papers: list, relevant: int,
                          max_papers: int, fetched: int,
                          translate_status: str) -> str:
    lines = [f"🧪 arXiv learning — {date_iso}", ""]
    # D5 (prior spec): visible degradation warning as the FIRST body line —
    # never a silent fallback_en again.
    warning = translate_warning(translate_status)
    if warning:
        lines.append(warning)
        lines.append("")
    scanned = (
        L("scanned").format(fetched=fetched, relevant=relevant)
        if fetched else
        L("scanned_nofetch").format(relevant=relevant)
    )
    report_rel = f"reports/learning-arxiv-summary-{date_iso}.md"
    if not papers:
        lines.append(f"{scanned} {L('zero')}")
    elif len(papers) < max_papers:
        lines.append(f"{scanned} {L('fewer').format(n=len(papers))}")
    else:
        lines.append(f"{scanned} {L('picked').format(n=len(papers))}")
    lines.append("")
    lines.append(L("footer").format(path=report_rel))
    return "\n".join(lines)


def paper_sections(p: dict, idx: int, total: int, social_status: str,
                   include_terms: bool = True) -> tuple:
    """(head, sections) for one paper message. Every narrative field renders
    in FULL (limit=None) — the no-truncation invariant of the spec. The head
    carries numbering; continuation pieces re-mint it via continuation_head."""
    head = (f"{idx}/{total} · {title_display(p, None)}\n"
            f"{render_authors(p['authors'])} · arXiv: {p['link']}")
    sections = [
        f"{L('reason')}: {why_selected_text(p)}",
        f"{L('studied')}: {studied_display(p, None)}",
        f"{L('method')}: {method_display(p, None)}",
        f"{L('found')}: {found_display(p, None)}",
    ]
    if should_render_social(social_status):
        s = p.get("social", {})
        social_line = (
            f"X: {render_status(s.get('x_status', 'degraded'))} / "
            f"Reddit: {render_status(s.get('reddit_status', 'degraded'))}"
        )
        prior = s.get("prior_context", "")
        if prior:
            social_line += f" — {prior}"
        sections.append(social_line)
    terms = p.get("terms") or []
    if include_terms and terms:
        sections.append(
            f"{L('report_terms')}:\n"
            + "\n".join(f"- {t.get('term')}: {t.get('def')}" for t in terms)
        )
    return head, sections


def continuation_head(p: dict, idx: int, total: int) -> str:
    return f"{idx}/{total} · {title_display(p, None)} (продолжение)"


def pack_paper_messages(p: dict, idx: int, total: int, social_status: str) -> list:
    """One paper → one or more Telegram messages, each ≤ TELEGRAM_MAX.

    Cascade (spec D2): full message → drop terms → greedy section-boundary
    packing into as many pieces as needed (≥2). Raises RenderOversize when a
    single head+section pair cannot fit — unreachable while the parse gates
    hold (every field ≤ 3× its target, term names gated), kept as the
    fail-closed guard."""
    for include_terms in (True, False):
        head, sections = paper_sections(p, idx, total, social_status,
                                        include_terms=include_terms)
        msg = "\n\n".join([head] + sections)
        if len(msg) <= TELEGRAM_MAX:
            return [msg]
    # Greedy split at section boundaries; terms stay dropped (report keeps them).
    head, sections = paper_sections(p, idx, total, social_status,
                                    include_terms=False)
    pieces, cur = [], [head]
    cont = continuation_head(p, idx, total)
    for sec in sections:
        candidate = "\n\n".join(cur + [sec])
        if len(candidate) <= TELEGRAM_MAX:
            cur.append(sec)
            continue
        if len(cur) > 1:
            pieces.append("\n\n".join(cur))
            cur = [cont]
        if len("\n\n".join(cur + [sec])) > TELEGRAM_MAX:
            raise RenderOversize(
                f"paper {p.get('id', '?')}: section of {len(sec)} chars cannot "
                f"fit TELEGRAM_MAX={TELEGRAM_MAX} even alone"
            )
        cur.append(sec)
    if len(cur) > 1:
        pieces.append("\n\n".join(cur))
    return pieces


def render_messages(date_iso: str, papers: list, relevant: int, max_papers: int,
                    fetched: int = 0, social_status: str = "skipped",
                    translate_status: str = "ok") -> list:
    """The full Telegram sequence: header message + per-paper messages
    (spec full-paper-messages D1). Zero-paper days stay a single message.
    Every returned message is ≤ TELEGRAM_MAX by construction; a violation
    raises RenderOversize (fail closed — checked once more at the end)."""
    messages = [render_header_message(date_iso, papers, relevant, max_papers,
                                      fetched, translate_status)]
    total = len(papers)
    for idx, p in enumerate(papers, 1):
        messages.extend(pack_paper_messages(p, idx, total, social_status))
    for m in messages:
        if len(m) > TELEGRAM_MAX:
            raise RenderOversize(
                f"rendered message of {len(m)} chars exceeds TELEGRAM_MAX={TELEGRAM_MAX}"
            )
    return messages


# --------------------------------------------------------------------------
# Delivery
# --------------------------------------------------------------------------

def process_outputs() -> set:
    raw = os.environ.get("KB_PROCESS_OUTPUTS", "telegram,file")
    return {part.strip() for part in raw.split(",") if part.strip()}


def resolve_channel_send_bin() -> str:
    hub_bin = HUB / "bin" / "kb-channel-send"
    if hub_bin.exists():
        return str(hub_bin)
    default_bin = pathlib.Path.home() / "knowledge" / "bin" / "kb-channel-send"
    if default_bin.exists():
        return str(default_bin)
    return ""


def deliver_messages(date_iso: str, fresh_messages: list, manifest: dict) -> int:
    """Sequential per-message delivery with resume-by-index (spec D5).

    A partially delivered day stores its exact `messages` in the manifest;
    a delivery-only retry reuses that stored list byte-for-byte and resumes
    from `messages_delivered`, so already-sent messages are never duplicated.
    A fresh pipeline pass (stage re-run, language switch, --force) reaches
    here with those keys dropped and rebuilds from fresh_messages."""
    outputs = process_outputs()
    manifest["outputs"] = sorted(outputs)
    stored = manifest.get("messages")
    if isinstance(stored, list) and stored and all(isinstance(m, str) for m in stored):
        messages = stored
    else:
        messages = list(fresh_messages)
        manifest["messages"] = messages
        manifest["messages_delivered"] = 0
    # Outbound size validation for ANY source (stored included): the sender
    # must never receive a message it would split/truncate. A corrupt stored
    # list fails closed here; the keys are dropped so the next run rebuilds
    # from the intact content stages (possible re-send of already delivered
    # pieces is logged corrupt-store recovery, not the normal path).
    oversize = [i for i, m in enumerate(messages) if len(m) > TELEGRAM_MAX]
    if oversize:
        if messages is stored:
            # Distinct marker promised by spec D5: this is corrupt-store
            # recovery (stored list dropped, next run rebuilds and may
            # re-send already delivered pieces), not a fresh-render bug.
            log(f"{date_iso}: corrupt-store recovery — stored message(s) "
                f"{oversize} exceed TELEGRAM_MAX={TELEGRAM_MAX}; dropping "
                f"stored sequence, full rebuild+resend on next run")
        return _render_failed(
            date_iso, manifest,
            RuntimeError(f"stored/fresh message(s) {oversize} exceed "
                         f"TELEGRAM_MAX={TELEGRAM_MAX}"))
    manifest["digest"] = "\n\n".join(messages)
    if "telegram" not in outputs:
        manifest["digest_delivered"] = False
        manifest["status"] = "completed"
        manifest["error"] = None
        save_manifest(date_iso, manifest)
        log(f"{date_iso}: completed without telegram output (outputs={sorted(outputs)})")
        return 0
    sender = resolve_channel_send_bin()
    if not sender:
        return _delivery_failed(date_iso, manifest, "kb-channel-send not found")
    try:
        start = int(manifest.get("messages_delivered") or 0)
    except (TypeError, ValueError):
        start = 0
    # Clamp a malformed counter instead of crashing or over-indexing.
    start = max(0, min(start, len(messages)))
    manifest["messages_delivered"] = start
    for i in range(start, len(messages)):
        try:
            proc = subprocess.run(
                [sender, "learning-arxiv", messages[i]],
                capture_output=True, text=True, timeout=60, check=False,
                stdin=subprocess.DEVNULL,
            )
        except Exception as exc:
            # A hung/crashed sender must record a failed manifest, not crash
            # the runner with an unwritten state (TimeoutExpired included).
            return _delivery_failed(
                date_iso, manifest,
                f"telegram delivery failed at message {i + 1}/{len(messages)}: {exc}")
        if proc.returncode != 0:
            detail = proc.stderr.strip() or proc.stdout.strip() or f"rc={proc.returncode}"
            return _delivery_failed(
                date_iso, manifest,
                f"telegram delivery failed at message {i + 1}/{len(messages)}: {detail}")
        # Durable per-message progress: a crash between sends resumes correctly.
        manifest["messages_delivered"] = i + 1
        save_manifest(date_iso, manifest)
    manifest["digest_delivered"] = True
    manifest["status"] = "completed"
    manifest["error"] = None
    save_manifest(date_iso, manifest)
    log(f"{date_iso}: digest delivered ({len(messages)} messages)")
    return 0


def _render_failed(date_iso: str, manifest: dict, exc: Exception) -> int:
    """Spec D2 step 3 fail-closed: a message that cannot fit TELEGRAM_MAX is a
    render bug; nothing is handed to the sender."""
    manifest["digest_delivered"] = False
    manifest["status"] = "failed"
    manifest["error"] = f"render oversize (fail closed): {exc}"
    manifest.pop("messages", None)
    manifest.pop("messages_delivered", None)
    maybe_suggest_incident(date_iso, manifest)
    save_manifest(date_iso, manifest)
    log(f"{date_iso}: {manifest['error']}")
    return 1


def _delivery_failed(date_iso: str, manifest: dict, error: str) -> int:
    manifest["digest_delivered"] = False
    manifest["status"] = "failed"
    manifest["error"] = error
    maybe_suggest_incident(date_iso, manifest)
    save_manifest(date_iso, manifest)
    log(f"{date_iso}: {error}")
    return 1


def _deliver_no_new_papers(date_iso: str, manifest: dict) -> int:
    """D4 empty window: deliver ONE short honest message; watermark UNCHANGED
    (owner OQ-2 — short message, never silence)."""
    manifest["no_new_papers"] = True
    manifest["selected_papers"] = []
    manifest["runner_ups"] = []
    manifest["arxiv_relevant"] = 0
    manifest["error"] = None
    # Fresh pipeline pass: any partially delivered message list from an
    # earlier attempt is invalid here (the window was re-fetched).
    manifest.pop("messages", None)
    manifest.pop("messages_delivered", None)
    log(f"{date_iso}: empty window — no papers newer than the watermark")
    return deliver_messages(date_iso, [L("no_new_papers")], manifest)


def _advance_watermark_on_delivery(date_iso: str, manifest: dict) -> None:
    """Forward-only CAS advance to the window's newest submittedDate, only after
    a digest with papers was delivered from a fully fetched window (D4). Empty
    windows have no window_max_submitted and never advance."""
    raw = manifest.get("window_max_submitted")
    if not raw or not manifest.get("selected_papers"):
        return
    try:
        new_wm = parse_utc(raw)
    except Exception as exc:
        log(f"{date_iso}: window_max_submitted unparseable, watermark not advanced: {exc}")
        return
    try:
        advance_watermark(new_wm)
        log(f"{date_iso}: watermark advanced to {new_wm.isoformat()}")
    except Exception as exc:
        log(f"{date_iso}: watermark advance failed: {exc}")


def maybe_suggest_incident(date_iso: str, manifest: dict) -> None:
    if int(manifest.get("attempts") or 0) >= INCIDENT_ATTEMPTS and not manifest.get("incident_suggested"):
        manifest["incident_suggested"] = True
        log(f"{date_iso}: ESCALATE — {manifest['attempts']} failed attempts today; "
            f"suggest incident review (runner never auto-writes incidents.md)")


# --------------------------------------------------------------------------
# Main flow
# --------------------------------------------------------------------------

def run(date_iso: str, force: bool, dry_run: bool) -> int:
    cfg = load_config()
    if dry_run:
        social_note = "run Grok social check" if social_enabled(cfg) else "skip Grok social check"
        print(f"[dry] would fetch arXiv Atom ({cfg['arxiv_categories']}), select up to "
              f"{cfg['max_papers']} papers, {social_note}, deliver the "
              f"telegram digest in {UI_LANG_NAME}, write {rel(report_path(date_iso))}")
        return 0

    lock_fh = acquire_lock(date_iso)
    manifest = load_manifest(date_iso)
    if lock_fh is None:
        if manifest.get("digest_delivered"):
            log(f"{date_iso}: lock held but digest already delivered; rc=0")
            return 0
        log(f"{date_iso}: another run holds the lock and no delivered digest; rc=1")
        return 1
    # D4: the watermark is global but the per-date run lock is not, so a manual
    # forced run could race the scheduled one. Guard read→select→deliver→write
    # of the watermark with a dedicated GLOBAL flock; a contender skips cleanly.
    wm_lock = acquire_watermark_lock()
    if wm_lock is None:
        delivered = bool(manifest.get("digest_delivered"))
        log(f"{date_iso}: watermark lock held by another run; skipping cleanly "
            f"(delivered={delivered})")
        fcntl.flock(lock_fh.fileno(), fcntl.LOCK_UN)
        lock_fh.close()
        return 0 if delivered else 1
    try:
        return _run_locked(date_iso, cfg, manifest, force)
    finally:
        fcntl.flock(wm_lock.fileno(), fcntl.LOCK_UN)
        wm_lock.close()
        fcntl.flock(lock_fh.fileno(), fcntl.LOCK_UN)
        lock_fh.close()


def _run_locked(date_iso: str, cfg: dict, manifest: dict, force: bool) -> int:
    if not force:
        if manifest.get("digest_delivered"):
            log(f"{date_iso}: digest already delivered; idempotent rc=0")
            return 0
        # Terminal-ness follows the CURRENT process outputs: a day completed
        # file-only stays terminal only while telegram is still not required;
        # if the config later adds telegram, fall through to the stage cache
        # and deliver.
        if manifest.get("status") == "completed" and "telegram" not in process_outputs():
            log(f"{date_iso}: already completed and telegram not required; rc=0")
            return 0
    if force:
        manifest = {"attempts": int(manifest.get("attempts") or 0)}

    cached_language = manifest.get("language") or "ru"  # pre-profile manifests were Russian
    # Capture cache-eligibility from the PRE-update manifest: the manifest.update
    # below stamps manifest_version=MANIFEST_VERSION, so reading it after would
    # always look current and defeat the migration gate (spec blocker fix).
    cached_version = int(manifest.get("manifest_version") or 1)
    cached_has_translate = bool(manifest.get("translate_check"))
    if cached_language != UI_LANG and manifest.get("selected_papers") is not None:
        # Language switched: the cached localized state belongs to the old
        # target. Drop it NOW, before the manifest is stamped with the new
        # language — otherwise a failed re-fetch would leave old *_loc
        # content under the new language stamp and a later retry would
        # serve stale-language text from the cache (codex impl-review
        # blocker 2026-06-12).
        log(f"{date_iso}: language switch {cached_language} -> {UI_LANG}; dropping cached selection")
        for stale_key in ("selected_papers", "runner_ups", "social_check",
                          "grok_rc", "grok_stderr_tail", "translate_check",
                          "translate_agent", "translate_attempts",
                          "window_max_submitted", "no_new_papers", "digest",
                          "messages", "messages_delivered"):
            manifest.pop(stale_key, None)
    manifest.update({
        "date": date_iso,
        "status": manifest.get("status") or "started",
        "attempts": int(manifest.get("attempts") or 0) + 1,
        "last_attempt_at": now_iso(),
        "language": UI_LANG,
        "learning_topic": cfg.get("learning_topic", "ai_agents"),
        "manifest_version": MANIFEST_VERSION,
    })
    manifest.setdefault("incident_suggested", False)
    manifest.setdefault("arxiv_fetched", 0)
    manifest.setdefault("arxiv_relevant", 0)
    save_manifest(date_iso, manifest)

    max_papers = int(cfg.get("max_papers") or MAX_PAPERS_DEFAULT)

    # Stage cache (spec): selection+translation+social already done, only
    # delivery failed → re-render and re-deliver from the manifest; never
    # re-fetch arXiv or re-invoke Codex/Grok.
    # `selected_papers is not None` (not truthiness): a completed zero-paper
    # day must also recover from the cache instead of re-fetching arXiv.
    # Language-gated: cached fields were produced for the cached language;
    # after a profile switch the cache is bypassed so no stale-language
    # content leaks (spec: user-language-setting-2026-06-12).
    # Version-gated: a v1 manifest written by the old combined-Grok runner has
    # no Codex translation; a v2 manifest has Codex translation but no
    # method_loc. Neither may satisfy the stage cache for the current output
    # contract. Require translate_check present AND
    # manifest_version >= MANIFEST_VERSION (both read from the PRE-update snapshot).
    current_social_enabled = social_enabled(cfg)
    cached_social_enabled = social_manifest_enabled(manifest)
    cached = (
        not force
        and manifest.get("selected_papers") is not None
        and manifest.get("social_check")
        and cached_has_translate
        and cached_version >= MANIFEST_VERSION
        and cached_language == UI_LANG
        and cached_social_enabled == current_social_enabled
    )
    if cached:
        log(f"{date_iso}: reusing cached selection+translation+social from manifest (stage cache)")
        papers = manifest["selected_papers"]
        stored = manifest.get("messages")
        if isinstance(stored, list) and stored and all(isinstance(m, str) for m in stored):
            # Delivery-only retry: the byte-exact stored sequence IS the
            # content — never re-render over it (a render failure here would
            # destroy resume progress; impl-review R1 blocker 1).
            fresh_messages = stored
        else:
            try:
                fresh_messages = render_messages(
                    date_iso, papers, int(manifest.get("arxiv_relevant") or len(papers)),
                    max_papers, fetched=int(manifest.get("arxiv_fetched") or 0),
                    social_status=str(manifest.get("social_check") or "skipped"),
                    translate_status=str(manifest.get("translate_check") or "ok"),
                )
            except RenderOversize as exc:
                return _render_failed(date_iso, manifest, exc)
        rc = deliver_messages(date_iso, fresh_messages, manifest)
        if rc == 0:
            _advance_watermark_on_delivery(date_iso, manifest)
        return rc

    # D4: since-last-seen watermark. Read → windowed EXHAUSTIVE fetch → select
    # papers with submittedDate STRICTLY newer than the watermark (half-open).
    try:
        watermark = read_watermark()  # None on first run; malformed → fail closed
    except Exception as exc:
        manifest["status"] = "failed"
        manifest["error"] = f"watermark unreadable (fail closed): {exc}"
        maybe_suggest_incident(date_iso, manifest)
        save_manifest(date_iso, manifest)
        log(f"{date_iso}: watermark unreadable, fail closed: {exc}")
        return 1
    now = now_utc()
    cutoff = effective_cutoff(watermark, now)
    try:
        candidates, fully_fetched = fetch_window(cfg["arxiv_categories"], cutoff)
    except Exception as exc:
        manifest["status"] = "failed"
        manifest["error"] = f"arxiv fetch failed: {exc}"
        maybe_suggest_incident(date_iso, manifest)
        save_manifest(date_iso, manifest)
        log(f"{date_iso}: arxiv fetch failed: {exc}")
        return 1

    if not fully_fetched:
        # CAP-HIT = ABORT (D4): a single-timestamp watermark cannot be both
        # duplicate-free AND a resumable partial-traversal cursor, so we refuse
        # the impossible middle — no delivery, watermark UNCHANGED, visible
        # volume-cap degradation warning; the next run retries the same window.
        manifest["status"] = "failed"
        manifest["error"] = ("volume cap hit — window not fully fetched within "
                             f"MAX_FETCH_PAGES={MAX_FETCH_PAGES}; not delivered")
        manifest["fetch_cap_hit"] = True
        maybe_suggest_incident(date_iso, manifest)
        save_manifest(date_iso, manifest)
        log(f"{date_iso}: ⚠️ {manifest['error']} — watermark left unchanged, will retry")
        return 1

    if not candidates:
        # EMPTY WINDOW (D4): nothing newer than the watermark — the natural,
        # honest weekend/quiet signal. One short Telegram message; watermark
        # UNCHANGED so a late-appearing batch is picked up by the next run.
        return _deliver_no_new_papers(date_iso, manifest)

    window_max = max(paper_submitted(p) for p in candidates)
    manifest["window_max_submitted"] = window_max.isoformat()

    selected, runner_ups, relevant = select_papers(candidates, max_papers)
    attach_analysis_text(selected)
    for p in selected:
        p["summary_loc"] = build_summary(p)
    manifest.update({
        "status": "selected",
        "arxiv_fetched": len(candidates),
        "arxiv_relevant": relevant,
        "selected_papers": [
            {k: p[k] for k in ("id", "title", "authors", "link", "abstract",
                               "published", "primary_category", "scores",
                               "reason", "summary_loc", "_groups",
                               "analysis_source", "analysis_chars",
                               "analysis_truncated", "analysis_error")}
            for p in selected
        ],
        "runner_ups": runner_ups,
        "error": None,
    })
    save_manifest(date_iso, manifest)
    atomic_write(snapshot_path(date_iso),
                 render_snapshot(date_iso, selected, runner_ups, len(candidates), relevant))

    # D1 pluggable translate/analysis executor chain (offline) — independent of
    # the Grok social call below; a translate failure degrades only translation
    # (fallback_en / unavailable), never the social signal.
    t_status, t_agent, t_attempts, t_raw = translate_check(date_iso, selected)
    manifest["translate_check"] = t_status
    manifest["translate_agent"] = t_agent
    manifest["translate_attempts"] = t_attempts
    # D5: on != ok, one deduped grep-canonical line to ~/knowledge/log.md.
    emit_translate_degradation(date_iso, t_status, t_attempts)

    # Optional Grok X/Reddit social — independent of the translation above.
    # Default scheduled runs skip it because the current machine has no Grok
    # subscription/credits; explicit `social_check: grok` keeps the old path.
    if current_social_enabled:
        status, grok_rc, stderr_tail, raw = social_check(date_iso, selected)
    else:
        status, grok_rc, stderr_tail, raw = "skipped", None, "", ""
    manifest["social_check"] = status
    manifest["grok_rc"] = grok_rc
    manifest["grok_stderr_tail"] = stderr_tail

    for m_p, p in zip(manifest["selected_papers"], selected):
        if should_render_social(status):
            m_p["social"] = p.get("social", {})
        for k in ("title_loc", "abstract_loc", "abstract_source",
                  "studied_loc", "method_loc", "found_loc", "why_selected_loc",
                  "summary_source", "terms"):
            if k in p:
                m_p[k] = p[k]
        # Rebuild now that the localized translation (or its absence) is known.
        p["summary_loc"] = build_summary(p)
        m_p["summary_loc"] = p["summary_loc"]
    save_manifest(date_iso, manifest)
    atomic_write(translation_path(date_iso),
                 render_translation_source(date_iso, selected, t_status, t_agent, t_attempts, t_raw))
    if should_render_social(status):
        atomic_write(social_path(date_iso),
                     render_social_source(date_iso, selected, status, grok_rc, stderr_tail, raw))

    atomic_write(report_path(date_iso),
                 render_report(date_iso, selected, runner_ups, status, relevant,
                               fetched=len(candidates), translate_status=t_status))
    manifest["status"] = "report_written"
    save_manifest(date_iso, manifest)

    # Fresh pipeline pass: stored per-message bookkeeping from an earlier
    # attempt belongs to content that was just regenerated — drop it so the
    # new messages are rebuilt (delivery-only retries go through the stage
    # cache above and keep it).
    manifest.pop("messages", None)
    manifest.pop("messages_delivered", None)
    try:
        messages = render_messages(date_iso, selected, relevant, max_papers,
                                   fetched=len(candidates), social_status=status,
                                   translate_status=t_status)
    except RenderOversize as exc:
        return _render_failed(date_iso, manifest, exc)
    rc = deliver_messages(date_iso, messages, manifest)
    if rc == 0:
        # D4: advance the watermark ONLY on a delivered digest from a fully
        # fetched window, to the newest submittedDate in it (forward-only CAS).
        _advance_watermark_on_delivery(date_iso, manifest)
    return rc


def main() -> int:
    parser = argparse.ArgumentParser(
        description="arXiv-only scheduled learning digest (3 papers, user-language, optional Grok social check)."
    )
    parser.add_argument("--date", default=today_iso(), help="Date in YYYY-MM-DD.")
    parser.add_argument("--text-only", action="store_true",
                        help="Text digest mode (default and only mode in v1; flag kept for the process contract).")
    parser.add_argument("--force", action="store_true", help="Redo everything for the date, resend digest.")
    parser.add_argument("--dry-run", action="store_true", help="Print intent, no network/disk/sends.")
    args = parser.parse_args()

    if not re.fullmatch(r"\d{4}-\d{2}-\d{2}", args.date):
        print(f"invalid --date: {args.date}", file=sys.stderr)
        return 2
    return run(args.date, force=args.force, dry_run=args.dry_run)


if __name__ == "__main__":
    sys.exit(main())
