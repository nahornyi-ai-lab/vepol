    "this", "that", "with", "from", "into", "over", "under", "between",
    "their", "these", "those", "which", "while", "where", "when", "what",
    "based", "using", "such", "than", "then", "them", "they", "have",
    "been", "more", "most", "also", "show", "shows", "paper", "study",
    "propose", "present", "approach", "method", "methods", "model",
    "models", "results", "result", "novel", "framework",
}

