#!/usr/bin/env python3
"""Runs every 15 minutes via launchd. Fires every background process declared
in personal/processes.yaml (five required fields: id, enabled, when, run,
outputs, plus an optional per-process `timeout`) when its trigger arrives, and
marks per-day fired state in today-plan.json so each process runs once per day.
Each process's subprocess is capped by its declared `timeout` when set, else by
the uniform PROCESS_TIMEOUT default. Self-heals: if the plan is missing or stale
(not for today), regenerates it by invoking kb-planner; if processes.yaml is
missing, writes safe release defaults; if it is invalid, fails closed and
runs nothing.

Contract: processes release 2026-06-09 (five required fields) + optional
per-process `timeout` (D12, morning-digest-inputs-rebalance-spec-2026-07-11).
NotebookLM is reached only by the processes that declare it: the default
schedule's morning-digest and evening-digest send their digests to NotebookLM
(`outputs: [file, notebooklm_audio]`); kb-digest-migrate switches them to local
audio. Every other background process stays off NotebookLM.

after:<parent> waits for the parent's success that day. A disabled parent that
is an optional input (_kb_processes.OPTIONAL_INPUT_PARENTS: mail-morning,
mail-evening, learning, money-radar) is treated as satisfied: the child
follows the parent's own trigger instead (walking up the chain), so switching
off e.g. mail-morning does not silently stop the brief and everything after
it. Any other disabled parent keeps its children waiting, as before (e.g.
with retro disabled, evening-digest, which needs the Retro block, does not
run).

Each child gets KB_PROCESS_ID, KB_PROCESS_OUTPUTS, KB_PROCESS_BACKGROUND=1 and
KB_PROCESS_TIMEOUT (its cap in seconds) in the environment.
"""
from __future__ import annotations

import datetime
import json
import os
import pathlib
import shlex
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from _kb_processes import (  # noqa: E402
    OPTIONAL_INPUT_PARENTS,
    ProcessConfigError,
    load_processes,
)

HUB = pathlib.Path(os.environ.get("KB_HUB", os.path.expanduser("~/knowledge")))
PLAN = HUB / "logs" / "today-plan.json"
LOG = HUB / "logs" / "planner.log"
PROCESSES = HUB / "personal" / "processes.yaml"

# Per-day fired-state keys in today-plan.json. The first three predate
# processes.yaml and are kept for compatibility (kb-orchestrator-cycle
# still sets retro_fired directly).
LEGACY_FIRED_KEYS = {
    "daily": "brief_fired",
    "retro": "retro_fired",
    "learning": "daily_research_fired",
}

# Uniform per-process subprocess cap; a process may override it with its own
# `timeout` field in processes.yaml (D12). Kept as the default for any process
# that does not declare one.
PROCESS_TIMEOUT = 1800


def fired_key(process_id: str) -> str:
    return LEGACY_FIRED_KEYS.get(process_id, process_id.replace("-", "_") + "_fired")


def log(msg: str) -> None:
    stamp = datetime.datetime.now().isoformat(timespec="seconds")
    LOG.parent.mkdir(parents=True, exist_ok=True)
    with LOG.open("a") as f:
        f.write(f"[{stamp}] tick: {msg}\n")


def load_plan() -> dict | None:
    if not PLAN.exists():
        return None
    try:
        return json.loads(PLAN.read_text())
    except Exception as e:
        log(f"plan parse error: {e}")
        return None


def save_plan(plan: dict) -> None:
    PLAN.write_text(json.dumps(plan, indent=2))


def regenerate_plan() -> dict | None:
    log("regenerating plan via kb-planner")
    subprocess.run([str(HUB / "bin" / "kb-planner")], check=False)
    return load_plan()


def channel_instances_guard() -> None:
    """Incident-2026-04-25: every tick (15 min), check telegram channel
    plugin instance count. If duplicates accumulated, run cleanup. If
    channel is down, append escalation. Wrapped in try/except so a flap
    here doesn't break process firing."""
    try:
        proc = subprocess.run(
            [str(HUB / "bin" / "kb-doctor"), "channel-instances", "--format", "json"],
            capture_output=True, text=True, timeout=15,
        )
        data = json.loads(proc.stdout) if proc.stdout.strip() else {}
        findings = data.get("findings", [])
        for f in findings:
            kind = f.get("kind", "")
            sev = f.get("severity", "")
            if kind == "channel-instances:duplicate" and sev == "P1":
                log(f"channel-instances:duplicate detected — running cleanup")
                subprocess.run(
                    [str(HUB / "bin" / "kb-codex-cleanup")],
                    capture_output=True, timeout=30,
                )
            elif kind == "channel-instances:down" and sev == "P0":
                log(f"channel-instances:down detected — re-bootstrapping LaunchAgent")
                plist = pathlib.Path.home() / "Library" / "LaunchAgents" / "com.knowledge.channel-telegram.plist"
                if plist.is_file():
                    subprocess.run(
                        ["launchctl", "bootstrap", f"gui/{os.getuid()}", str(plist)],
                        capture_output=True, timeout=10,
                    )
    except Exception as exc:
        log(f"channel-instances guard error (non-fatal): {exc!r}")


def resolve_command(process_id: str, run: str) -> list[str] | None:
    """shlex-split `run`; resolve a bare command name strictly against
    $HUB/bin. No PATH fallback: a fixture/foreign hub must never end up
    executing a same-named binary from elsewhere (real sends, real quota).
    Paths containing '/' are expanded (~) and used as-is."""
    try:
        argv = shlex.split(run)
    except ValueError as exc:
        log(f"{process_id}: cannot parse run command: {exc}")
        return None
    if not argv:
        log(f"{process_id}: empty run command")
        return None
    # shlex does not do shell expansion: expand a leading ~ in every token,
    # or hub-relative arguments like `--hub ~/knowledge` reach the child
    # literally and resolve against launchd's cwd (incident 2026-06-10).
    argv = [os.path.expanduser(tok) for tok in argv]
    head = argv[0]
    if "/" in head:
        return argv
    candidate = HUB / "bin" / head
    if candidate.is_file():
        argv[0] = str(candidate)
        return argv
    log(f"{process_id}: command {head!r} not found in {HUB / 'bin'}; treated as failed")
    return None


def eligible(proc: dict, snapshot: dict, now_hm: str,
             by_id: dict | None = None) -> bool:
    """Trigger semantics. after:* is evaluated against the fired-state
    snapshot taken at tick start, so a dependent becomes eligible on the
    next tick after its parent succeeded for the same day — never within
    the same tick pass as the parent.

    A disabled parent never fires. When it is an optional input
    (OPTIONAL_INPUT_PARENTS, where the rule and its reasons live), it counts
    as satisfied: the child follows the parent's own trigger (an HH:MM time,
    on-demand, or the parent's own after:, walking up the chain). Any other
    disabled parent keeps the child waiting, as before (the walk stops
    there). An enabled parent keeps the usual rule. A parent that
    is not declared at all cannot be followed and keeps the child waiting
    (_kb_processes already rejects such a config)."""
    when = proc["when"]
    by_id = by_id or {}
    seen = {proc["id"]}
    while when.startswith("after:"):
        parent_id = when[len("after:"):]
        parent = by_id.get(parent_id)
        if (parent is None or parent["enabled"] or parent_id in seen
                or parent_id not in OPTIONAL_INPUT_PARENTS):
            return snapshot.get(fired_key(parent_id)) is True
        seen.add(parent_id)
        when = parent["when"]
    if when == "on-demand":
        return False
    return now_hm >= when


def run_process(proc: dict, plan: dict) -> None:
    pid = proc["id"]
    key = fired_key(pid)

    # `daily` runs only its declared command (kb-brief). The historical
    # hidden arXiv prefetch was removed: arXiv ownership lives in the
    # `learning` process (learning-arxiv spec 2026-06-12).
    cmd = resolve_command(pid, proc["run"])
    if cmd is None:
        return

    # Per-process cap when declared (validated positive-bounded int by
    # _kb_processes), else the uniform default. The child sees it as
    # KB_PROCESS_TIMEOUT so it can finish inside it (kb-brief's health wait).
    timeout = proc.get("timeout") or PROCESS_TIMEOUT

    env = dict(os.environ)
    env["KB_PROCESS_ID"] = pid
    env["KB_PROCESS_OUTPUTS"] = ",".join(proc["outputs"])
    env["KB_PROCESS_BACKGROUND"] = "1"
    env["KB_PROCESS_TIMEOUT"] = str(timeout)

    # Blocking call; fired is only set on rc==0 so a crash or a failed
    # required output retries on the next tick instead of being swallowed
    # (Incident-2026-05-05). launchd's StartInterval=900 re-fires only
    # after the previous instance exits, so blocking shifts the next tick
    # rather than stacking instances.
    log(f"firing {pid}: {' '.join(cmd)} (timeout={timeout}s)")
    try:
        proc_run = subprocess.run(
            cmd,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=timeout,
            env=env,
            check=False,
        )
    except Exception as e:
        log(f"{pid} failed: {e!r}; {key} NOT set; will retry next tick")
        return
    if proc_run.returncode == 0:
        plan[key] = True
        save_plan(plan)
        log(f"{pid} completed rc=0; {key} set")
    else:
        log(f"{pid} rc={proc_run.returncode}, {key} NOT set; will retry next tick")


def main() -> None:
    today = datetime.date.today().isoformat()
    now_hm = datetime.datetime.now().strftime("%H:%M")

    # Incident-2026-04-25: telegram channel instance guard runs every tick.
    channel_instances_guard()

    plan = load_plan()
    if plan is None or plan.get("date") != today:
        plan = regenerate_plan()
        if plan is not None and plan.get("date") != today:
            # kb-planner failed and left yesterday's plan, whose fired flags
            # would block every process today. Start an empty plan for today:
            # brief and retro check their own delivery evidence in the day
            # file, so a delivered one is never sent twice.
            log(f"plan is still for {plan.get('date')!r} after regen; "
                f"starting an empty plan for {today}")
            plan = {"date": today}
            save_plan(plan)
        if plan is None:
            log("plan still missing after regen, abort")
            return

    try:
        processes = load_processes(PROCESSES, create_default=True)
    except (ProcessConfigError, OSError) as exc:
        log(f"processes.yaml invalid: {exc}; fail closed — no processes run this tick")
        return

    snapshot = dict(plan)
    by_id = {proc["id"]: proc for proc in processes}
    for proc in processes:
        if not proc["enabled"]:
            continue
        if plan.get(fired_key(proc["id"])):
            continue
        if not eligible(proc, snapshot, now_hm, by_id):
            continue
        run_process(proc, plan)


if __name__ == "__main__":
    main()
