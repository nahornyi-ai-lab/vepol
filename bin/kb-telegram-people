#!/usr/bin/env python3
"""kb-telegram-people — collect WHO wrote in Telegram into a daily
identity envelope for the People Notebook.

Owner directive 2026-07-12: the multibot supervisor is deprecated;
Telegram is read directly with the owner's credentials. This collector
connects READ-ONLY with its own dedicated session, walks dialogs whose
last activity falls inside the collection window, and aggregates sender
identities — name, username, user_id, phone (when visible), chat type,
message count. It never stores message text, and the envelope schema
(`telegram-people/v1`, validated by
`_kb_people.sources.telegram_source`) has no field that could carry it.

Output: `<hub>/personal/telegram/people/<YYYY-MM-DD>-daily.json` (0600,
atomic). personal/ is gitignored and never synced. Consumption is
staged-only in kb-extract-people — nothing here writes people cards.

Session: `<hub>/personal/telegram/.people-collector.session`. If
missing, it is bootstrapped as a consistent SQLite snapshot of the
already-authorized supervisor session (legacy but authorized), or
interactively via --login on machines without one. The collector never
shares a live session file with another process.

Credentials: TG_API_ID / TG_API_HASH from the environment, else from
the env file at $KB_TG_ENV_FILE (default ~/.orchestrator/multibot.env).

Failure model (mirrors mail): any failure writes an available:false
envelope for the day (unless a good one already exists) and exits
non-zero so kb-tick retries — degradation is visible, never silent.
"""
from __future__ import annotations

import argparse
import json
import os
import re
import sqlite3
import sys
import tempfile
from datetime import datetime, timedelta, timezone
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from _kb_people.sources import telegram_source as ts  # noqa: E402

DEFAULT_ENV_FILE = Path.home() / ".orchestrator" / "multibot.env"
LEGACY_SESSION = Path.home() / ".orchestrator" / "multibot-supervisor.session"

FIRST_RUN_LOOKBACK_HOURS = 48
_TS_FMT = "%Y-%m-%dT%H:%M:%SZ"


def _say(msg: str, quiet: bool) -> None:
    if not quiet:
        print(f"kb-telegram-people: {msg}")


def _warn(msg: str) -> None:
    print(f"kb-telegram-people: {msg}", file=sys.stderr)


# ---------------------------------------------------------------------------
# Credentials + session.
# ---------------------------------------------------------------------------

def _load_env_file(path: Path) -> dict:
    out: dict[str, str] = {}
    try:
        for raw in path.read_text(encoding="utf-8").splitlines():
            line = raw.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            k, v = line.split("=", 1)
            out[k.strip()] = v.strip().strip('"').strip("'")
    except OSError:
        pass
    return out


def _credentials() -> tuple[int, str] | None:
    api_id = os.environ.get("TG_API_ID", "").strip()
    api_hash = os.environ.get("TG_API_HASH", "").strip()
    if not (api_id and api_hash):
        env_file = Path(os.environ.get("KB_TG_ENV_FILE", str(DEFAULT_ENV_FILE)))
        data = _load_env_file(env_file)
        api_id = api_id or data.get("TG_API_ID", "")
        api_hash = api_hash or data.get("TG_API_HASH", "")
    if not (api_id.isdigit() and api_hash):
        return None
    return int(api_id), api_hash


def session_path(hub: Path) -> Path:
    return hub / "personal" / "telegram" / ".people-collector.session"


def _acquire_collector_lock(hub: Path):
    """Non-blocking exclusive flock held for the whole collector run.

    Envelope read/merge/write and watermark advancement must be one
    critical section per hub: two concurrent collectors could interleave
    (one advances the cursor, the other overwrites the envelope with a
    partial result — stranding the first run's senders behind the
    cursor), and the _fail path could clobber a freshly written good
    envelope. Returns an open fd (caller closes at exit — closing
    releases the flock) or None on contention; contention means another
    run is live, so the caller must exit WITHOUT writing anything.
    """
    path = hub / "personal" / "telegram" / ".people-collector.lock"
    path.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT, 0o600)
    try:
        import fcntl
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        os.close(fd)
        return None
    return fd


def _ensure_session_security(sess: Path) -> None:
    """Secure the session file and its directory BEFORE any client work.

    Telethon/SQLite creates a missing session file under the process
    umask (typically 0644) — that would expose the Telegram auth key to
    other local users after a fresh --login. Pre-create the file 0600
    and pin the directory to 0700; SQLite happily initializes an empty
    pre-created file."""
    sess.parent.mkdir(parents=True, exist_ok=True)
    os.chmod(sess.parent, 0o700)
    if not sess.exists():
        sess.touch()
    os.chmod(sess, 0o600)


def _bootstrap_session(dest: Path, quiet: bool) -> bool:
    """Snapshot-clone the authorized legacy session into `dest`.

    sqlite3 backup API gives a consistent copy even while the legacy
    process holds the file. Both copies share one Telegram auth key —
    fine for parallel request/response use; the files themselves are
    never shared between processes.
    """
    src = Path(os.environ.get("KB_TG_BOOTSTRAP_SESSION", str(LEGACY_SESSION)))
    if not src.exists():
        return False
    dest.parent.mkdir(parents=True, exist_ok=True)
    try:
        with sqlite3.connect(f"file:{src}?mode=ro", uri=True) as s, \
                sqlite3.connect(dest) as d:
            s.backup(d)
        os.chmod(dest, 0o600)
    except sqlite3.Error as e:
        _warn(f"session bootstrap failed: {e}")
        return False
    _say(f"session bootstrapped from {src}", quiet)
    return True


# ---------------------------------------------------------------------------
# Collection window watermark.
# ---------------------------------------------------------------------------

def watermark_path(hub: Path) -> Path:
    return hub / "personal" / "telegram" / ".people-collector-watermark.json"


def read_since(hub: Path, now: datetime) -> datetime:
    last = _raw_watermark(hub)
    if last is not None and last < now:
        return last
    return now - timedelta(hours=FIRST_RUN_LOOKBACK_HOURS)


def _raw_watermark(hub: Path) -> datetime | None:
    try:
        data = json.loads(watermark_path(hub).read_text(encoding="utf-8"))
        return datetime.strptime(data["last_run_utc"], _TS_FMT).replace(
            tzinfo=timezone.utc)
    except Exception:
        return None


def advance_watermark(hub: Path, when: datetime) -> None:
    """Move the collection cursor forward. Never regress: a truncated
    run's covered-boundary could be older than an existing watermark
    after an out-of-order retry, and the cursor must be monotonic."""
    cur = _raw_watermark(hub)
    target = when if cur is None else max(cur, when)
    ts._atomic_write_json(watermark_path(hub), {
        "schema_version": 1,
        "last_run_utc": target.strftime(_TS_FMT),
    })


# ---------------------------------------------------------------------------
# Envelope IO.
# ---------------------------------------------------------------------------

def _write_envelope(hub: Path, env: dict) -> Path:
    d = ts.envelopes_dir(hub)
    d.mkdir(parents=True, exist_ok=True)
    path = d / f"{ts.envelope_key(env)}.json"
    fd, tmp = tempfile.mkstemp(dir=str(d), prefix=".tmp-", suffix=".json")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(env, f, indent=2, ensure_ascii=False)
        os.chmod(tmp, 0o600)
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)
    return path


def _unavailable_envelope(day: str, now: datetime) -> dict:
    return {
        "schema": ts.SCHEMA, "date": day, "period": "daily",
        "generated_at": now.strftime(_TS_FMT),
        "available": False, "truncated": False, "senders": [],
    }


def _good_envelope_exists(hub: Path, day: str) -> bool:
    p = ts.envelopes_dir(hub) / f"{day}-daily.json"
    try:
        env = json.loads(p.read_text(encoding="utf-8"))
    except Exception:
        return False
    return ts.validate_envelope(env) and env.get("available") is True


def _merge_senders(old: list, new: list) -> list:
    """Union two sender lists by user_id (UNCAPPED). Prefer non-empty
    identity fields, keep the max count (windows may overlap — counts
    are display-only), widen the ts span. The caller partitions the
    union to the envelope cap."""
    by_id = {s["user_id"]: dict(s) for s in old}
    for s in new:
        cur = by_id.get(s["user_id"])
        if cur is None:
            by_id[s["user_id"]] = dict(s)
            continue
        for k in ("name", "username", "phone"):
            if not cur.get(k) and s.get(k):
                cur[k] = s[k]
        cur["count"] = max(cur.get("count", 1), s.get("count", 1))
        cur["first_ts"] = min(cur.get("first_ts", ""), s.get("first_ts", "")) or s.get("first_ts", "")
        cur["last_ts"] = max(cur.get("last_ts", ""), s.get("last_ts", ""))
    return list(by_id.values())


def _by_count(senders: list) -> list:
    return sorted(senders, key=lambda s: (-s["count"], s["user_id"]))


def _partition_by_time(senders: list, cap: int) -> tuple[list, datetime | None]:
    """When more senders than fit the envelope cap are covered in ONE
    complete window, keep the OLDEST `cap` by activity and DEFER the
    newest to the next run — never drop them. Returns
    (kept_display_order, boundary) where `boundary` is the newest
    activity among the kept set: advancing the watermark to it re-covers
    every deferred (strictly-newer) sender next run, so nobody is lost.

    Returns (senders_by_count[:cap], None) in the pathological case where
    more than `cap` senders share the single newest kept second — then a
    time split can't make progress, so the caller holds the cursor and
    re-covers.
    """
    s = sorted(senders, key=lambda x: (x["last_ts"], x["user_id"]))
    split_ts = s[cap - 1]["last_ts"]   # newest of the first `cap`
    next_ts = s[cap]["last_ts"]        # oldest deferred (len > cap guaranteed)
    if split_ts < next_ts:
        # Clean split between distinct seconds — keep exactly `cap`; the
        # watermark sits at the newest kept and every deferred sender is
        # strictly newer, so all re-cover next run.
        kept = s[:cap]
        boundary_str = split_ts
    else:
        # The cap boundary falls inside a same-second group; keeping only
        # part of it would strand the rest behind an equal watermark. Defer
        # the WHOLE tied second: keep everyone strictly older.
        kept = [x for x in s if x["last_ts"] < split_ts]
        if not kept:
            return _by_count(senders)[:cap], None  # all share one second
        boundary_str = kept[-1]["last_ts"]
    boundary = datetime.strptime(boundary_str, _TS_FMT).replace(
        tzinfo=timezone.utc)
    return _by_count(kept), boundary


def finalize_run(hub: Path, day: str, senders: list, complete: bool,
                 now: datetime) -> Path | None:
    """Persist a collection result and move the watermark — the single
    place that owns merge, cap, and cursor so they can never disagree.

    - Merge with an existing UNPROCESSED same-day envelope first (a
      same-day retry must never overwrite identities the extractor has
      not consumed yet). The union is uncapped here.
    - If the traversal was INCOMPLETE (`complete=False`: a FloodWait or a
      runaway guard): write a best-effort bounded envelope and HOLD the
      cursor — the whole window is re-covered next run, so nothing is
      lost.
    - If the union exceeds the envelope cap on a COMPLETE window: keep the
      OLDEST `cap` by activity and advance the cursor to their newest
      timestamp; the deferred (newer) senders are re-covered next run.
      This drains the backlog without ever dropping a person (the old
      "keep top-N by count, hold" path permanently lost the marginal
      one-off contacts under a stuck watermark).
    - Otherwise advance to `now - 1s`.
    """
    path = ts.envelopes_dir(hub) / f"{day}-daily.json"
    prev_rows: list = []
    try:
        prev = json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        prev = None
    if (prev is not None and ts.validate_envelope(prev)
            and prev.get("senders")):
        consumed = (ts.read_processed(hub).get("processed", {})
                    .get(ts.envelope_key(prev)) == ts.file_sha256(path))
        if not consumed:
            prev_rows = prev["senders"]
            senders = _merge_senders(prev_rows, senders)
            complete = complete and not prev.get("truncated")

    advance: datetime | None
    if not complete:
        # Behind-cursor rows are SACRED here: merged-in prev senders may
        # sit at/behind the already-advanced cursor, so this envelope is
        # the only place they exist — a count-based eviction would lose
        # them permanently even under HOLD (R6 counterexample). prev fits
        # the cap by validator construction; fill the remainder with this
        # run's senders by count — any squeezed out are after the held
        # cursor and re-cover next run.
        prev_ids = {s["user_id"] for s in prev_rows}
        protected = [s for s in senders if s["user_id"] in prev_ids]
        fresh = _by_count([s for s in senders if s["user_id"] not in prev_ids])
        room = max(0, _MAX_SENDERS - len(protected))
        write_senders = _by_count(protected + fresh[:room])
        truncated, advance = True, None
    elif len(senders) > _MAX_SENDERS:
        write_senders, boundary = _partition_by_time(senders, _MAX_SENDERS)
        truncated = True
        advance = boundary  # None only in the all-same-second pathological case
    else:
        write_senders = _by_count(senders)
        truncated, advance = False, now - timedelta(seconds=_WATERMARK_BACK_S)

    env = {
        "schema": ts.SCHEMA, "date": day, "period": "daily",
        "generated_at": now.strftime(_TS_FMT),
        "available": True, "truncated": bool(truncated),
        "senders": write_senders,
    }
    if not ts.validate_envelope(env):
        _warn("built an envelope that fails its own validator — "
              "refusing to write senders")
        return None
    out = _write_envelope(hub, env)
    if advance is None:
        _warn("window incomplete — watermark HELD; the next run re-covers "
              "the whole window")
    else:
        advance_watermark(hub, advance)
        if truncated:
            _warn("window over the sender cap — kept the oldest, advanced "
                  "the cursor to their boundary; the newest resume next run")
    return out


def _fail(hub: Path, day: str, now: datetime, reason: str) -> int:
    _warn(reason)
    if not _good_envelope_exists(hub, day):
        env = _unavailable_envelope(day, now)
        if ts.validate_envelope(env):
            _write_envelope(hub, env)
    return 1


# ---------------------------------------------------------------------------
# Collection.
# ---------------------------------------------------------------------------

_PHONE_CLEAN_RE = re.compile(r"[^0-9 +()-]")


def _sender_row(user, first_ts: str, last_ts: str, count: int,
                chat_type: str) -> dict:
    name = " ".join(x for x in [(user.first_name or "").strip(),
                                (user.last_name or "").strip()] if x)
    username = (user.username or "").strip().lower()
    phone = _PHONE_CLEAN_RE.sub("", (user.phone or "").strip())
    if phone and not phone.startswith("+"):
        phone = "+" + phone
    return {
        "name": name[:200],
        "username": username,
        "user_id": int(user.id),
        "phone": phone[:32],
        "chat_type": chat_type,
        "first_ts": first_ts,
        "last_ts": last_ts,
        "count": count,
    }


_MAX_SENDERS = 500
# Watermark overlap: advance the cursor 1s before `now` so a message
# arriving in the same (second-granularity) instant we read the window
# is re-covered next run rather than falling into the `<= since` gap.
# The re-cover is idempotent (staged/live dedup).
_WATERMARK_BACK_S = 1


def collect(client, me_id: int, since: datetime, now: datetime, *,
            include_groups: bool, scan_max: int, msg_guard: int,
            quiet: bool) -> tuple[list[dict], bool]:
    """Aggregate human senders since `since`. Returns
    (senders, complete) — the FULL uncapped sender set for the covered
    window, and whether the traversal was complete (True) or cut short
    by a FloodWait / runaway guard (False). The cap, merge, and cursor
    are owned by `finalize_run`.

    Completeness by construction, not by a cursor trick: `iter_dialogs`
    yields PINNED dialogs first, then the rest strictly newest-first. A
    pinned dialog with in-window activity (date > since) is COVERED like
    any other; a stale pinned dialog is skipped WITHOUT ending the scan
    (its top-of-list position is not an age signal); the scan STOPS at
    the first non-pinned dialog older than `since`. Every dialog with
    activity in the window is therefore visited, with no fixed dialog cap
    to silently exclude the tail. Each eligible dialog's messages are
    walked newest-first and stopped at `since`, with no message cap in
    the normal path.

    Truncation is a LOUD, rare signal (a FloodWait, or a runaway guard
    hit), NOT a silent partial cover: on truncation we return
    next_watermark=None so `finalize_run` HOLDS the cursor and the whole
    window is re-covered next run — cheap for a daily window, and it can
    never skip a person. A clean run advances to `now - 1s`.

    Only identities are read; message objects are consulted for
    sender/date and discarded.
    """
    from telethon.errors import FloodWaitError
    from telethon.tl.types import User

    eligible = []  # (entity, chat_type)
    truncated = False
    scanned = 0
    try:
        for dialog in client.iter_dialogs():
            scanned += 1
            if scanned > scan_max:
                # Pure runaway backstop — should never fire for a daily
                # window. If it does, hold the cursor and re-cover.
                _warn(f"dialog scan exceeded {scan_max} — holding cursor")
                truncated = True
                break
            pinned = getattr(dialog, "pinned", False)
            act = dialog.date.astimezone(timezone.utc) if dialog.date else None
            if act is None or act <= since:
                # No in-window activity. A pinned dialog floats to the top
                # regardless of age, so an old pinned one is NOT the end of
                # the window — skip it but keep scanning. A non-pinned old
                # dialog IS the boundary: the rest are older → stop.
                if pinned:
                    continue
                break
            # act > since: this dialog HAS in-window activity — cover it,
            # pinned or not (dialog.date is the last-message time, so a
            # pinned dialog with a fresh incoming message has act > since
            # and must be walked, not dropped).
            entity = dialog.entity
            if isinstance(entity, User):
                if entity.bot or entity.is_self or entity.deleted:
                    continue
                chat_type = "private"
            elif include_groups and dialog.is_group:
                chat_type = "group"
            else:
                continue
            eligible.append((entity, chat_type))
    except FloodWaitError as e:
        _warn(f"flood-wait ({e.seconds}s) during dialog scan — holding cursor")
        truncated = True

    agg: dict[int, dict] = {}
    try:
        for entity, chat_type in eligible:
            seen = 0
            for m in client.iter_messages(entity):
                mdt = m.date.astimezone(timezone.utc) if m.date else None
                if mdt is None or mdt <= since:
                    break
                seen += 1
                if seen > msg_guard:
                    # Runaway guard: a single dialog with more than
                    # msg_guard messages in one window. Do NOT mark this
                    # dialog covered — hold the cursor so the older
                    # messages (which may include the only human sender,
                    # e.g. behind a burst of outgoing) are re-covered.
                    _warn("per-dialog message guard hit — holding cursor")
                    truncated = True
                    break
                if m.out:
                    continue  # our own message
                sender = entity if chat_type == "private" else m.sender
                if not isinstance(sender, User):
                    continue
                if sender.bot or sender.is_self or sender.deleted:
                    continue
                if int(sender.id) == me_id:
                    continue
                ts_str = mdt.strftime(_TS_FMT)
                row = agg.get(sender.id)
                if row is None:
                    agg[sender.id] = {
                        "user": sender, "first_ts": ts_str,
                        "last_ts": ts_str, "count": 1,
                        "chat_type": chat_type,
                    }
                else:
                    row["count"] += 1
                    row["first_ts"] = ts_str  # walking newest→oldest
    except FloodWaitError as e:
        _warn(f"flood-wait ({e.seconds}s) during message walk — holding cursor")
        truncated = True

    senders = [
        _sender_row(r["user"], r["first_ts"], r["last_ts"], r["count"],
                    r["chat_type"])
        for r in agg.values()
    ]
    senders.sort(key=lambda s: (-s["count"], s["user_id"]))
    complete = not truncated
    _say(f"eligible={len(eligible)} senders={len(senders)} "
         f"complete={complete}", quiet)
    return senders, complete


# ---------------------------------------------------------------------------
# Main.
# ---------------------------------------------------------------------------

def main() -> int:
    ap = argparse.ArgumentParser(
        description="Collect Telegram sender identities (never message "
                    "text) into a daily people envelope.")
    ap.add_argument("--hub", required=True)
    ap.add_argument("--quiet", action="store_true")
    ap.add_argument("--date", default="",
                    help="envelope date (default: today UTC)")
    ap.add_argument("--include-groups", action="store_true",
                    help="also collect group-chat senders (default: "
                         "private dialogs only)")
    ap.add_argument("--login", action="store_true",
                    help="interactive first-time login for the dedicated "
                         "session (asks for a code in the terminal)")
    ap.add_argument("--scan-max", type=int, default=5000,
                    help="runaway backstop on total dialogs scanned "
                         "(the scan stops naturally at the watermark)")
    ap.add_argument("--msg-guard", type=int, default=5000,
                    help="runaway backstop on messages walked per dialog "
                         "(the walk stops naturally at the watermark)")
    args = ap.parse_args()

    hub = Path(args.hub).expanduser().resolve()
    now = datetime.now(timezone.utc)
    day = args.date or now.strftime("%Y-%m-%d")
    if not re.match(r"^\d{4}-\d{2}-\d{2}$", day):
        _warn(f"bad --date {day!r}")
        return 2

    # One collector per hub, for the WHOLE run (incl. the _fail writes) —
    # see _acquire_collector_lock. On contention exit 2 without touching
    # the envelope or watermark; kb-tick retries next tick.
    lock_fd = _acquire_collector_lock(hub)
    if lock_fd is None:
        _warn("another kb-telegram-people run is live — exiting (lock)")
        return 2

    creds = _credentials()
    if creds is None:
        return _fail(hub, day, now,
                     "no TG_API_ID/TG_API_HASH (env or env-file) — "
                     "telegram people collection unavailable")
    api_id, api_hash = creds

    sess = session_path(hub)
    # A 0-byte file is a pre-created security placeholder from an aborted
    # --login, not an authorized session — still eligible for bootstrap.
    sess_missing = (not sess.exists()) or sess.stat().st_size == 0
    if sess_missing and not args.login:
        if not _bootstrap_session(sess, args.quiet):
            return _fail(hub, day, now,
                         "no collector session and no bootstrap source; "
                         "run `kb-telegram-people --login` once")

    try:
        from telethon.sync import TelegramClient
    except ImportError:
        return _fail(hub, day, now,
                     "telethon is not installed — "
                     "pip install telethon to enable telegram people")

    since = read_since(hub, now)
    _say(f"window since {since.strftime(_TS_FMT)}", args.quiet)

    try:
        _ensure_session_security(sess)
        with TelegramClient(str(sess), api_id, api_hash,
                            receive_updates=False) as client:
            if args.login:
                pass  # TelegramClient.__enter__ ran the interactive start()
            if not client.is_user_authorized():
                return _fail(hub, day, now,
                             "collector session is not authorized; run "
                             "`kb-telegram-people --login` once")
            me = client.get_me()
            senders, complete = collect(
                client, int(me.id), since, now,
                include_groups=args.include_groups,
                scan_max=args.scan_max,
                msg_guard=args.msg_guard,
                quiet=args.quiet)
    except Exception as e:
        return _fail(hub, day, now, f"telegram collection failed: {e}")

    path = finalize_run(hub, day, senders, complete, now)
    if path is None:
        return _fail(hub, day, now,
                     "envelope failed validation — nothing written")
    _say(f"envelope written: {path}", args.quiet)
    return 0


if __name__ == "__main__":
    sys.exit(main())
