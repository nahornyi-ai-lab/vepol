#!/usr/bin/env python3
"""kb-morning-digest — finalized digest sent to independently enabled channels.

Morning resolves only the finalized same-day brief, eligible rich arXiv report,
and finalized Money Radar digest. It joins those whole blocks without an LLM
synthesis pass, then gives the same privacy-gated frozen speech file to every
enabled audio channel. Evening Retro keeps its independent trusted path.

Usage:
  kb-morning-digest                       # today: gather -> synth -> file -> audio
  kb-morning-digest --period evening      # evening retro: day file -> short audio
  kb-morning-digest --date 2026-06-25     # explicit date
  kb-morning-digest --digest-file F       # use F as the digest body (skip synth)
  kb-morning-digest --no-push             # build the report only, skip audio
  kb-morning-digest --out PATH            # write digest to PATH (preview)
  kb-morning-digest --force               # regenerate even if manifest completed
"""
from __future__ import annotations

import argparse
