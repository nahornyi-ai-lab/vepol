import fcntl
import glob
import hashlib
import json
import os
import pathlib
import re
import shutil
import signal
import subprocess
import sys
import tempfile
import time
from typing import Any


HUB = pathlib.Path(os.environ.get("KB_HUB", os.path.expanduser("~/knowledge")))
REPORTS = HUB / "reports"
ORCH = HUB / ".orchestrator"
BRIEFS = HUB / "briefs"
LOG = HUB / "logs" / "morning-digest.log"
HUB_LOG = HUB / "log.md"

VEPOL_DEV = pathlib.Path(
    os.environ.get("KB_VEPOL_DEV", os.path.expanduser("~/example-project"))
)

# User language (spec D2: the digest speaks the user's language; the public
# default is en). Same resolution as kb-brief/kb-retro: KB_LANG env override ->
# personal/profile.yaml -> en. The synthesis prompts below stay
# Russian-authored (their Russian section names are the STRUCTURE SAMPLE,
# kb-retro precedent); the OUTPUT language is directed by the user's language
# name and the local Qwen render passes --language explicitly. Fail-open:
# language is presentation and must never block the digest.
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
try:
    from _kb_profile import get_language, language_directive
    UI_LANG = get_language(HUB)
    UI_LANG_NAME = language_directive(UI_LANG)
except Exception:  # noqa: BLE001
    UI_LANG, UI_LANG_NAME = "en", "English"

from _kb_codex import CodexUnavailable, codex_bin
from _kb_claude_runner import run_command as run_unbounded_command
