ATTEMPT_CAPS = {"build": 2, "tts": 2, "telegram": 3, "total": 5}
DELIVERY_TAG = "local_qwen_telegram"

# Synthesis is not bound to one runtime: subscriptions and rate limits move, so
# the digest tries an ordered chain of CLI agents and uses the first that returns
# a usable result. Owner directive 2026-07-29 (chat): claude primary, codex as
# fallback (supersedes 2026-06-25 codex-primary).
# Override the order/membership with KB_MORNING_SYNTH_AGENTS (e.g. "codex,claude"
# or "claude,codex,agy"). Known agents: codex, claude, agy, grok.
SYNTH_AGENTS = [
    a.strip() for a in
    os.environ.get("KB_MORNING_SYNTH_AGENTS", "claude,codex").split(",")
    if a.strip()
]
# Model override applies to the claude backend only (codex/agy/grok use their own
# configured model).
SYNTH_MODEL = os.environ.get("KB_MORNING_SYNTH_MODEL", "sonnet")

# Exit code when another instance holds the per-date lock. Non-zero ON PURPOSE:
# kb-tick sets the fired flag only on rc==0, so returning 0 here would falsely
# mark the day "done" while this invocation produced nothing (the lock holder
# might be a preview, or a run that then soft-fails on quota). With a non-zero
# "retry" code kb-tick leaves the flag unset and re-fires next tick, by which
# time the contender has finished (lock auto-released) and the run either finds
# the manifests already done or produces the digest itself. The config validator
# is the first gate; channel selection is the independent outputs flag map.
RC_LOCK_CONTENTION = 75
RC_INVALID_RETRO = 75

# Scheduler budget: kb-tick caps the whole process at 1800s. Synthesis and local
# render each remain bounded, and Telegram upload has its own short timeout.
SYNTH_TIMEOUT = int(os.environ.get("KB_MORNING_SYNTH_TIMEOUT", "240"))            # per agent
SYNTH_TOTAL_TIMEOUT = int(os.environ.get("KB_MORNING_SYNTH_TOTAL_TIMEOUT", "420"))  # whole chain
TTS_TIMEOUT = int(os.environ.get("KB_MORNING_TTS_TIMEOUT", "900"))
TELEGRAM_TIMEOUT = int(os.environ.get("KB_MORNING_TELEGRAM_TIMEOUT", "180"))
NBLM_MAX_ATTEMPTS = int(os.environ.get("KB_MORNING_DIGEST_MAX_ATTEMPTS", "3"))
AUDIO_FORMAT = os.environ.get("KB_MORNING_AUDIO_FORMAT", "deep-dive")
AUDIO_LENGTH = os.environ.get("KB_MORNING_AUDIO_LENGTH", "long")
AUDIO_LANG = os.environ.get("KB_MORNING_AUDIO_LANG", "") or UI_LANG
# Freshness window: an artifact older than this many days is still shown but
# flagged "stale" so the synth does not present it as "this morning".
FRESH_DAYS = int(os.environ.get("KB_MORNING_FRESH_DAYS", "2"))


def resolve_notebooklm_bin() -> str:
    configured = os.environ.get("KB_NOTEBOOKLM_BIN", "").strip()
    if configured:
        return configured
    found = shutil.which("notebooklm")
    if found:
        return found
    user_bin = pathlib.Path.home() / ".local" / "bin" / "notebooklm"
    return str(user_bin) if user_bin.exists() else "notebooklm"


NOTEBOOKLM_BIN = resolve_notebooklm_bin()


def now_iso() -> str:
    return dt.datetime.now().astimezone().isoformat(timespec="seconds")


def today_iso() -> str:
    return dt.date.today().isoformat()


def log(msg: str) -> None:
    LOG.parent.mkdir(parents=True, exist_ok=True)
    with LOG.open("a", encoding="utf-8") as f:
        f.write(f"[{now_iso()}] morning-digest: {msg}\n")


def rel(path: pathlib.Path) -> str:
    try:
        return str(path.relative_to(HUB))
    except ValueError:
        return str(path)


def atomic_write(path: pathlib.Path, content: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=str(path.parent), prefix=f".{path.name}.", suffix=".tmp")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(content)
        os.replace(tmp, path)
        os.chmod(path, 0o600)
    except Exception:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


# ---------------------------------------------------------------------------
# Paths / titles
# ---------------------------------------------------------------------------

# Every date-keyed artifact (file, manifest, lock, source title) is scoped by
# (date, period) so an evening run never no-ops on / overwrites the morning's
# state (spec D2). Only the monthly notebook is shared between periods.

def digest_path(date_iso: str, period: str = "morning") -> pathlib.Path:
    return REPORTS / f"{period}-digest-{date_iso}.md"


def manifest_path(date_iso: str, period: str = "morning") -> pathlib.Path:
    return ORCH / f"{period}-digest-{date_iso}.json"


def notebooklm_manifest_path(date_iso: str, period: str = "morning") -> pathlib.Path:
    return ORCH / f"{period}-digest-{date_iso}-notebooklm.json"


def speech_path(date_iso: str, period: str = "morning") -> pathlib.Path:
    return REPORTS / f"{period}-digest-{date_iso}.txt"


def audio_path(date_iso: str, period: str = "morning") -> pathlib.Path:
    return REPORTS / f"{period}-digest-{date_iso}.mp3"


def notebook_title(date_iso: str) -> str:
    return f"Vepol утренний дайджест {date_iso[:7]}"


def source_title(date_iso: str, period: str = "morning") -> str:
    if period == "evening":
        return f"Vepol вечернее ретро {date_iso}"
    return f"Утренний дайджест Vepol {date_iso}"


# ---------------------------------------------------------------------------
# Gather: freshest output of every morning process
# ---------------------------------------------------------------------------

DATE_RE = re.compile(r"(\d{4}-\d{2}-\d{2})")


def _date_from_name(path: pathlib.Path) -> str | None:
    m = DATE_RE.search(path.name)
    return m.group(1) if m else None


def latest_match(patterns: list[str]) -> pathlib.Path | None:
    """Newest file by embedded date, mtime_ns, then deterministic path."""
    candidates: list[pathlib.Path] = []
    for pat in patterns:
        candidates.extend(pathlib.Path(p) for p in glob.glob(pat))
    if not candidates:
        return None

    def key(p: pathlib.Path):
        d = _date_from_name(p) or "0000-00-00"
        try:
            mtime = p.stat().st_mtime_ns
        except OSError:
            mtime = 0
        return (d, mtime, rel(p))

    return max(candidates, key=key)


def _staleness(date_str: str | None, ref: str) -> str:
    if not date_str:
        return "дата неизвестна"
    try:
        d = dt.date.fromisoformat(date_str)
        r = dt.date.fromisoformat(ref)
    except ValueError:
        return "дата неизвестна"
    delta = (r - d).days
    if delta <= 0:
        return "свежее (сегодня)"
    if delta == 1:
        return "вчерашнее"
    if delta <= FRESH_DAYS:
        return f"свежее ({delta} дн. назад)"
    return f"УСТАРЕЛО ({delta} дн. назад) — не выдавать за сегодняшнее"


def _read_text(path: pathlib.Path, cap: int) -> str:
    try:
        txt = path.read_text(encoding="utf-8", errors="replace")
    except Exception as exc:  # noqa: BLE001
        return f"(не удалось прочитать: {exc})"
    return _cap_text(txt, cap)


def _cap_text(txt: str, cap: int) -> str:
    if len(txt) > cap:
        return txt[:cap] + f"\n\n…(обрезано, всего {len(txt)} символов)"
    return txt


def _read_full_text(path: pathlib.Path) -> str:
    try:
        return path.read_text(encoding="utf-8", errors="replace")
    except Exception as exc:  # noqa: BLE001
        return f"(не удалось прочитать: {exc})"


def _truncate_before_line_heading(
    text: str,
    headings: tuple[str, ...],
    suffix: str = "\n\n…(historical day file truncated before evening sections)",
) -> str:
    cut: int | None = None
    for heading in headings:
        m = re.search(rf"(?m)^{re.escape(heading)}", text)
        if m and (cut is None or m.start() < cut):
            cut = m.start()
    if cut is None:
        return text
    return text[:cut].rstrip() + suffix


def _run(cmd: list[str], timeout: int = 60) -> str:
    try:
        proc = subprocess.run(
            cmd, capture_output=True, text=True, timeout=timeout, check=False
        )
        out = (proc.stdout or "").strip()
        return out or "(пусто)"
    except Exception as exc:  # noqa: BLE001
        return f"(ошибка вызова: {exc})"


# ---------------------------------------------------------------------------
# Content-rule shapers (spec morning-digest-inputs-rebalance-2026-07-11).
# Each shaper keeps NEEDED data and drops junk by content — never by a char cap.
# ---------------------------------------------------------------------------

# D13: the board block is GONE — the brief is the single day-aggregator; tasks
# reach the digest only as the brief's curated prose (kb-brief reads each active
# project's backlog.md itself). kb-retro keeps consuming kb-board directly.

# D7: log tails — recent MEANINGFUL entries as header + first paragraph.
LOG_ENTRY_RE = re.compile(r"(?m)^## \[")
LOG_CATEGORY_RE = re.compile(r"^## \[[^\]]*\]\s*([^|]+?)\s*\|")
LOG_JUNK_CATEGORIES = {"digest", "session"}
LOG_GIST_ENTRIES = int(os.environ.get("KB_MORNING_LOG_GIST_ENTRIES", "12"))


def _log_gist(text: str, limit: int = LOG_GIST_ENTRIES) -> str:
    """Recent meaningful dated entries (split on '^## ['), excluding digest-receipt
    and session-capture categories; each entry rendered as its header line plus its
    FIRST semantic paragraph (up to the first blank line) only. Content rule, no
    char cap and no byte clip; the paragraph boundary is what bounds each gist."""
    starts = [m.start() for m in LOG_ENTRY_RE.finditer(text)]
    if not starts:
        return text.strip() or "(пусто)"
    bounds = starts + [len(text)]
    kept: list[str] = []
    for i, start in enumerate(starts):
        entry = text[start:bounds[i + 1]].strip()
        if not entry:
            continue
        header = entry.splitlines()[0].strip()
        cat_m = LOG_CATEGORY_RE.match(header)
        category = cat_m.group(1).strip().lower() if cat_m else ""
        if category in LOG_JUNK_CATEGORIES:
            continue
        rest = entry[len(entry.splitlines()[0]):].lstrip("\n")
        first_para = rest.split("\n\n", 1)[0].strip()
        kept.append(f"{header}\n{first_para}".strip() if first_para else header)
    if not kept:
        return "(нет содержательных записей)"
    return "\n\n".join(kept[-limit:])


# D7b: per-project visibility guarantee — latest log-entry header of every live
# registry project, so no quiet project silently vanishes.
REGISTRY_ROW_RE = re.compile(r"^\|\s*([^|]+?)\s*\|\s*([^|]+?)\s*\|")
LOG_HEADER_DATE_RE = re.compile(r"^## \[(\d{4}-\d{2}-\d{2})[^\]]*\]\s*(.*)$")


def _registry_live_slugs() -> list[str] | None:
    """Slugs with status 'live' from registry.md, or None if it is unreadable."""
    reg = HUB / "registry.md"
    try:
        text = reg.read_text(encoding="utf-8", errors="replace")
    except Exception:  # noqa: BLE001 — missing/unreadable/dir-in-place-of-file
        return None
    slugs: list[str] = []
    for line in text.splitlines():
        m = REGISTRY_ROW_RE.match(line)
        if not m:
            continue
        slug, status = m.group(1).strip(), m.group(2).strip().lower()
        if status == "live" and slug and slug.lower() != "slug":
            slugs.append(slug)
    return slugs


def _project_last_trace(slug: str) -> tuple[str, str]:
    """Return (date, rendered_line) for a project's last dated log entry.
    Missing log / no dated entries → ('', '<slug>: (записей нет)')."""
    plog = HUB / "projects" / slug / "log.md"
    try:
        text = plog.read_text(encoding="utf-8", errors="replace")
    except Exception:  # noqa: BLE001
        return "", f"{slug}: (записей нет)"
    last_date = ""
    last_header = ""
    for line in text.splitlines():
        m = LOG_HEADER_DATE_RE.match(line.strip())
        if m:
            last_date, last_header = m.group(1), m.group(2).strip()
    if not last_date:
        return "", f"{slug}: (записей нет)"
    return last_date, f"{slug}: [{last_date}] {last_header}".rstrip()


def _project_guarantee_block() -> str:
    slugs = _registry_live_slugs()
    if slugs is None:
        return "(registry unavailable)"
    rendered: list[tuple[str, str]] = [_project_last_trace(s) for s in slugs]
    # Sort by date descending; projects with no entries (date '') sink to the end.
    rendered.sort(key=lambda pair: pair[0], reverse=True)
    return "\n".join(line for _, line in rendered)


# D9: money-radar — prose digest first, JSON as a structured fallback.
MONEY_VOICE_FIELDS = (
    ("band", "уровень"),
    ("money_flow", "поток денег"),
    ("pain_signal", "боль"),
    ("audience_density", "плотность аудитории"),
    ("who_earns", "кто зарабатывает"),
    ("why_now", "почему сейчас"),
    ("how_it_works", "как работает"),
    ("rough_numbers", "порядок чисел"),
    ("risk", "риск"),
    ("how_to_try", "как попробовать"),
)


def _render_money_json(data: Any) -> str:
    """Structured render: report.ranked/nogo/confidence first, then candidates
    collected from agents[*].candidates (deduped by title, ranked matches first),
    prose fields in voice order. URLs, numeric scores, _links_withheld and all run
    metadata are dropped. Schema-drift tolerant: missing keys skip."""
    if not isinstance(data, dict):
        return "(данные радара нечитаемы)"
    report = data.get("report") if isinstance(data.get("report"), dict) else {}
    lines: list[str] = []

    ranked = [str(t).strip() for t in report.get("ranked", []) if str(t).strip()] \
        if isinstance(report.get("ranked"), list) else []
    nogo = [str(t).strip() for t in report.get("nogo", []) if str(t).strip()] \
        if isinstance(report.get("nogo"), list) else []
    confidence = str(report.get("confidence") or "").strip()
    if ranked:
        lines.append("Отобрано (ranked):")
        lines.extend(f"- {t}" for t in ranked)
    if nogo:
        lines.append("Мимо (no-go):")
        lines.extend(f"- {t}" for t in nogo)
    if confidence:
        lines.append(f"Уверенность: {confidence}")

    # Collect candidates from agents[*].candidates (agents is a dict or list).
    agents = data.get("agents")
    agent_iter = agents.values() if isinstance(agents, dict) else (
        agents if isinstance(agents, list) else [])
    candidates: dict[str, dict[str, Any]] = {}
    order: list[str] = []
    for agent in agent_iter:
        if not isinstance(agent, dict):
            continue
        for cand in agent.get("candidates", []) if isinstance(agent.get("candidates"), list) else []:
            if not isinstance(cand, dict):
                continue
            title = str(cand.get("title") or "").strip()
            if not title:
                continue
            key = title.lower()
            if key not in candidates:
                candidates[key] = cand
                order.append(key)

    ranked_keys = {t.lower() for t in ranked}
    ordered_keys = [k for k in order if k in ranked_keys] + \
                   [k for k in order if k not in ranked_keys]
    if ordered_keys or ranked:
        lines.append("")
        lines.append("Разбор кандидатов:")
    for title in ranked:
        if title.lower() not in candidates:
            lines.append(f"- {title}")
    for key in ordered_keys:
        cand = candidates[key]
        lines.append(f"- {cand.get('title', '').strip()}")
        for field, label in MONEY_VOICE_FIELDS:
            val = cand.get(field)
            if isinstance(val, str) and val.strip():
                lines.append(f"    {label}: {val.strip()}")
    return "\n".join(lines).strip() or "(радар без кандидатов)"


def _money_block(date_iso: str) -> dict[str, Any]:
    """Resolve the money-radar candidates by explicit priority (D9):
      1. same-day <today>-digest.txt   2. same-day <today>.json (structured)
      3. newest stale *-digest.txt      4. newest stale JSON / codex-out.
    A same-day file of either kind always beats any stale file."""
    same_digest = ORCH / f"money-radar-{date_iso}-digest.txt"
    same_json = ORCH / f"money-radar-{date_iso}.json"

    if same_digest.is_file():
        return {"snapshot_key": "money_radar", "snapshot_state": "present",
                "name": "Money radar (быстрые деньги)",
                "meta": f"{rel(same_digest)} | свежее (сегодня)",
                "text": _read_full_text(same_digest).strip() or "(пусто)"}
    if same_json.is_file():
        try:
            data = json.loads(same_json.read_text(encoding="utf-8", errors="replace"))
        except Exception as exc:  # noqa: BLE001
            data = None
            text = f"(не удалось разобрать JSON: {exc})"
        else:
            text = _render_money_json(data)
        return {"snapshot_key": "money_radar", "snapshot_state": "present",
                "name": "Money radar (быстрые деньги)",
                "meta": f"{rel(same_json)} | свежее (сегодня, из JSON)",
                "text": text}

    stale_digest = latest_match([str(ORCH / "money-radar-2*-digest.txt")])
    if stale_digest and stale_digest.is_file():
        d = _date_from_name(stale_digest)
        return {"snapshot_key": "money_radar", "snapshot_state": "present",
                "name": "Money radar (быстрые деньги)",
                "meta": f"{rel(stale_digest)} | {_staleness(d, date_iso)}",
                "text": _read_full_text(stale_digest).strip() or "(пусто)"}

    stale_json = latest_match([
        str(ORCH / "money-radar-2*.json"),
        str(ORCH / "money-radar-*-codex-out.txt"),
    ])
    if stale_json and stale_json.is_file():
        d = _date_from_name(stale_json)
        if stale_json.suffix == ".json":
            try:
                data = json.loads(stale_json.read_text(encoding="utf-8", errors="replace"))
                text = _render_money_json(data)
            except Exception as exc:  # noqa: BLE001
                text = f"(не удалось разобрать JSON: {exc})"
        else:
            text = _read_full_text(stale_json).strip() or "(пусто)"
        return {"snapshot_key": "money_radar", "snapshot_state": "present",
                "name": "Money radar (быстрые деньги)",
                "meta": f"{rel(stale_json)} | {_staleness(d, date_iso)}",
                "text": text}

    return {"snapshot_key": "money_radar", "snapshot_state": "missing",
            "name": "Money radar (быстрые деньги)",
            "meta": "нет данных", "text": "(нет файла)"}


# D10: escalations — only the '## Open' slice, template HTML comments stripped.
HTML_COMMENT_RE = re.compile(r"<!--.*?-->", re.DOTALL)


def _open_escalations(text: str) -> str:
    lines = text.splitlines()
    open_body: list[str] = []
    in_open = False
    for line in lines:
        if re.match(r"^##\s+Open\b", line):
            in_open = True
            continue
        if in_open and re.match(r"^##\s+", line):
            break
        if in_open:
            open_body.append(line)
    body = HTML_COMMENT_RE.sub("", "\n".join(open_body)).strip()
    return body or "Открытых эскалаций нет."


# D11 (digest side): a missing same-day brief appends ONE deduped line per date.
def _append_missing_brief_log(date_iso: str) -> None:
    marker = f'## [{date_iso}] digest | hub | "morning brief missing — digest built without it"'
    try:
        if HUB_LOG.is_file():
            existing = HUB_LOG.read_text(encoding="utf-8", errors="replace")
            if marker in existing:
                return
        HUB_LOG.parent.mkdir(parents=True, exist_ok=True)
        with HUB_LOG.open("a", encoding="utf-8") as f:
            f.write(("\n" if HUB_LOG.is_file() else "") + marker + "\n")
    except Exception as exc:  # noqa: BLE001 — logging must never block the digest
        log(f"{date_iso}: could not append missing-brief log line: {exc}")


def gather(date_iso: str) -> list[dict[str, Any]]:
    """Return ordered list of context blocks; each is tolerant to missing data."""
    blocks: list[dict[str, Any]] = []

    # D3: arXiv report read WHOLE (no char cap); a stale pre-fix report could still
    # carry the runner-ups list, so drop everything from that heading onward
    # (belt-and-suspenders keyed on a heading, not a char cap).
    arxiv = latest_match([str(REPORTS / "learning-arxiv-summary-*.md")])
    if arxiv and arxiv.is_file():
        d = _date_from_name(arxiv)
        text = _truncate_before_line_heading(
            _read_full_text(arxiv),
            ("## Не вошли (runner-ups)", "## Runner-ups", "## Runner-ups (не вошли)"),
            suffix="\n\n…(runner-ups list removed — see snapshot)",
        )
        blocks.append({
            "snapshot_key": "learning", "snapshot_state": "present",
            "name": "ArXiv AI research (дневная сводка)",
            "meta": f"{rel(arxiv)} | {_staleness(d, date_iso)}",
            "text": text,
        })
    else:
        blocks.append({
            "snapshot_key": "learning", "snapshot_state": "missing",
            "name": "ArXiv AI research (дневная сводка)",
            "meta": "нет данных", "text": "(нет файла)",
        })

    # D9: money-radar by explicit priority (prose digest first, JSON as fallback).
    blocks.append(_money_block(date_iso))

    # D11 (digest side): a missing same-day brief must never voice the past — put
    # ZERO historical brief text in the packet, one loud notice line for voicing,
    # and one deduped log.md line per date.
    # D13: the brief is the single day-aggregator (mail/calendar/tasks arrive only
    # inside it), and the only mail-derived surface left in the packet — so its
    # text passes through strip_untrusted_spans (same treatment the evening path
    # applies to the same file): a malformed/leaked raw mail span in the day file
    # must never reach the voice.
    same_day_brief = BRIEFS / f"{date_iso}.md"
    if same_day_brief.is_file():
        blocks.append({
            "snapshot_key": "brief", "snapshot_state": "present",
            "name": "Утренний бриф (kb-brief)",
            "meta": f"{rel(same_day_brief)} | свежее (сегодня)",
            "text": strip_untrusted_spans(
                _read_full_text(same_day_brief)
            ).strip() or "(пусто)",
        })
    else:
        _append_missing_brief_log(date_iso)
        blocks.append({
            "snapshot_key": "brief", "snapshot_state": "present",
            "name": "Утренний бриф (kb-brief)",
            "meta": "нет файла за сегодня",
            "text": "утренний бриф за сегодня не создан — инцидент в работе",
        })

    # D8: daily-research block removed (dead 29-day-stale duplicate of the arXiv
    # research; verified sole consumer). Nothing to gather here.

    # D10: idea digest — append only when there is something (non-'(пусто)').
    # Error strings still append so failures stay visible.
    ideas_text = _run([str(HUB / "bin" / "kb-idea"), "brief", "--limit", "3"], 25)
    if ideas_text.strip() != "(пусто)":
        blocks.append({
            "snapshot_key": "ideas", "snapshot_state": "present",
            "name": "Идеи в работе (kb-idea brief)",
            "meta": "kb-idea brief --limit 3",
            "text": ideas_text,
        })

    # example-project project state + recent log + board.
    # D10: state.md read WHOLE (no char cap) — a clean dashboard is needed data.
    state = VEPOL_DEV / "knowledge" / "state.md"
    if state.is_file():
        blocks.append({
            "snapshot_key": "project_state", "snapshot_state": "present",
            "name": "Проект example-project — состояние",
            "meta": rel(state) if str(state).startswith(str(HUB)) else str(state),
            "text": _read_full_text(state),
        })
    # D7: recent MEANINGFUL log entries as header + first paragraph (no tail cap).
    vlog = VEPOL_DEV / "knowledge" / "log.md"
    if vlog.is_file():
        blocks.append({
            "snapshot_key": "project_log", "snapshot_state": "present",
            "name": "Проект example-project — свежий лог",
            "meta": str(vlog),
            "text": _log_gist(_read_full_text(vlog)),
        })
    # D13: no board block — tasks arrive only via the brief (single day-aggregator).

    # D7b: per-project visibility guarantee — latest trace of every live project.
    blocks.append({
        "snapshot_key": "project_guarantee", "snapshot_state": "present",
        "name": "Проекты: последний след каждого живого проекта",
        "meta": "registry.md (status: live) → projects/<slug>/log.md",
        "text": _project_guarantee_block(),
    })

    # Hub-wide pulse — D7 meaningful-entry gist (digest receipts + sessions drop).
    if HUB_LOG.is_file():
        blocks.append({
            "snapshot_key": "hub_log", "snapshot_state": "present",
            "name": "Хаб — свежий лог",
            "meta": "log.md (свежие содержательные записи)",
            "text": _log_gist(_read_full_text(HUB_LOG)),
        })
    # D10: escalations — only the '## Open' slice, template comments stripped.
    esc = HUB / "escalations.md"
    if esc.is_file():
        blocks.append({
            "snapshot_key": "escalations", "snapshot_state": "present",
            "name": "Хаб — эскалации",
            "meta": rel(esc),
            "text": _open_escalations(_read_full_text(esc)),
        })

    return blocks


# D13: no direct mail block — the brief is the single day-aggregator; mail
# reaches the digest only as the brief's curated prose (kb-brief consumes
# kb-mail-block itself). The mail pipeline (kb-mail-brief / kb-mail-block /
# envelopes) is untouched.

# Finalized morning input contract. Diagnostics stay outside the semantic hash.
SNAPSHOT_SCHEMA = "morning-input/v3"
MORNING_INPUT_KEYS = ("brief", "learning", "money_radar")


def _finalized_block(key: str, state: str, name: str, meta: str,
                     text: str = "") -> dict[str, Any]:
    return {
        "snapshot_key": key,
        "snapshot_state": state,
        "name": name,
        "meta": meta,
        "text": text,
    }


def _read_exact_utf8(path: pathlib.Path) -> str:
    return path.read_bytes().decode("utf-8", errors="strict")


def _morning_brief_block(date_iso: str) -> dict[str, Any]:
    path = BRIEFS / f"{date_iso}.md"
    name = "Утренний бриф (finalized)"
    if not path.is_file():
        log(f"{date_iso}: finalized morning brief missing")
        return _finalized_block("brief", "missing", name, "same-day file missing")
    try:
        raw = _read_exact_utf8(path)
    except (OSError, UnicodeDecodeError) as exc:
        log(f"{date_iso}: finalized morning brief unreadable: {exc.__class__.__name__}")
        return _finalized_block("brief", "unreadable", name, "same-day file unreadable")
    lines = raw.splitlines(keepends=True)
    if not lines or lines[0].rstrip("\r\n") != "---":
        raise ValueError("morning brief has no YAML frontmatter")
    end = None
    for index, line in enumerate(lines[1:], start=1):
        if line.rstrip("\r\n") == "---":
            end = index
            break
    if end is None:
        raise ValueError("morning brief has unterminated YAML frontmatter")
    body_lines: list[str] = []
    exact_tail = re.compile(r"^## (?:Retro|Reflection) \([^\n]*\)$")
    tail_lookalike = re.compile(r"^## (?:Retro|Reflection)(?:$|[:\s–—])")
    for line in lines[end + 1:]:
        visible = line.rstrip("\r\n")
        if exact_tail.fullmatch(visible):
            break
        if tail_lookalike.match(visible):
            log(f"{date_iso}: malformed morning/evening boundary: {visible}")
            raise ValueError(f"malformed morning/evening boundary: {visible}")
        body_lines.append(line)
    body = "".join(body_lines).strip("\r\n")
    if not body:
        log(f"{date_iso}: finalized morning brief empty")
        return _finalized_block("brief", "no_content", name, "same-day body empty")
    return _finalized_block("brief", "present", name, "same-day finalized body", body)


def _learning_finalized_block(date_iso: str) -> dict[str, Any]:
    manifest_path = ORCH / f"learning-arxiv-{date_iso}.json"
    report_path = REPORTS / f"learning-arxiv-summary-{date_iso}.md"
    name = "ArXiv research (finalized rich report)"
    if not manifest_path.is_file():
        log(f"{date_iso}: learning manifest missing; arXiv audio block skipped")
        return _finalized_block("learning", "missing", name, "same-day manifest missing")
    try:
        manifest = json.loads(_read_exact_utf8(manifest_path))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
        log(f"{date_iso}: learning manifest unreadable: {exc.__class__.__name__}")
        return _finalized_block("learning", "unreadable", name, "same-day manifest unreadable")
    if not isinstance(manifest, dict):
        log(f"{date_iso}: learning manifest root mismatch")
        return _finalized_block("learning", "unreadable", name, "manifest root mismatch")
    selected = manifest.get("selected_papers")
    no_new = manifest.get("no_new_papers")
    status = manifest.get("status")
    if status == "completed" and no_new is True and selected == []:
        log(f"{date_iso}: no new arXiv papers; audio block intentionally omitted")
        return _finalized_block("learning", "no_content", name, "valid no-content state")
    eligible = (
        status == "completed"
        and isinstance(selected, list) and bool(selected)
        and (no_new is False or no_new is None)
    )
    if not eligible:
        log(f"{date_iso}: learning manifest state mismatch; arXiv audio block skipped")
        return _finalized_block("learning", "unreadable", name, "manifest state mismatch")
    if not report_path.is_file():
        log(f"{date_iso}: selected learning state lacks same-day report")
        return _finalized_block("learning", "missing", name, "eligible same-day report missing")
    try:
        report = _read_exact_utf8(report_path).strip("\r\n")
    except (OSError, UnicodeDecodeError) as exc:
        log(f"{date_iso}: same-day arXiv report unreadable: {exc.__class__.__name__}")
        return _finalized_block("learning", "unreadable", name, "same-day report unreadable")
    if not report:
        log(f"{date_iso}: same-day arXiv report empty")
        return _finalized_block("learning", "no_content", name, "same-day report empty")
    return _finalized_block("learning", "present", name, "same-day eligible whole report", report)


def _money_finalized_block(date_iso: str) -> dict[str, Any]:
    path = ORCH / f"money-radar-{date_iso}-digest.txt"
    name = "Money Radar (finalized digest)"
    if not path.is_file():
        log(f"{date_iso}: same-day Money Radar digest missing")
        return _finalized_block("money_radar", "missing", name, "same-day digest missing")
    try:
        text = _read_exact_utf8(path).strip("\r\n")
    except (OSError, UnicodeDecodeError) as exc:
        log(f"{date_iso}: Money Radar digest unreadable: {exc.__class__.__name__}")
        return _finalized_block("money_radar", "unreadable", name, "same-day digest unreadable")
    if not text:
        log(f"{date_iso}: Money Radar digest empty")
        return _finalized_block("money_radar", "no_content", name, "same-day digest empty")
    return _finalized_block("money_radar", "present", name, "same-day whole digest", text)


def gather_finalized_morning(date_iso: str) -> list[dict[str, Any]]:
    return [
        _morning_brief_block(date_iso),
        _learning_finalized_block(date_iso),
        _money_finalized_block(date_iso),
    ]


def assemble_finalized_morning(blocks: list[dict[str, Any]]) -> str:
    return "\n\n".join(
        str(block.get("text") or "")
        for block in blocks
        if block.get("snapshot_state") == "present" and block.get("text")
    )


def _semantic_projection(key: str, text: str) -> str:
    # Blocks were normalized only at their outer CR/LF boundary by the
    # resolver. Internal bytes remain meaningful and are hashed whole.
    return text


def _snapshot_semantic_hash(inputs: list[dict[str, str]]) -> str:
    canonical = json.dumps(
        inputs, ensure_ascii=False, sort_keys=True, separators=(",", ":")
    ).encode("utf-8")
    return hashlib.sha256(canonical).hexdigest()


def upstream_snapshot(blocks: list[dict[str, Any]]) -> dict[str, Any]:
    by_key = {b.get("snapshot_key"): b for b in blocks if b.get("snapshot_key")}
    inputs: list[dict[str, str]] = []
    diagnostics: list[dict[str, str]] = []
    empty_hash = hashlib.sha256(b"").hexdigest()
    for key in MORNING_INPUT_KEYS:
        block = by_key.get(key)
        if block is None:
            state, text, meta = "missing", "", "missing"
        else:
            state = str(block.get("snapshot_state") or "present")
            text = str(block.get("text") or "")
            meta = str(block.get("meta") or "")
            if text.startswith("(не удалось прочитать:"):
                state, text = "unreadable", ""
        projected = _semantic_projection(key, text) if state == "present" else ""
        inputs.append({
            "name": key,
            "state": state,
            "content_sha256": hashlib.sha256(projected.encode("utf-8")).hexdigest()
            if state == "present" else empty_hash,
        })
        diagnostics.append({"name": key, "meta": meta})
    return {
        "schema": SNAPSHOT_SCHEMA,
        "inputs": inputs,
        "semantic_sha256": _snapshot_semantic_hash(inputs),
        "diagnostics": diagnostics,
    }


def snapshot_valid(snapshot: Any) -> bool:
    if not isinstance(snapshot, dict) or snapshot.get("schema") != SNAPSHOT_SCHEMA:
        return False
    inputs = snapshot.get("inputs")
    if not isinstance(inputs, list) or len(inputs) != len(MORNING_INPUT_KEYS):
        return False
    if [item.get("name") if isinstance(item, dict) else None for item in inputs] != list(MORNING_INPUT_KEYS):
        return False
    hex_re = re.compile(r"^[0-9a-f]{64}$")
    for item in inputs:
        if set(item) != {"name", "state", "content_sha256"}:
            return False
        if item["state"] not in ("present", "missing", "unreadable", "no_content"):
            return False
        if not isinstance(item["content_sha256"], str) or not hex_re.fullmatch(item["content_sha256"]):
            return False
    semantic = snapshot.get("semantic_sha256")
    return bool(
        isinstance(semantic, str)
        and hex_re.fullmatch(semantic)
        and semantic == _snapshot_semantic_hash(inputs)
    )


def capture_morning_input(date_iso: str) -> dict[str, Any]:
    blocks = gather_finalized_morning(date_iso)
    return {
        "blocks": blocks,
        "upstream_snapshot": upstream_snapshot(blocks),
    }


def build_context_packet(date_iso: str, blocks: list[dict[str, Any]]) -> str:
    # D13: no mail section — the brief block already carries the day's curated
    # mail; raw mail never enters the packet.
    parts = [
        f"# Контекст утренних процессов — {date_iso}",
        "",
        "Ниже — сырые/полусырые выходы всех утренних процессов оркестратора Vepol "
        "за самый свежий доступный цикл. Каждый блок помечен источником и свежестью.",
        "",
    ]
    for b in blocks:
        parts.append(f"## {b['name']}")
        parts.append(f"_источник: {b['meta']}_")
        parts.append("")
        parts.append(b["text"].rstrip())
        parts.append("")
    return "\n".join(parts)


# ---------------------------------------------------------------------------
# Evening gather (spec D2): today's day file + closed-today snapshot ONLY
# ---------------------------------------------------------------------------

# Privacy strip (spec AC7): the day file may carry a wrapped — or, worst case,
# leaked, unpaired, nested, or cap-truncated — untrusted mail block. A pair
# regex cannot handle those shapes (an unclosed opening tag would leave the
# body behind), so this is a depth-tracking scan: text is kept only at depth 0,
# an opening tag enters a span (nesting just deepens it), a closing tag leaves
# it, and an UNCLOSED span (e.g. the day-file cap clipped the closing tag) is
# dropped through end-of-text. An orphan closing tag at depth 0 is removed by
# itself without eating surrounding text. Applied AFTER the cap-clip so
# truncation cannot resurrect a half-block.
UNTRUSTED_TAG_RE = re.compile(r"<(/?)untrusted-source-[^>]*>")
UNTRUSTED_OR_BOUNDARY_RE = re.compile(
    r"<(/?)untrusted-source-[^>]*>|^## (?:Retro|Reflection) \(.*$",
    re.MULTILINE,
)
UNTRUSTED_PLACEHOLDER = "(untrusted block removed)"
RETRO_HEADING_RE = re.compile(r"(?m)^## Retro \([^\n]*\)\s*$")
REFLECTION_HEADING_RE = re.compile(r"(?m)^## Reflection \([^\n]*\)\s*$")


def _append_trusted_chunk(out: list[str], chunk: str) -> None:
    if not chunk:
        return
    cut = chunk.find("<untrusted-source-")
    if cut != -1:
        out.append(chunk[:cut])
        out.append(UNTRUSTED_PLACEHOLDER)
    else:
        out.append(chunk)


def strip_untrusted_spans(text: str) -> str:
    out: list[str] = []
    pos = 0
    depth = 0
    for m in UNTRUSTED_OR_BOUNDARY_RE.finditer(text):
        is_tag = m.group(0).startswith("<")
        if not is_tag:
            if depth == 0:
                _append_trusted_chunk(out, text[pos:m.start()])
                out.append(m.group(0))
            # A heading inside an open untrusted span is attacker-controlled;
            # strip it without closing or resynchronizing the span.
            pos = m.end()
            continue
        if depth == 0:
            _append_trusted_chunk(out, text[pos:m.start()])
        if m.group(1) != "/":
            if depth == 0:
                out.append(UNTRUSTED_PLACEHOLDER)
            depth += 1
        elif depth > 0:
            depth -= 1
        pos = m.end()
    if depth == 0:
        _append_trusted_chunk(out, text[pos:])
    # depth > 0 here: unclosed block — the tail is untrusted, drop it.
    return "".join(out)


def extract_evening_retro_text(day_text: str) -> str | None:
    cleaned = strip_untrusted_spans(day_text)
    start = RETRO_HEADING_RE.search(cleaned)
    if not start:
        return None
    stop = REFLECTION_HEADING_RE.search(cleaned, start.end())
    end = stop.start() if stop else len(cleaned)
    retro = cleaned[start.start():end].strip()
    return retro or None


def evening_missing_retro_source(date_iso: str) -> str:
    return (
        f"# Evening retro audio source for {date_iso}\n\n"
        "## Evening retro missing\n"
        f"Evening retro is missing for {date_iso}. No evening audio facts are "
        "available from the trusted Retro block. Run kb-retro first."
    )


def render_evening_retro_source(date_iso: str, retro_text: str | None) -> str:
    if not retro_text:
        return evening_missing_retro_source(date_iso)
    return _cap_text(retro_text, 24000)


def gather_evening(
    date_iso: str, retro: ParsedRetro | None = None,
) -> list[dict[str, Any]]:
    """Evening retro context. Deliberately does NOT reuse gather(): the recap is
    about what happened today (day file: brief + retro + reflection, plus the
    closed-today hub-log entries), not a re-read of the morning source map
    (spec D2). Raw mail envelopes under .orchestrator/mail/ are NEVER read here;
    the only mail the evening sees is what the brief/retro already surfaced in
    the day file, post-strip. The public caller supplies the same strict parsed
    Retro that passed the fail-closed evening preflight."""
    blocks: list[dict[str, Any]] = []

    day_file = BRIEFS / f"{date_iso}.md"
    parsed = retro if retro is not None else load_retro(HUB, date_iso)
    if parsed is not None:
        retro_text = f"{parsed.heading}\n\n{parsed.body.rstrip()}"
        text = render_evening_retro_source(date_iso, retro_text)
        blocks.append({
            "name": "Вечернее ретро (trusted Retro block)",
            "meta": rel(day_file),
            "text": text,
        })
    else:
        blocks.append({
            "name": "Вечернее ретро (trusted Retro block)",
            "meta": "нет данных",
            "text": evening_missing_retro_source(date_iso),
        })

    return blocks


def build_evening_context_packet(date_iso: str, blocks: list[dict[str, Any]]) -> str:
    # Evening audio is a render of the completed retro text, not a second
    # synthesis over day/log/mail/calendar sources.
    parts = [
        f"# Evening retro audio source packet — {date_iso}",
        "",
        f"Output language: {UI_LANG_NAME}. Voice only the trusted Retro block. "
        "Do not add facts, morning topics, or reflection text.",
        "",
    ]
    for b in blocks:
        parts.append(b["text"].rstrip())
        parts.append("")
    return "\n".join(parts)


# ---------------------------------------------------------------------------
# Synthesis via a pluggable CLI agent chain (codex / claude / agy / grok)
# ---------------------------------------------------------------------------

SYNTH_INSTRUCTION = f"""\
Ты — утренний редактор владельца. На входе ниже — сырые выходы всех утренних \
процессов его системы (обзор научных работ, обзор денежных возможностей, утренняя \
сводка — в ней почта, календарь и задачи дня, — состояние проектов и последние изменения).

Сделай ОДНУ связную утреннюю сводку на языке пользователя — {UI_LANG_NAME}, \
который он ПОСЛУШАЕТ как аудио и пойдёт работать. Это не отчёт и не список \
ссылок — это тёплый, плотный, по делу рассказ умного коллеги за кофе.

Жёсткие правила:
- Готовый текст — только на русском языке. Пиши простыми русскими словами.
- Не используй англицизмы, латиницу и английские сокращения.
- Сокращения раскрывай полностью русскими словами: «искусственный интеллект», а не «ИИ».
- Необходимые имена и названия передавай кириллицей так, как они звучат. Каждое \
имя или название пиши одинаково во всём тексте.
- Пиши короткими, простыми и естественными фразами. Текст должен легко восприниматься на слух.
- Расставляй знаки препинания так, чтобы при озвучке звучали понятные паузы.
- Никаких ссылок, путей к файлам, JSON, markdown-таблиц, кусков на других языках — это для озвучки.
- Каждый факт обязан опираться на данные ниже. НИЧЕГО не выдумывай. Если процесс \
дал пусто или данные устаревшие — так и скажи коротко («сегодня тут пусто»).
- Числа проговаривай словами там, где это естественно для слуха.
- Объём ~600–900 слов (≈5–7 минут озвучки).

Структура (ровно эти заголовки, каждый — '## '; названия заголовков — на языке \
пользователя {UI_LANG_NAME}, русские формулировки ниже — образец структуры):
## Утро: коротко о главном
## Наука и искусственный интеллект
## Деньги и возможности
## Проекты: где мы
## Твой день: сроки, главное, личное
## Решения от тебя
## Что предлагаю сделать сегодня

Если утренняя сводка за сегодня не создана (об этом прямо сказано в данных), не \
выдумывай её содержимое: в разделе «Что предлагаю сделать сегодня» так и \
скажи — «утренняя сводка не создана — действия только из состояния проектов и последних \
следов проектов» — и предложи шаги, опираясь только на состояние проектов и \
их последние следы. Список задач дня в этом случае недоступен — не \
реконструируй его и прямо скажи, что его сегодня нет.

Верни ТОЛЬКО саму сводку в markdown, без преамбулы и без послесловия.

=== ДАННЫЕ УТРЕННИХ ПРОЦЕССОВ ===
"""


# Evening variant: a SHORT spoken recap (~1-2 min), same hard rules as morning.
EVENING_SYNTH_INSTRUCTION = f"""\
Ты — вечерний редактор владельца. На входе ниже — дневной файл (утренний бриф, \
вечернее ретро, рефлексия) и записи лога за сегодня.

Сделай КОРОТКОЕ вечернее ретро на языке пользователя — {UI_LANG_NAME}, которое \
он ПОСЛУШАЕТ как аудио перед завершением дня. Это спокойный итог дня от умного \
коллеги, не отчёт.

Жёсткие правила:
- Только {UI_LANG_NAME}. Минимум терминов; каждый термин — объясни одной фразой сразу.
- Никаких ссылок, путей к файлам, JSON, markdown-таблиц, кусков на других языках — это для озвучки.
- Каждый факт обязан опираться на данные ниже. НИЧЕГО не выдумывай. Если данных \
нет — так и скажи коротко («сегодня тут пусто»).
- Числа проговаривай словами там, где это естественно для слуха.
- Объём ~150–300 слов (≈1–2 минуты озвучки).

Структура (ровно эти заголовки, каждый — '## '; названия заголовков — на языке \
пользователя {UI_LANG_NAME}, русские формулировки ниже — образец структуры):
## Что закрыто сегодня
## Что висит и ждёт
## Почта, на которую не ответили
## Один вопрос на вечер

Верни ТОЛЬКО само ретро в markdown, без преамбулы и без послесловия.

=== ДАННЫЕ ДНЯ ===
"""


def _resolve_agent_bin(name: str, candidates: list[str]) -> str:
    """KB_<NAME>_BIN env override → first existing absolute candidate → PATH.
    Launchd's PATH omits ~/.local/bin and ~/.grok/bin, so absolute fallbacks are
    required for agy/grok (same PATH-resolution reason)."""
    env = os.environ.get(f"KB_{name.upper()}_BIN", "").strip()
    if env:
        return env
    for c in candidates:
        c = os.path.expanduser(c)
        if os.path.exists(c):
            return c
    return shutil.which(name) or name


def _run_agent(
    argv: list[str],
    timeout: int,
    capture_file: pathlib.Path | None = None,
    *,
    unbounded: bool = False,
) -> str | None:
    """Run a CLI agent headlessly; Claude uses the durable unbounded runner.

    Other providers retain their wall-clock cap. stdin is ALWAYS
    /dev/null — codex 0.138+ hangs on open stdin, and a Bun/Node agent that
    inherits a live stdin can stall too (launch-matrix rule). Returns the cleaned
    answer, or None on failure / empty output (empty == failure, never 'no result')."""
    try:
        if unbounded:
            proc = run_unbounded_command(
                argv,
                cwd=HUB,
                output_mode="text",
                kind="claude",
                metadata={"caller": "kb-morning-digest"},
            )
        else:
            proc = subprocess.run(
                argv,
                stdin=subprocess.DEVNULL,
                capture_output=True,
                text=True,
                timeout=timeout,
                cwd=str(HUB),
                check=False,
            )
    except Exception as exc:  # noqa: BLE001 (includes TimeoutExpired)
        # str(TimeoutExpired) embeds the full argv (incl. the ~30KB prompt) — clip
        # it so a timeout (the expected failure mode) can't bloat the log.
        log(f"synth agent {os.path.basename(argv[0])} launch/timeout: "
            f"{type(exc).__name__}: {str(exc)[:160]}")
        return None
    if proc.returncode != 0:
        log(f"synth agent {os.path.basename(argv[0])} rc={proc.returncode}: "
            f"{(proc.stderr or '').strip()[:300]}")
        return None
    if capture_file is not None:
        try:
            text = capture_file.read_text(encoding="utf-8")
        except Exception as exc:  # noqa: BLE001
            log(f"synth agent {os.path.basename(argv[0])} output file unreadable: {exc}")
            return None
    else:
        text = proc.stdout or ""
    text = text.strip()
    if len(text) < 200:
        log(f"synth agent {os.path.basename(argv[0])} output too short "
            f"({len(text)} chars); treating as failure")
        return None
    return text


def _synth_claude(prompt: str, timeout: int) -> str | None:
    bin_ = _resolve_agent_bin("claude", ["/opt/homebrew/bin/claude"])
    argv = [bin_, "-p", prompt, "--output-format", "text", "--no-session-persistence"]
    if SYNTH_MODEL:
        argv += ["--model", SYNTH_MODEL]
    return _run_agent(argv, timeout, unbounded=True)


def _synth_codex(prompt: str, timeout: int) -> str | None:
    # codex exec prints banner/progress noise to stdout; the clean final message
    # goes to `-o <file>`. `</dev/null` (DEVNULL) + --skip-git-repo-check (HUB is
    # not a git repo) + --sandbox read-only are the load-bearing flags.
    try:
        bin_ = codex_bin()
    except CodexUnavailable as exc:
        log(f"synth agent codex unavailable: {exc}")
        return None
    fd, tmp = tempfile.mkstemp(prefix="morning-codex-", suffix=".txt")
    os.close(fd)
    out_file = pathlib.Path(tmp)
    try:
        argv = [bin_, "exec", "-C", str(HUB), "--skip-git-repo-check",
                "--sandbox", "read-only", "-o", str(out_file), prompt]
        return _run_agent(argv, timeout, capture_file=out_file)
    finally:
        try:
            out_file.unlink()
        except OSError:
            pass


def _synth_agy(prompt: str, timeout: int) -> str | None:
    bin_ = _resolve_agent_bin("agy", ["~/.local/bin/agy"])
    # --add-dir is mandatory or the workspace AGENTS.md is not loaded.
    return _run_agent([bin_, "--add-dir", str(HUB), "--print", prompt,
                       "--print-timeout", "5m"], timeout)


def _synth_grok(prompt: str, timeout: int) -> str | None:
    bin_ = _resolve_agent_bin("grok", ["~/.grok/bin/grok"])
    fd, tmp = tempfile.mkstemp(prefix="morning-grok-", suffix=".md")
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(prompt)
    pf = pathlib.Path(tmp)
    try:
        # --disable-web-search: synth needs no live web, and the web backend is
        # flaky; --no-subagents/--no-memory keep it a single bounded turn.
        return _run_agent([bin_, "--cwd", str(HUB), "--prompt-file", str(pf),
                           "--output-format", "plain", "--max-turns", "120",
                           "--no-subagents", "--no-memory", "--disable-web-search"], timeout)
    finally:
        try:
            pf.unlink()
        except OSError:
            pass


SYNTH_BACKENDS = {
    "codex": _synth_codex,
    "claude": _synth_claude,
    "agy": _synth_agy,
    "grok": _synth_grok,
}


def synth_digest(context_packet: str,
                 instruction: str = SYNTH_INSTRUCTION) -> tuple[str | None, str | None]:
    """Try each configured agent in order until one returns a usable digest. The
    non-Claude portion is bounded by SYNTH_TOTAL_TIMEOUT. Claude is always
    admitted and waits for natural exit, regardless of elapsed chain time.
    Returns (digest, agent_name), else (None, None) so the caller falls back to
    the deterministic packet."""
    prompt = instruction + context_packet
    deadline = time.monotonic() + SYNTH_TOTAL_TIMEOUT
    for name in SYNTH_AGENTS:
        fn = SYNTH_BACKENDS.get(name)
        if fn is None:
            log(f"unknown synth agent {name!r}; skipping")
            continue
        remaining = int(deadline - time.monotonic())
        if name != "claude" and remaining < 30:
            log(f"synth budget exhausted ({remaining}s left); stopping chain before {name}")
            continue
        lane_budget = SYNTH_TIMEOUT if name == "claude" else min(SYNTH_TIMEOUT, remaining)
        out = fn(prompt, lane_budget)
        if out:
            log(f"synth via {name}: ok ({len(out)} chars)")
            return out, name
        log(f"synth via {name}: failed/empty; trying next")
    return None, None


# ---------------------------------------------------------------------------
# Report and literal speech text
# ---------------------------------------------------------------------------


def render_source_file(date_iso: str, digest_body: str, blocks: list[dict[str, Any]],
                       period: str = "morning") -> str:
    weekday_ru = [
        "понедельник", "вторник", "среда", "четверг",
        "пятница", "суббота", "воскресенье",
    ]
    try:
        wd = weekday_ru[dt.date.fromisoformat(date_iso).weekday()]
    except ValueError:
        wd = ""
    sources = "\n".join(f"- {b['name']} — {b['meta']}" for b in blocks)
    if period == "evening":
        title = f"Вечернее ретро Vepol — {date_iso}"
        doc_type = "evening-digest"
    else:
        title = f"Утренний дайджест Vepol — {date_iso}"
        doc_type = "morning-digest"
    return f"""---
title: "{title}"
date: {date_iso}
type: {doc_type}
generator: kb-morning-digest
language: {UI_LANG}
---

# {title}{f' ({wd})' if wd else ''}

{digest_body.strip()}

---

## Источники (для проверки, не для озвучки)

{sources}
"""


def save_manifest(path: pathlib.Path, manifest: dict[str, Any]) -> None:
    atomic_write(path, json.dumps(manifest, ensure_ascii=False, indent=2) + "\n")


# ---------------------------------------------------------------------------
# Existing NotebookLM adapter (v0.5 behavior: artifact stays in NotebookLM)
# ---------------------------------------------------------------------------

def _parse_notebooklm_json(stdout: str) -> Any:
    text = stdout.strip()
    if not text:
        return {}
    try:
        return json.loads(text)
    except json.JSONDecodeError:
        start, end = text.find("{"), text.rfind("}")
        if start != -1 and end > start:
            return json.loads(text[start:end + 1])
        raise


def run_notebooklm(args: list[str]) -> Any:
    proc = subprocess.run(
        [NOTEBOOKLM_BIN, *args], capture_output=True, text=True,
        check=False,
    )
    if proc.returncode != 0:
        raise RuntimeError(
            f"notebooklm {' '.join(args[:3])} rc={proc.returncode}: "
            f"{proc.stderr.strip() or proc.stdout.strip()}"
        )
    return _parse_notebooklm_json(proc.stdout) if "--json" in args else proc.stdout


def _pick_notebooklm_id(data: Any, *keys: str) -> str:
    if isinstance(data, dict):
        for key in keys:
            value = data.get(key)
            if isinstance(value, str) and value:
                return value
        for value in data.values():
            found = _pick_notebooklm_id(value, *keys)
            if found:
                return found
    elif isinstance(data, list):
        for value in data:
            found = _pick_notebooklm_id(value, *keys)
            if found:
                return found
    return ""


def _pick_notebooklm_submission(data: Any) -> tuple[str, str]:
    if isinstance(data, dict):
        for key in ("task_id", "artifact_id", "id"):
            value = data.get(key)
            if isinstance(value, str) and value.strip():
                return value.strip(), key
        for value in data.values():
            found, kind = _pick_notebooklm_submission(value)
            if found:
                return found, kind
    elif isinstance(data, list):
        for value in data:
            found, kind = _pick_notebooklm_submission(value)
            if found:
                return found, kind
    return "", ""


def load_notebooklm_manifest(path: pathlib.Path) -> dict[str, Any]:
    if not path.is_file():
        return {}
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
        if not isinstance(value, dict):
            return {}
        # A local-Qwen manifest owns a different counter/state schema. Ignore it
        # instead of coercing its attempts dict or treating its completed send
        # as NotebookLM state.
        if value.get("delivery") == DELIVERY_TAG or isinstance(value.get("attempts"), dict):
            return {}
        return value
    except Exception as exc:  # noqa: BLE001
        return {
            "delivery": "notebooklm", "status": "failed",
            "attempts": NBLM_MAX_ATTEMPTS,
            "error": f"manifest parse failed: {exc}",
        }


def ensure_notebooklm_manifest(date_iso: str, period: str) -> pathlib.Path:
    """Give NotebookLM one stable manifest, importing legacy state once."""
    target = notebooklm_manifest_path(date_iso, period)
    if not target.is_file():
        legacy = load_notebooklm_manifest(manifest_path(date_iso, period))
        if legacy:
            save_manifest(target, legacy)
    return target


RETRO_ACTIVE_FIELDS = (
    "retro_sha256",
    "source_id",
    "source_retro_sha256",
    "artifact_id",
    "artifact_retro_sha256",
    "submission_id",
    "submission_id_kind",
    "submission_state",
    "retry_disposition",
    "local_delivery_status",
    "remote_status",
)


def _load_raw_manifest(path: pathlib.Path) -> dict[str, Any]:
    if not path.is_file():
        return {}
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except Exception:  # noqa: BLE001
        return {}
    return value if isinstance(value, dict) else {}


def _retro_attempt_snapshot(manifest: dict[str, Any]) -> dict[str, Any]:
    keys = (
        "delivery", "date", "period", "status", "attempts", "notebook_id",
        *RETRO_ACTIVE_FIELDS, "error", "last_attempt_at",
    )
    snapshot = {key: manifest.get(key) for key in keys if key in manifest}
    snapshot["archived_at"] = now_iso()
    return snapshot


def _has_active_retro_attempt(manifest: dict[str, Any]) -> bool:
    return manifest.get("status") == "completed" or any(
        manifest.get(key) not in (None, "") for key in RETRO_ACTIVE_FIELDS
    )


def _archive_active_retro_attempt(manifest: dict[str, Any]) -> None:
    if _has_active_retro_attempt(manifest):
        # Singular by contract: retain the immediately previous tuple as
        # bounded, non-authoritative forensic state.
        manifest["previous_attempt"] = _retro_attempt_snapshot(manifest)


def _clear_active_retro_attempt(
    manifest: dict[str, Any], retro_hash: str | None,
) -> None:
    manifest.update({
        "retro_sha256": retro_hash,
        "source_id": None,
        "source_retro_sha256": None,
        "artifact_id": None,
        "artifact_retro_sha256": None,
        "submission_id": None,
        "submission_id_kind": None,
        "submission_state": None,
        "retry_disposition": None,
        "local_delivery_status": None,
        "remote_status": None,
    })


def block_invalid_evening_retro(
    path: pathlib.Path, date_iso: str,
) -> None:
    """Remove active completion authority before returning retry rc 75."""
    manifest = _load_raw_manifest(path)
    _archive_active_retro_attempt(manifest)
    _clear_active_retro_attempt(manifest, None)
    manifest.update({
        "date": date_iso,
        "period": "evening",
        "status": "blocked_invalid_retro",
        "error": "current durable Retro is missing or invalid",
        "updated_at": now_iso(),
    })
    save_manifest(path, manifest)


def evening_notebooklm_already_done(
    manifest: dict[str, Any], retro_hash: str,
) -> bool:
    return (
        manifest.get("status") == "completed"
        and isinstance(manifest.get("source_id"), str)
        and bool(manifest["source_id"].strip())
        and isinstance(manifest.get("artifact_id"), str)
        and bool(manifest["artifact_id"].strip())
        and manifest.get("retro_sha256") == retro_hash
        and manifest.get("source_retro_sha256") == retro_hash
        and manifest.get("artifact_retro_sha256") == retro_hash
    )


def prepare_evening_notebooklm_manifest(
    manifest: dict[str, Any], retro_hash: str, force: bool,
) -> dict[str, Any]:
    """Return current-H state, archiving any legacy or stale active tuple."""
    source_id = manifest.get("source_id")
    artifact_id = manifest.get("artifact_id")
    source_hash = manifest.get("source_retro_sha256")
    artifact_hash = manifest.get("artifact_retro_sha256")
    current_hash = manifest.get("retro_sha256")

    no_remote_ids = all(
        value in (None, "")
        for value in (source_id, source_hash, artifact_id, artifact_hash)
    )
    current_empty = current_hash == retro_hash and no_remote_ids
    current_source = (
        current_hash == retro_hash
        and isinstance(source_id, str) and bool(source_id.strip())
        and source_hash == retro_hash
        and artifact_id in (None, "")
        and artifact_hash in (None, "")
    )
    unbound_fresh = (
        current_hash in (None, "")
        and no_remote_ids
        and manifest.get("status") not in ("completed", "blocked_invalid_retro")
    )
    rollover = force or not (current_empty or current_source or unbound_fresh)

    if rollover:
        _archive_active_retro_attempt(manifest)
        _clear_active_retro_attempt(manifest, retro_hash)
        manifest.update({"status": "started", "attempts": 0, "error": None})
    elif unbound_fresh:
        _clear_active_retro_attempt(manifest, retro_hash)
    return manifest


def _positive_message_id(value: Any) -> bool:
    return isinstance(value, int) and not isinstance(value, bool) and value > 0


def morning_delivery_guard(path: pathlib.Path, date_iso: str,
                           period: str) -> tuple[str, str | None]:
    """Classify route-independent morning terminal or integrity evidence."""
    if period != "morning" or not path.is_file():
        return "none", None
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except Exception:  # noqa: BLE001
        return "none", None
    if not isinstance(value, dict):
        return "none", None
    if (value.get("status") == "failed"
            and value.get("failed_stage") == "integrity"
            and value.get("retry_disposition") == "force_required"
            and value.get("completion_evidence_invalid") is True):
        return "invalid", str(value.get("error") or "invalid completion evidence")
    if value.get("status") != "completed":
        return "none", None
    if value.get("date") != date_iso or value.get("period") != period:
        return "invalid", "completed delivery identity does not match its manifest path"
    if value.get("delivery") == DELIVERY_TAG:
        message_id = (value.get("telegram") or {}).get("message_id") \
            if isinstance(value.get("telegram"), dict) else None
        if (value.get("retry_disposition") == "terminal"
                and _positive_message_id(message_id)
                and _manifest_semantics_valid(value)):
            return "completed", f"message_id={message_id}"
        return "invalid", "completed local delivery has invalid terminal evidence"
    artifact_id = value.get("artifact_id")
    if value.get("delivery") == "notebooklm" \
            and isinstance(artifact_id, str) and artifact_id.strip():
        return "completed", f"artifact={artifact_id}"
    return "invalid", "completed delivery has invalid backend evidence"


def mark_completion_integrity_failure(path: pathlib.Path, reason: str) -> None:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except Exception:  # noqa: BLE001
        value = {}
    if not isinstance(value, dict):
        value = {}
    value.update({
        "status": "failed",
        "failed_stage": "integrity",
        "retry_disposition": "force_required",
        "completion_evidence_invalid": True,
        "error": reason[:400],
        "updated_at": now_iso(),
    })
    save_manifest(path, value)


def _ensure_notebook(manifest: dict[str, Any]) -> str:
    existing = manifest.get("notebook_id")
    if isinstance(existing, str) and existing:
        return existing
    configured = os.environ.get("KB_MORNING_NOTEBOOK_ID", "").strip()
    if configured:
        manifest["notebook_id"] = configured
        return configured
    title = str(manifest["notebook_title"])
    data = run_notebooklm(["list", "--json"])
    for notebook in data.get("notebooks", []) if isinstance(data, dict) else []:
        if notebook.get("title") == title and notebook.get("id"):
            manifest["notebook_id"] = notebook["id"]
            return str(notebook["id"])
    created = run_notebooklm(["create", title, "--json"])
    notebook_id = _pick_notebooklm_id(created, "id", "notebook_id")
    if not notebook_id:
        raise RuntimeError(f"could not parse notebook id from create output: {created!r}")
    manifest["notebook_id"] = notebook_id
    return notebook_id


def push_notebooklm(
    date_iso: str, source_file: pathlib.Path, mpath: pathlib.Path,
    force: bool, period: str, retro_hash: str | None = None,
) -> int:
    if period == "evening":
        if not retro_hash:
            raise RuntimeError("evening NotebookLM route requires a Retro hash")
        manifest = _load_raw_manifest(mpath)
        if not force and evening_notebooklm_already_done(manifest, retro_hash):
            print(f"already completed: artifact={manifest.get('artifact_id')}")
            return 0
        manifest = prepare_evening_notebooklm_manifest(
            manifest, retro_hash, force,
        )
    else:
        manifest = load_notebooklm_manifest(mpath)
        if not force and manifest.get("status") == "completed" \
                and manifest.get("artifact_id"):
            print(f"already completed: artifact={manifest.get('artifact_id')}")
            return 0
    raw_attempts = manifest.get("attempts")
    attempts = raw_attempts if isinstance(raw_attempts, int) \
        and not isinstance(raw_attempts, bool) and raw_attempts >= 0 else 0
    if not force and manifest.get("status") == "failed" \
            and attempts >= NBLM_MAX_ATTEMPTS:
        print("terminal NotebookLM attempt already recorded; skipping")
        return 0
    if force and period != "evening":
        for key in (
            "source_id", "artifact_id", "submission_id", "submission_id_kind",
            "submission_state", "retry_disposition", "local_delivery_status",
            "remote_status",
        ):
            manifest[key] = None
        attempts = 0
    manifest.update({
        "delivery": "notebooklm", "date": date_iso, "period": period,
        "status": manifest.get("status") or "started",
        "attempts": attempts + 1,
        "notebook_title": notebook_title(date_iso),
        "source_title": source_title(date_iso, period),
        "digest_path": rel(source_file), "error": None,
        "last_attempt_at": now_iso(),
    })
    save_manifest(mpath, manifest)
    try:
        notebook_id = _ensure_notebook(manifest)
        manifest["status"] = "notebook_ready"
        save_manifest(mpath, manifest)
        if not manifest.get("source_id"):
            added = run_notebooklm([
                "source", "add", str(source_file), "-n", notebook_id,
                "--title", str(manifest["source_title"]), "--type", "file", "--json",
            ])
            source_id = _pick_notebooklm_id(added, "source_id", "id")
            if not source_id:
                raise RuntimeError(f"could not parse source id from add output: {added!r}")
            manifest.update(source_id=source_id, status="source_uploaded")
            if period == "evening":
                manifest["source_retro_sha256"] = retro_hash
            save_manifest(mpath, manifest)
        prompt = (
            f"Язык озвучки — {UI_LANG_NAME}. Сделай короткое спокойное вечернее "
            "ретро: что закрыто сегодня, что висит и что ждёт ответа."
            if period == "evening" else
            f"Язык озвучки — {UI_LANG_NAME}. Сделай тёплый утренний аудиообзор "
            "готового дайджеста продолжительностью примерно восемь–двенадцать минут. "
            "Равномерно раскрой все содержательные разделы, спокойно, по делу, без "
            "добавления новых фактов."
        )
        # Persist the at-most-one automatic attempt gate before the remote
        # create. If the process dies after NotebookLM accepts the request but
        # before it returns JSON, every ordinary rerun remains a no-op.
        manifest.update({
            "status": "failed",
            "attempts": NBLM_MAX_ATTEMPTS,
            "submission_state": "attempted_no_ack",
            "retry_disposition": "force_required",
            "local_delivery_status": "not_acknowledged",
            "remote_status": "unknown_before_ack",
            "error": "NotebookLM submission attempted; ACK not yet persisted",
            "last_attempt_at": now_iso(),
        })
        save_manifest(mpath, manifest)
        generated = run_notebooklm([
            "generate", "audio", "-n", notebook_id, "-s", str(manifest["source_id"]),
            "--format", "brief" if period == "evening" else AUDIO_FORMAT,
            "--length", "short" if period == "evening" else AUDIO_LENGTH,
            "--language", AUDIO_LANG, "--no-wait", "--json", prompt,
        ])
        submission_id, submission_id_kind = _pick_notebooklm_submission(generated)
        if not submission_id:
            raise RuntimeError("audio submission returned no task/artifact id")
        manifest.update({
            "status": "completed",
            "artifact_id": submission_id,
            "submission_id": submission_id,
            "submission_id_kind": submission_id_kind,
            "submission_state": "acknowledged",
            "retry_disposition": "terminal",
            "local_delivery_status": "accepted",
            "remote_status": "untracked_after_ack",
            "error": None,
        })
        if period == "evening":
            manifest["artifact_retro_sha256"] = retro_hash
        save_manifest(mpath, manifest)
        log(
            f"{date_iso}: NotebookLM accepted submission={submission_id} "
            "remote_status=untracked_after_ack"
        )
        print(f"accepted: notebook={notebook_id} task={submission_id}")
        return 0
    except Exception as exc:  # noqa: BLE001
        manifest.update({
            "status": "failed",
            "attempts": NBLM_MAX_ATTEMPTS,
            "retry_disposition": "force_required",
            "local_delivery_status": "not_acknowledged",
            "remote_status": (
                "unknown_before_ack"
                if manifest.get("submission_state") == "attempted_no_ack"
                else "not_submitted"
            ),
            "error": str(exc),
            "last_attempt_at": now_iso(),
        })
        manifest.setdefault("submission_state", "not_attempted")
        save_manifest(mpath, manifest)
        log(f"{date_iso}: NotebookLM terminal one-shot failure: {exc}")
        print(f"NotebookLM terminal one-shot failure (use --force to retry): {exc}")
        return 0



# ---------------------------------------------------------------------------
# Local Qwen render + Telegram delivery
# ---------------------------------------------------------------------------

URL_RE = re.compile(r"(?i)\bhttps?://\S+")
MARKDOWN_LINK_RE = re.compile(r"!?\[([^\]]+)\]\([^)]+\)")
WIKI_LINK_RE = re.compile(r"\[\[([^\]]+)\]\]")
VALID_STATUSES = {
    "started", "report_ready", "tts_rendered", "telegram_sending",
    "telegram_failed", "telegram_ambiguous", "completed", "unavailable", "failed",
}
VALID_DISPOSITIONS = {"retryable", "terminal", "force_required"}


def file_sha256(path: pathlib.Path) -> str:
    import hashlib
    h = hashlib.sha256()
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def speech_from_digest(body: str) -> str:
    """Deterministic Markdown cleanup for the trusted finalized private daily."""

    def visible_wiki(match: re.Match[str]) -> str:
        inner = match.group(1).strip()
        if "|" in inner:
            left, right = (part.strip() for part in inner.split("|", 1))
            left_target = "/" in left or left.lower().endswith(".md")
            right_target = "/" in right or right.lower().endswith(".md")
            if left_target and not right_target:
                return right
            if right_target and not left_target:
                return left
            return right  # Obsidian's conventional [[target|visible label]].
        target = inner.split("#", 1)[0].rstrip("/")
        visible = target.rsplit("/", 1)[-1]
        if visible.lower().endswith(".md"):
            visible = visible[:-3]
        return visible.replace("-", " ").replace("_", " ")

    text = WIKI_LINK_RE.sub(visible_wiki, body)
    text = MARKDOWN_LINK_RE.sub(r"\1", text)
    text = URL_RE.sub("", text)
    text = re.sub(r"(?m)^\s{0,3}#{1,6}\s*", "", text)
    text = re.sub(r"(?m)^\s*[-*+]\s+", "", text)
    text = re.sub(r"(?m)^\s*\d+[.)]\s+", "", text)
    text = re.sub(r"[*_`~]", "", text)
    text = re.sub(r"(?m)^\s*>\s?", "", text)
    text = re.sub(r"[ \t]+", " ", text)
    text = re.sub(r"\n{3,}", "\n\n", text).strip()
    if not text:
        raise ValueError("speech text is empty after cleanup")
    return text + "\n"


def canonical_artifacts(date_iso: str, period: str) -> dict[str, pathlib.Path]:
    return {
        "report": digest_path(date_iso, period),
        "speech": speech_path(date_iso, period),
        "audio": audio_path(date_iso, period),
    }


def fresh_manifest(date_iso: str, period: str, legacy: dict[str, Any] | None = None) -> dict[str, Any]:
    paths = canonical_artifacts(date_iso, period)
    manifest: dict[str, Any] = {
        "delivery": DELIVERY_TAG,
        "date": date_iso,
        "period": period,
        "status": "started",
        "retry_disposition": "retryable",
        "failed_stage": None,
        "attempts": {"build": 0, "tts": 0, "telegram": 0, "total": 0},
        "caps": dict(ATTEMPT_CAPS),
        "report_path": rel(paths["report"]),
        "speech_path": rel(paths["speech"]),
        "audio_path": rel(paths["audio"]),
        "speech_sha256": None,
        "audio_sha256": None,
        "telegram": None,
        "error": None,
        "updated_at": now_iso(),
    }
    if legacy:
        manifest["legacy"] = legacy
    return manifest


def _legacy_diagnostics(raw: dict[str, Any]) -> dict[str, Any]:
    keys = ("status", "attempts", "notebook_id", "source_id", "artifact_id", "error")
    return {key: raw.get(key) for key in keys if key in raw}


def load_local_manifest(path: pathlib.Path, date_iso: str, period: str,
                        force: bool) -> tuple[dict[str, Any], bool]:
    """Return manifest and whether this invocation must stop fail-closed."""
    if not path.is_file():
        return fresh_manifest(date_iso, period), False
    try:
        raw = json.loads(path.read_text(encoding="utf-8"))
        if not isinstance(raw, dict):
            raise ValueError("manifest root is not an object")
    except Exception as exc:  # noqa: BLE001
        stamp = dt.datetime.now().strftime("%Y%m%dT%H%M%S")
        corrupt = path.with_name(path.name + f".corrupt-{stamp}")
        os.replace(path, corrupt)
        os.chmod(corrupt, 0o600)
        manifest = fresh_manifest(date_iso, period)
        manifest.update({
            "status": "failed", "failed_stage": "manifest",
            "retry_disposition": "force_required",
            "error": f"manifest parse failed; preserved as {corrupt.name}: {str(exc)[:240]}",
            "updated_at": now_iso(),
        })
        save_manifest(path, manifest)
        if force:
            manifest = fresh_manifest(date_iso, period, {"corrupt_file": corrupt.name})
            save_manifest(path, manifest)
            return manifest, False
        return manifest, True
    if period == "evening" and raw.get("status") == "blocked_invalid_retro":
        manifest = fresh_manifest(date_iso, period)
        previous_attempt = raw.get("previous_attempt")
        if isinstance(previous_attempt, dict):
            manifest["previous_attempt"] = previous_attempt
        save_manifest(path, manifest)
        return manifest, False
    if raw.get("delivery") != DELIVERY_TAG:
        manifest = fresh_manifest(date_iso, period, _legacy_diagnostics(raw))
        save_manifest(path, manifest)
        return manifest, False
    return raw, False


def _paths_match(manifest: dict[str, Any], date_iso: str, period: str) -> bool:
    paths = canonical_artifacts(date_iso, period)
    return (
        manifest.get("report_path") == rel(paths["report"])
        and manifest.get("speech_path") == rel(paths["speech"])
        and manifest.get("audio_path") == rel(paths["audio"])
    )


def _manifest_semantics_valid(manifest: dict[str, Any]) -> bool:
    status = manifest.get("status")
    disposition = manifest.get("retry_disposition")
    if status not in VALID_STATUSES or disposition not in VALID_DISPOSITIONS:
        return False
    expected = {
        "started": "retryable",
        "report_ready": "retryable",
        "tts_rendered": "retryable",
        "telegram_sending": "retryable",
        "telegram_failed": "retryable",
        "telegram_ambiguous": "force_required",
        "completed": "terminal",
        "unavailable": "terminal",
    }
    if status != "failed":
        expected_stage = {
            "telegram_failed": "telegram",
            "telegram_ambiguous": "telegram",
        }.get(status)
        if status == "unavailable":
            stage_valid = manifest.get("failed_stage") in ("tts", "telegram")
        else:
            stage_valid = manifest.get("failed_stage") == expected_stage
        return disposition == expected.get(status) and stage_valid

    stage = manifest.get("failed_stage")
    if stage in ("integrity", "manifest"):
        return disposition == "force_required"
    if stage not in ("build", "tts", "telegram"):
        return False

    attempts = manifest.get("attempts")
    caps = manifest.get("caps")
    if not isinstance(attempts, dict) or caps != ATTEMPT_CAPS:
        return False
    for key in ("build", "tts", "telegram", "total"):
        value = attempts.get(key)
        if isinstance(value, bool) or not isinstance(value, int) or value < 0:
            return False
    at_cap = attempts[stage] >= caps[stage] or attempts["total"] >= caps["total"]
    return disposition == ("terminal" if at_cap else "retryable")


def _speech_valid(manifest: dict[str, Any], date_iso: str, period: str) -> bool:
    paths = canonical_artifacts(date_iso, period)
    expected = manifest.get("speech_sha256")
    return bool(
        _paths_match(manifest, date_iso, period)
        and paths["report"].is_file()
        and paths["speech"].is_file()
        and expected
        and file_sha256(paths["speech"]) == expected
    )


def _audio_valid(manifest: dict[str, Any], date_iso: str, period: str) -> bool:
    audio = canonical_artifacts(date_iso, period)["audio"]
    expected = manifest.get("audio_sha256")
    return bool(audio.is_file() and audio.stat().st_size and expected and file_sha256(audio) == expected)


def _append_failure_log(date_iso: str, period: str, manifest: dict[str, Any]) -> None:
    error = str(manifest.get("error") or "unknown failure")[:400]
    log(f"{date_iso} {period}: {manifest.get('status')} stage={manifest.get('failed_stage')} "
        f"disposition={manifest.get('retry_disposition')}: {error}")
    try:
        with HUB_LOG.open("a", encoding="utf-8") as f:
            f.write(
                f"\n## [{date_iso}] digest | hub | \"{period} local audio "
                f"{manifest.get('status')} ({manifest.get('retry_disposition')}): {error}\"\n"
            )
    except OSError:
        pass


def _set_integrity_failure(mpath: pathlib.Path, manifest: dict[str, Any],
                           date_iso: str, period: str, error: str) -> int:
    manifest.update({
        "status": "failed", "failed_stage": "integrity",
        "retry_disposition": "force_required", "error": error[:400],
        "updated_at": now_iso(),
    })
    save_manifest(mpath, manifest)
    _append_failure_log(date_iso, period, manifest)
    return 0


def _cap_reached(manifest: dict[str, Any], stage: str) -> bool:
    attempts = manifest.setdefault("attempts", {"build": 0, "tts": 0, "telegram": 0, "total": 0})
    caps = manifest.setdefault("caps", dict(ATTEMPT_CAPS))
    return int(attempts.get(stage, 0)) >= int(caps[stage]) or int(attempts.get("total", 0)) >= int(caps["total"])


def _block_at_cap(mpath: pathlib.Path, manifest: dict[str, Any], stage: str,
                  date_iso: str, period: str) -> bool:
    if not _cap_reached(manifest, stage):
        return False
    manifest.update({
        "status": "failed", "failed_stage": stage,
        "retry_disposition": "terminal",
        "error": f"{stage} attempt cap reached; no further external calls",
        "updated_at": now_iso(),
    })
    save_manifest(mpath, manifest)
    _append_failure_log(date_iso, period, manifest)
    return True


def _begin_attempt(mpath: pathlib.Path, manifest: dict[str, Any], stage: str,
                   status: str) -> None:
    attempts = manifest["attempts"]
    attempts[stage] = int(attempts.get(stage, 0)) + 1
    attempts["total"] = int(attempts.get("total", 0)) + 1
    manifest.update({"status": status, "failed_stage": None, "error": None,
                     "updated_at": now_iso()})
    save_manifest(mpath, manifest)


def _stage_failed(mpath: pathlib.Path, manifest: dict[str, Any], stage: str,
                  date_iso: str, period: str, error: str,
                  status: str = "failed") -> int:
    terminal = _cap_reached(manifest, stage)
    manifest.update({
        "status": "failed" if terminal else status,
        "failed_stage": stage,
        "retry_disposition": "terminal" if terminal else "retryable",
        "error": error[:400], "updated_at": now_iso(),
    })
    save_manifest(mpath, manifest)
    _append_failure_log(date_iso, period, manifest)
    return 0 if terminal else 1


def _run_child(argv: list[str], timeout: int) -> subprocess.CompletedProcess[str]:
    """Run one bounded child and forward TERM/INT so renderer can reap workers."""
    proc = subprocess.Popen(argv, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    previous: dict[int, Any] = {}

    def forward(signum, _frame):
        try:
            proc.send_signal(signum)
            proc.wait(timeout=20)
        except Exception:  # noqa: BLE001
            try:
                proc.kill()
            except OSError:
                pass
        raise SystemExit(128 + signum)

    for sig in (signal.SIGTERM, signal.SIGINT):
        previous[sig] = signal.getsignal(sig)
        signal.signal(sig, forward)
    try:
        try:
            stdout, stderr = proc.communicate(timeout=timeout)
        except subprocess.TimeoutExpired:
            proc.terminate()
            try:
                stdout, stderr = proc.communicate(timeout=20)
            except subprocess.TimeoutExpired:
                proc.kill()
                stdout, stderr = proc.communicate()
            return subprocess.CompletedProcess(argv, 124, stdout, stderr)
        return subprocess.CompletedProcess(argv, proc.returncode, stdout, stderr)
    finally:
        for sig, handler in previous.items():
            signal.signal(sig, handler)


def _tts_alert_marker(date_iso: str, period: str) -> pathlib.Path:
    return ORCH / "alerts" / f"{date_iso}-{period}.tts-alert-sent"


def _send_tts_alert(date_iso: str, period: str, manifest: dict[str, Any]) -> None:
    """Owner-visible one-line Telegram alert on terminal TTS failure.

    Dedup: a per date+period marker file that survives fresh_manifest();
    ordering is send-then-mark (a crash between them may duplicate the alert,
    never suppress it). Best-effort: failures only log, never change state.
    """
    marker = _tts_alert_marker(date_iso, period)
    if marker.exists():
        return
    sender = HUB / "bin" / "kb-channel-send"
    if not sender.is_file() or not os.access(sender, os.X_OK):
        log(f"{date_iso} {period}: tts alert skipped (kb-channel-send unavailable)")
        return
    reason = str(manifest.get("error") or "unknown failure")[:200]
    engine = "unknown"
    try:
        probe = subprocess.run(
            [str(HUB / "bin" / "kb-tts-render"), "--check"],
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, timeout=30,
        )
        data = json.loads((probe.stdout or "").strip() or "{}")
        if isinstance(data, dict) and data.get("engine"):
            engine = str(data["engine"])
    except Exception:  # noqa: BLE001 — engine name is cosmetic in the alert
        pass
    extra = (
        "; продление моста: kb-tts-engine extend-bridge --days N --reason ..."
        if "bridge expired" in reason else ""
    )
    text = (
        f"Озвучка дайджеста упала ({engine}): {reason}. Текст сохранён. "
        f"Откат: kb-tts-engine set qwen; повтор: kb-morning-digest --force{extra}"
    )
    try:
        proc = subprocess.run(
            [str(sender), "tts_failure_alert", text],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=60,
        )
        if proc.returncode != 0:
            log(f"{date_iso} {period}: tts alert send failed rc={proc.returncode}")
            return
        marker.parent.mkdir(parents=True, exist_ok=True)
        os.close(os.open(marker, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600))
    except FileExistsError:
        pass
    except Exception as exc:  # noqa: BLE001
        log(f"{date_iso} {period}: tts alert failed: {exc}")


def _tts_unavailable(date_iso: str, period: str, mpath: pathlib.Path,
                     manifest: dict[str, Any], reason: str) -> int:
    manifest.update({
        "status": "unavailable", "failed_stage": "tts",
        "retry_disposition": "terminal",
        "error": reason[:400], "updated_at": now_iso(),
    })
    save_manifest(mpath, manifest)
    _append_failure_log(date_iso, period, manifest)
    _send_tts_alert(date_iso, period, manifest)
    return 0


def render_local_audio(date_iso: str, period: str, mpath: pathlib.Path,
                       manifest: dict[str, Any]) -> int | None:
    paths = canonical_artifacts(date_iso, period)
    renderer = HUB / "bin" / "kb-tts-render"
    if not renderer.is_file() or not os.access(renderer, os.X_OK):
        return _tts_unavailable(
            date_iso, period, mpath, manifest,
            "tts renderer unavailable; run kb-tts-install",
        )
    # Engine-agnostic local-readiness gate: the renderer owns engine selection
    # and runtime checks; the digest only consumes the ready/unavailable verdict.
    check = _run_child([str(renderer), "--check"], 60)
    if check.returncode != 0:
        reason = ""
        try:
            data = json.loads((check.stdout or "").strip() or "{}")
            if isinstance(data, dict):
                reason = str(data.get("error") or "")
        except ValueError:
            pass
        if not reason:
            reason = (check.stderr or check.stdout
                      or f"tts engine check failed rc={check.returncode}").strip()
        return _tts_unavailable(date_iso, period, mpath, manifest, reason)
    if _block_at_cap(mpath, manifest, "tts", date_iso, period):
        _send_tts_alert(date_iso, period, manifest)
        return 0
    _begin_attempt(mpath, manifest, "tts", "report_ready")
    voice = (
        f"Speak as a calm, natural native {UI_LANG_NAME} narrator. "
        "Read the supplied text literally, clearly, and without adding content."
    )
    proc = _run_child([
        str(renderer), "--file", str(paths["speech"]), "--out", str(paths["audio"]),
        "--language", UI_LANG_NAME, "--voice-instruct", voice,
    ], TTS_TIMEOUT)
    if proc.returncode == 3:
        # Unavailable surfaced only at render time (e.g. the bridge expired
        # between check and render): refund the begun attempt exactly — this
        # failure class is not retryable, so it must not consume the budget.
        attempts = manifest["attempts"]
        attempts["tts"] = max(0, int(attempts.get("tts", 1)) - 1)
        attempts["total"] = max(0, int(attempts.get("total", 1)) - 1)
        err = (proc.stderr or proc.stdout or "renderer unavailable (exit 3)").strip()
        return _tts_unavailable(date_iso, period, mpath, manifest, err)
    if proc.returncode != 0 or not paths["audio"].is_file() or not paths["audio"].stat().st_size:
        try:
            paths["audio"].unlink()
        except OSError:
            pass
        err = (proc.stderr or proc.stdout or f"renderer rc={proc.returncode}").strip()
        rc = _stage_failed(mpath, manifest, "tts", date_iso, period, err)
        if manifest.get("retry_disposition") == "terminal":
            _send_tts_alert(date_iso, period, manifest)
        return rc
    os.chmod(paths["audio"], 0o600)
    manifest.update({
        "status": "tts_rendered", "retry_disposition": "retryable",
        "failed_stage": None, "audio_sha256": file_sha256(paths["audio"]),
        "error": None, "updated_at": now_iso(),
    })
    save_manifest(mpath, manifest)
    return None


def send_local_audio(date_iso: str, period: str, mpath: pathlib.Path,
                     manifest: dict[str, Any]) -> int:
    paths = canonical_artifacts(date_iso, period)
    sender = HUB / "bin" / "kb-channel-send-audio"
    if not sender.is_file() or not os.access(sender, os.X_OK):
        manifest.update({
            "status": "unavailable", "failed_stage": "telegram",
            "retry_disposition": "terminal",
            "error": "kb-channel-send-audio is unavailable; repair the installation",
            "updated_at": now_iso(),
        })
        save_manifest(mpath, manifest)
        _append_failure_log(date_iso, period, manifest)
        return 0
    if _block_at_cap(mpath, manifest, "telegram", date_iso, period):
        return 0
    _begin_attempt(mpath, manifest, "telegram", "telegram_sending")
    if period == "evening":
        caption = f"Вечернее ретро — {date_iso}"
        message_type = "evening_digest_audio"
    else:
        caption = f"Утренний дайджест — {date_iso}"
        message_type = "morning_digest_audio"
    proc = _run_child([str(sender), message_type, str(paths["audio"]), caption], TELEGRAM_TIMEOUT)
    try:
        result = json.loads((proc.stdout or "").strip())
    except Exception:  # noqa: BLE001
        result = {}
    if proc.returncode == 0 and result.get("outcome") == "success" \
            and _positive_message_id(result.get("message_id")):
        audio_meta = result.get("audio")
        if not isinstance(audio_meta, dict) or not all(
            key in audio_meta for key in ("file_id", "file_unique_id", "duration")
        ):
            proc = subprocess.CompletedProcess(proc.args, 21, proc.stdout, proc.stderr)
        else:
            manifest.update({
                "status": "completed", "retry_disposition": "terminal",
                "failed_stage": None,
                "telegram": {"message_id": result.get("message_id"), "audio": audio_meta},
                "error": None, "updated_at": now_iso(),
            })
            save_manifest(mpath, manifest)
            log(f"{date_iso} {period}: local Qwen MP3 sent; message_id={result.get('message_id')}")
            return 0
    error = str(result.get("error") or proc.stderr or f"sender rc={proc.returncode}")[:400]
    if proc.returncode == 20 and result.get("outcome") == "known_rejection":
        return _stage_failed(
            mpath, manifest, "telegram", date_iso, period, error, "telegram_failed",
        )
    manifest.update({
        "status": "telegram_ambiguous", "failed_stage": "telegram",
        "retry_disposition": "force_required", "error": error,
        "updated_at": now_iso(),
    })
    save_manifest(mpath, manifest)
    _append_failure_log(date_iso, period, manifest)
    return 0


def render_and_send(date_iso: str, period: str, mpath: pathlib.Path,
                    manifest: dict[str, Any], rerender: bool) -> int:
    if rerender:
        rc = render_local_audio(date_iso, period, mpath, manifest)
        if rc is not None:
            return rc
    return send_local_audio(date_iso, period, mpath, manifest)


# ---------------------------------------------------------------------------
# Hub log line
# ---------------------------------------------------------------------------

def append_hub_log(date_iso: str, source_file: pathlib.Path, manifest: dict[str, Any],
                   period: str = "morning") -> None:
    status = manifest.get("status", "unknown")
    message_id = (manifest.get("telegram") or {}).get("message_id") or "—"
    label = "Вечернее ретро" if period == "evening" else "Утренний дайджест"
    line = (
        f"\n## [{date_iso}] digest | hub | "
        f"\"{label} → local Qwen/Telegram ({status}); "
        f"файл {rel(source_file)}; message_id {message_id}\"\n"
    )
    try:
        with HUB_LOG.open("a", encoding="utf-8") as f:
            f.write(line)
    except Exception as exc:  # noqa: BLE001
        log(f"{date_iso}: hub log append failed: {exc}")


# ---------------------------------------------------------------------------
# Concurrency lock
# ---------------------------------------------------------------------------

def acquire_lock(date_iso: str, period: str = "morning"):
    """Per-(date, period) advisory flock so a manual run (e.g. ``--force``) and
    the scheduled kb-tick run never both render/send audio for the same day.
    The manifest guards sequential retries; flock guards concurrent effects. Non-blocking: a
    contender that cannot take the lock skips cleanly. Auto-released on process
    exit/kill, so a kb-tick timeout-kill never leaves a stale lock. Matches the
    kb-money-radar / kb-daily-research convention."""
    ORCH.mkdir(parents=True, exist_ok=True)
    fh = open(ORCH / f"{period}-digest-{date_iso}.lock", "w")
    try:
        fcntl.flock(fh.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        fh.close()
        return None
    return fh


# ---------------------------------------------------------------------------
# Background runtime guard (spec D4, defense in depth)
# ---------------------------------------------------------------------------

# Scheduled runs may reach local TTS/Telegram only as one of these process ids launched
# with EXACTLY this argv. kb-tick execs the configured `run` command with no
# extra argv, so a legitimate scheduled run compares equal after basename
# normalization of argv[0]. The config validator in _kb_processes is the first
# gate; this in-process guard also catches a scheduled caller that OMITS
# telegram_audio from its declared outputs (invisible to that validator).
BACKGROUND_ALLOWLIST = {
    "morning-digest": ["kb-morning-digest"],
    "evening-digest": ["kb-morning-digest", "--period", "evening"],
}


def background_push_denied() -> str | None:
    """Return why a background invocation must stay file-only, or None when the
    local audio delivery is allowed."""
    process_id = os.environ.get("KB_PROCESS_ID")
    background = os.environ.get("KB_PROCESS_BACKGROUND")
    if process_id is None and background is None:
        return None
    if process_id is None:
        return "KB_PROCESS_BACKGROUND is set without KB_PROCESS_ID"
    if not process_id:
        # Set-but-empty can only be a misconfiguration (kb-tick always sets a
        # real id); ambiguity resolves to denied, not manual.
        return "KB_PROCESS_ID is set but empty"
    allowed_argv = BACKGROUND_ALLOWLIST.get(process_id)
    if allowed_argv is None:
        return f"process id {process_id!r} is not audio-allowlisted"
    argv = [os.path.basename(sys.argv[0])] + sys.argv[1:]
    if argv != allowed_argv:
        return f"argv {argv!r} does not match the allowlisted command for {process_id!r}"
    return None


def selected_audio_channels() -> list[str]:
    """Return every independently enabled audio channel.

    Manual test runs keep the already shipped local-Qwen behavior. Production
    scheduled runs read the normalized true flags from KB_PROCESS_OUTPUTS.
    """
    if os.environ.get("KB_PROCESS_ID") is None:
        return ["telegram_audio"]
    outputs = [o.strip() for o in os.environ.get("KB_PROCESS_OUTPUTS", "").split(",")]
    return [
        channel for channel in ("telegram_audio", "notebooklm_audio")
        if channel in outputs
    ]


def build_ready_digest(
    date_iso: str, period: str, digest_file: pathlib.Path | None,
    morning_input: dict[str, Any] | None = None,
    evening_retro: ParsedRetro | None = None,
) -> tuple[dict[str, pathlib.Path], str, str | None]:
    """Generate the report once and freeze the exact text passed to adapters.

    Returns `(paths, source, error)`. On success `paths["speech"]` is the one
    byte-identical adapter input for both NotebookLM and local Qwen.
    """
    if period == "evening":
        blocks = gather_evening(date_iso, evening_retro)
    else:
        if morning_input is None:
            morning_input = capture_morning_input(date_iso)
        blocks = morning_input["blocks"]

    if digest_file is not None:
        digest_body = digest_file.read_text(encoding="utf-8").strip("\r\n")
        source = "digest-file"
    elif period == "evening":
        digest_body = "\n\n".join(b["text"].strip() for b in blocks if b.get("text"))
        source = "missing-retro" if "## Evening retro missing" in digest_body else "retro-block"
    else:
        digest_body = assemble_finalized_morning(blocks)
        source = "whole-finalized-blocks"

    paths = canonical_artifacts(date_iso, period)
    file_content = render_source_file(date_iso, digest_body, blocks, period)
    atomic_write(paths["report"], file_content)
    log(f"{date_iso}: wrote {rel(paths['report'])} ({source}, {len(file_content)} chars)")
    print(f"wrote {paths['report']} ({source})")
    if source == "missing-retro":
        return paths, source, (
            "trusted evening Retro block is missing; report-only"
        )
    if period == "morning" and not digest_body:
        return paths, source, "no finalized same-day morning blocks; report-only"
    try:
        speech = speech_from_digest(digest_body)
    except ValueError as exc:
        return paths, source, str(exc)
    atomic_write(paths["speech"], speech)
    return paths, source, None


def run_notebooklm_route(
    date_iso: str, period: str, digest_file: pathlib.Path | None,
    out_path: pathlib.Path, mpath: pathlib.Path, force: bool,
    evening_retro: ParsedRetro | None = None,
    prepared: bool = False,
) -> int:
    """Send the canonical speech file to NotebookLM, building it when needed."""
    existing = (
        _load_raw_manifest(mpath)
        if period == "evening" else load_notebooklm_manifest(mpath)
    )
    already_done = (
        evening_retro is not None
        and evening_notebooklm_already_done(existing, evening_retro.sha256)
        if period == "evening" else
        existing.get("status") == "completed" and bool(existing.get("artifact_id"))
    )
    if not force and already_done:
        print(f"already accepted for {date_iso}: submission={existing.get('artifact_id')}")
        return 0

    if prepared:
        paths = canonical_artifacts(date_iso, period)
        source, build_error = "shared-build", None
        if not paths["report"].is_file() or not paths["speech"].is_file():
            build_error = "shared speech file is unavailable"
    else:
        paths, source, build_error = build_ready_digest(
            date_iso, period, digest_file, evening_retro=evening_retro,
        )
    if paths["report"] != out_path:
        raise RuntimeError("NotebookLM delivery requires the canonical report path")
    if build_error is not None:
        log(f"{date_iso}: {source} remains report-only: {build_error}")
        return 1
    # NotebookLM and Qwen receive the same frozen text bytes. NotebookLM keeps
    # its Audio Overview remotely; there is no download or Telegram call here.
    rc = push_notebooklm(
        date_iso, paths["speech"], mpath, force, period,
        evening_retro.sha256 if evening_retro is not None else None,
    )
    manifest = load_notebooklm_manifest(mpath)
    submission = manifest.get("submission_id") or manifest.get("artifact_id") or "—"
    delivery = manifest.get("local_delivery_status") or manifest.get("status", "unknown")
    remote = manifest.get("remote_status") or "legacy_unknown"
    label = "Вечернее ретро" if period == "evening" else "Утренний дайджест"
    try:
        with HUB_LOG.open("a", encoding="utf-8") as handle:
            handle.write(
                f"\n## [{date_iso}] digest | hub | \"{label} → NotebookLM "
                f"(local={delivery}, remote={remote}); файл {rel(paths['report'])}; "
                f"submission {submission}\"\n"
            )
    except Exception as exc:  # noqa: BLE001
        log(f"{date_iso}: NotebookLM hub log append failed: {exc}")
    return rc


# ---------------------------------------------------------------------------
# Orchestration
# ---------------------------------------------------------------------------

def run_local_route(
    date_iso: str, period: str, digest_file: pathlib.Path | None,
    mpath: pathlib.Path, force: bool,
    evening_retro: ParsedRetro | None = None,
) -> int:
    """Run the existing local Qwen → Telegram handler."""
    morning_input: dict[str, Any] | None = None

    # Telegram completion is terminal only for the Telegram handler. It must not
    # suppress another independently enabled channel.
    if not force:
        guard, evidence = morning_delivery_guard(mpath, date_iso, period)
        if guard == "completed":
            print(f"already completed for {date_iso}: {evidence}")
            return 0
        if guard == "invalid":
            mark_completion_integrity_failure(
                mpath, evidence or "invalid completed delivery evidence",
            )
            log(f"{date_iso} {period}: invalid completed delivery evidence; --force required")
            print("invalid completed delivery evidence; --force required")
            return 0

    manifest, blocked = load_local_manifest(mpath, date_iso, period, force)
    if blocked:
        _append_failure_log(date_iso, period, manifest)
        return 0

    if force:
        # Explicit owner recovery must be able to replace even a locally
        # corrupted semantic/counter schema.  Reuse only independently
        # hash-verified canonical speech; never trust attempts/caps/state.
        reusable_speech = _speech_valid(manifest, date_iso, period)
        legacy = manifest.get("legacy") if isinstance(manifest.get("legacy"), dict) else None
        manifest = fresh_manifest(date_iso, period, legacy)
        if reusable_speech:
            paths = canonical_artifacts(date_iso, period)
            manifest.update({
                "status": "report_ready",
                "speech_sha256": file_sha256(paths["speech"]),
                "updated_at": now_iso(),
            })
            save_manifest(mpath, manifest)
            return render_and_send(date_iso, period, mpath, manifest, True)
    else:
        # Exact schema/caps are persisted invariants, not ambient
        # configuration.  Without explicit force, corruption fails closed
        # before gather, TTS or Telegram.
        attempts = manifest.get("attempts")
        caps = manifest.get("caps")
        if (not isinstance(attempts, dict) or caps != ATTEMPT_CAPS
                or not _manifest_semantics_valid(manifest) or any(
            isinstance(attempts.get(key), bool)
            or not isinstance(attempts.get(key), int) or attempts.get(key) < 0
            for key in ("build", "tts", "telegram", "total")
        )):
            return _set_integrity_failure(
                mpath, manifest, date_iso, period,
                "invalid attempts/caps manifest schema",
            )

        status = manifest.get("status")
        disposition = manifest.get("retry_disposition")
        if status == "telegram_sending":
            manifest.update({
                "status": "telegram_ambiguous", "failed_stage": "telegram",
                "retry_disposition": "force_required",
                "error": "previous run stopped after Telegram transmission may have begun",
                "updated_at": now_iso(),
            })
            save_manifest(mpath, manifest)
            _append_failure_log(date_iso, period, manifest)
            return 0
        if status == "completed":
            message_id = (manifest.get("telegram") or {}).get("message_id")
            if not _positive_message_id(message_id):
                return _set_integrity_failure(
                    mpath, manifest, date_iso, period,
                    "completed manifest is missing telegram.message_id",
                )
            # A completed morning delivery is terminal for its date across
            # legacy v1/v2 and v3 snapshots. Same-day input drift never
            # causes an automatic resend; only explicit owner --force can.
            print(f"already completed for {date_iso}: message_id={message_id}")
            return 0
        if disposition in ("terminal", "force_required") or status in (
            "unavailable", "telegram_ambiguous",
        ):
            print(f"delivery state {status}/{disposition}; --force required for recovery")
            return 0
        failed_stage = manifest.get("failed_stage")
        if status == "failed" and failed_stage in ("build", "tts", "telegram"):
            if _block_at_cap(mpath, manifest, failed_stage, date_iso, period):
                return 0
        if status == "report_ready" or (status == "failed" and failed_stage == "tts"):
            if not _speech_valid(manifest, date_iso, period):
                return _set_integrity_failure(
                    mpath, manifest, date_iso, period,
                    "stored report/speech path or speech hash failed validation",
                )
            return render_and_send(date_iso, period, mpath, manifest, True)
        if status in ("tts_rendered", "telegram_failed") or (
            status == "failed" and failed_stage == "telegram"
        ):
            if not _speech_valid(manifest, date_iso, period):
                return _set_integrity_failure(
                    mpath, manifest, date_iso, period,
                    "stored report/speech path or speech hash failed validation",
                )
            return render_and_send(
                date_iso, period, mpath, manifest, not _audio_valid(manifest, date_iso, period)
            )

    if period == "morning" and morning_input is None:
        morning_input = capture_morning_input(date_iso)
    if morning_input is not None:
        manifest["upstream_snapshot"] = morning_input["upstream_snapshot"]

    if _block_at_cap(mpath, manifest, "build", date_iso, period):
        return 0
    _begin_attempt(mpath, manifest, "build", "started")

    paths = canonical_artifacts(date_iso, period)
    for stale in (paths["speech"], paths["audio"]):
        try:
            stale.unlink()
        except OSError:
            pass

    paths, source, build_error = build_ready_digest(
        date_iso, period, digest_file, morning_input, evening_retro,
    )
    if build_error is not None:
        return _stage_failed(
            mpath, manifest, "build", date_iso, period, build_error,
        )
    manifest.update({
        "status": "report_ready", "retry_disposition": "retryable",
        "failed_stage": None, "speech_sha256": file_sha256(paths["speech"]),
        "audio_sha256": None, "telegram": None, "error": None,
        "updated_at": now_iso(),
    })
    save_manifest(mpath, manifest)
    rc = render_and_send(date_iso, period, mpath, manifest, True)
    if manifest.get("status") == "completed":
        append_hub_log(date_iso, paths["report"], manifest, period)
    return rc



def run(date_iso: str, *, period: str, digest_file: pathlib.Path | None,
        out: pathlib.Path | None, no_push: bool, force: bool,
        notebooklm_only: bool = False) -> int:
    out_path = out or digest_path(date_iso, period)
    mpath = manifest_path(date_iso, period)
    evening_retro: ParsedRetro | None = None

    # The durable same-day Retro is the first evening authority check. It must
    # precede every completion shortcut, report/speech write, attempt counter,
    # adapter selection and remote call; CLI/background modes cannot bypass it.
    if period == "evening":
        evening_retro = load_retro(HUB, date_iso)
        if evening_retro is None:
            # Preview and explicit file-only runs validate the canonical Retro
            # but never mutate canonical delivery state.
            if out is None and not no_push:
                block_invalid_evening_retro(mpath, date_iso)
                block_invalid_evening_retro(
                    notebooklm_manifest_path(date_iso, period), date_iso,
                )
            log(f"{date_iso}: current durable Retro is missing or invalid; retry")
            print("current durable Retro is missing or invalid; retry after kb-retro")
            return RC_INVALID_RETRO

    # Deterministic test seam. Morning emits the exact finalized whole-block
    # assembly before Markdown-to-speech normalization. Evening keeps its
    # trusted Retro packet. No lock, agent, adapter, or Telegram call occurs.
    if os.environ.get("KB_DIGEST_PROMPT_ONLY") == "1":
        if period == "evening":
            context = build_evening_context_packet(
                date_iso, gather_evening(date_iso, evening_retro),
            )
            sys.stdout.write(context)
        else:
            captured = capture_morning_input(date_iso)
            context = assemble_finalized_morning(captured["blocks"])
            sys.stdout.write(context)
        if not context.endswith("\n"):
            sys.stdout.write("\n")
        return 0

    # Real canonical runs take a per-date,
    # per-period lock. Preview runs (--out to a scratch path) touch neither, so
    # they skip it.
    lock_fh = None
    if out is None:
        lock_fh = acquire_lock(date_iso, period)
        if lock_fh is None:
            # Not done — signal retry so kb-tick re-fires next tick instead of
            # marking the day complete on the strength of someone else's lock.
            log(f"{date_iso}: another {period}-digest run holds the lock; "
                f"skipping (rc={RC_LOCK_CONTENTION}, retry next tick)")
            print(f"another {period}-digest run is in progress; "
                  "skipping (will retry next tick)")
            return RC_LOCK_CONTENTION

    try:
        denied = background_push_denied()
        channels = (
            ["notebooklm_audio"]
            if notebooklm_only and not no_push and out is None
            else selected_audio_channels() if not no_push and out is None else []
        )
        delivery_enabled = not no_push and out is None and denied is None and bool(channels)
        morning_input: dict[str, Any] | None = None

        # Compatibility/file-only paths deliberately do not inspect or mutate
        # the delivery manifest and can never resume an external effect.
        if not delivery_enabled:
            # Preserve completed local artifacts on denied/file-only reruns.
            # This guard is intentionally inside the no-delivery branch so it
            # cannot suppress another independently enabled channel.
            if out is None and not force:
                guard, evidence = morning_delivery_guard(mpath, date_iso, period)
                if guard == "completed":
                    print(f"already completed for {date_iso}: {evidence}")
                    return 0
                if guard == "invalid":
                    mark_completion_integrity_failure(
                        mpath, evidence or "invalid completed delivery evidence",
                    )
                    log(f"{date_iso} {period}: invalid completed delivery evidence; --force required")
                    print("invalid completed delivery evidence; --force required")
                    return 0
            if period == "evening":
                blocks = gather_evening(date_iso, evening_retro)
            else:
                morning_input = capture_morning_input(date_iso)
                blocks = morning_input["blocks"]
            if digest_file is not None:
                digest_body, source = digest_file.read_text(encoding="utf-8").strip("\r\n"), "digest-file"
            elif period == "evening":
                digest_body = "\n\n".join(b["text"].strip() for b in blocks if b.get("text"))
                source = "missing-retro" if "## Evening retro missing" in digest_body else "retro-block"
            else:
                digest_body = assemble_finalized_morning(blocks)
                source = "whole-finalized-blocks"
            file_content = render_source_file(date_iso, digest_body, blocks, period)
            atomic_write(out_path, file_content)
            log(f"{date_iso}: wrote {rel(out_path)} ({source}, {len(file_content)} chars)")
            print(f"wrote {out_path} ({source})")
            # Canonical file-only runs still freeze the exact privacy-gated
            # adapter input for audit/proof. They invoke no audio adapter.
            if out is None and digest_body and source != "missing-retro":
                try:
                    frozen_speech = speech_from_digest(digest_body)
                except ValueError as exc:
                    log(f"{date_iso}: file-only speech gate rejected source: {exc}")
                    return 1
                atomic_write(speech_path(date_iso, period), frozen_speech)
            if denied:
                log(f"{date_iso}: background guard kept run file-only: {denied}")
                print(f"background guard: audio skipped ({denied}); file kept")
            else:
                print("skipped local audio delivery (--no-push/--out)")
            return 0

        notebook_mpath = (
            ensure_notebooklm_manifest(date_iso, period)
            if "notebooklm_audio" in channels else None
        )
        handlers = {
            "telegram_audio": lambda: run_local_route(
                date_iso, period, digest_file, mpath, force, evening_retro,
            ),
            "notebooklm_audio": lambda: run_notebooklm_route(
                date_iso, period, digest_file, out_path, notebook_mpath, force,
                evening_retro=evening_retro,
                prepared=out_path.is_file() and speech_path(date_iso, period).is_file(),
            ),
        }
        retry = False
        for channel in channels:
            if handlers[channel]() != 0:
                retry = True
        return 1 if retry else 0

    finally:
        if lock_fh is not None:
            lock_fh.close()


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Morning/evening digest -> enabled audio channels."
    )
    parser.add_argument("--period", choices=("morning", "evening"), default="morning",
                        help="Which digest to build (default morning).")
    parser.add_argument("--date", default=today_iso(), help="YYYY-MM-DD (default today).")
    parser.add_argument("--digest-file", help="Use this file as the digest body (skip synth).")
    parser.add_argument("--out", help="Write digest to this path instead of the canonical report.")
    parser.add_argument("--no-push", action="store_true", help="Build the report only; skip selected audio delivery.")
    parser.add_argument(
        "--notebooklm", action="store_true",
        help="Manually select only the NotebookLM audio channel.",
    )
    parser.add_argument("--force", action="store_true", help="Regenerate even if manifest completed.")
    args = parser.parse_args()

    if not re.fullmatch(r"\d{4}-\d{2}-\d{2}", args.date):
        print(f"invalid --date: {args.date}", file=sys.stderr)
        return 2

    digest_file = pathlib.Path(args.digest_file).expanduser() if args.digest_file else None
    if digest_file is not None and not digest_file.is_file():
        print(f"--digest-file not found: {digest_file}", file=sys.stderr)
        return 2
    out = pathlib.Path(args.out).expanduser() if args.out else None
    if args.notebooklm and (args.no_push or out is not None):
        parser.error("--notebooklm cannot be combined with --no-push or --out")

    return run(args.date, period=args.period, digest_file=digest_file, out=out,
               no_push=args.no_push, force=args.force,
               notebooklm_only=args.notebooklm)


if __name__ == "__main__":
    sys.exit(main())
