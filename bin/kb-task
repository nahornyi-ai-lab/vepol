#!/usr/bin/env python3
"""kb-task — append a task to a project's kb-board, optionally create a Calendar event.

The task board source of truth is `knowledge/backlog.md` in multiline
`kb-board` format. This wrapper uses `kb-board append`; legacy `kb-backlog`
writers fail fast on migrated boards.

Usage:
  kb-task "task text"                                           # appends to HUB backlog
  kb-task "task text" --project <slug>                          # appends to project's backlog
  kb-task "task text" --due "2026-04-20T14:00"                  # also stamps due:<when> in line
  kb-task "task text" --by hub|user|self                        # who set the task (default: self)
  kb-task "task text" --context "<1-line context>"              # optional context suffix
  kb-task "task text" --due "..." --calendar                    # proposes a follow-up reminder (owner approves)

`--calendar` does NOT write Google Calendar directly. It records a pending
follow-up proposal (via the shared calendar approval gate) and prints the
`kb-followup approve` command; nothing reaches the calendar until the owner
explicitly approves. (Spec: calendar-backed-followups-v1-2026-06-25.)

Task block format is rendered by `kb-board append` under the `## Backlog`
section unless callers promote it to `Ready`.
"""
from __future__ import annotations  # keep PEP 604 (str | None) working on stock macOS python3 (3.9)
import argparse
import os
import pathlib
import subprocess
import sys
import uuid

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

HUB = pathlib.Path(os.environ.get("KB_HUB", os.path.expanduser("~/knowledge")))
KB_BOARD = HUB / "bin" / "kb-board"


def propose_calendar_followup(task: str, when: str, context: str | None) -> None:
    """Create a pending follow-up proposal instead of writing the calendar.

    `--calendar` no longer creates a Google Calendar event directly. All
    calendar writes go through the shared approval gate: this records a pending
    proposal and prints the approval command. Nothing reaches the calendar
    until the owner runs `kb-followup approve`.
    (Spec: Existing Writer Hardening, AC7.)
    """
    from datetime import datetime as _dt

    from _kb_calendar import DateParseError, dateparse, ledger

    try:
        parsed = dateparse.parse_when(when, now=None)
    except DateParseError as e:
        print(f"⚠ --calendar: could not parse --due {when!r} ({e}); "
              "no follow-up proposed. Re-run with an ISO date/time.",
              file=sys.stderr)
        return

    date_str = parsed["start"][:10].replace("-", "")
    fid = ledger.next_id(date_str)
    ledger.append({
        "id": fid,
        "status": "proposed",
        "summary": task,
        "start": parsed["start"],
        "end": parsed["end"],
        "timezone": parsed["timezone"],
        "project_slug": None,
        "kind": "task",
        "source": "kb-task",
        "reason": context or "task follow-up",
        "created_by": os.environ.get("KB_ACTOR", "agent"),
        "created_at": _dt.now().astimezone().isoformat(timespec="seconds"),
        "approval": None,
        "calendar": None,
    })
    print(f"📌 Follow-up proposed (no calendar write yet): {fid} @ {parsed['start']}")
    print(f"   approve: kb-followup approve {fid} --approval-source \"chat:<your ok>\"")


def main() -> None:
    p = argparse.ArgumentParser(description="Append a task to a project's kb-board (via kb-board append).")
    p.add_argument("text", help="Task description (one line)")
    p.add_argument("--project", help="Project slug (omit to target hub-level backlog)")
    p.add_argument("--due", help="Due date/time (any string; 'YYYY-MM-DDTHH:MM' recommended)")
    p.add_argument("--by", default="self", choices=["hub", "user", "self"],
                   help="Who set the task (default: self)")
    p.add_argument("--context", help="Optional one-line context")
    p.add_argument("--calendar", action="store_true",
                   help="Propose an owner-approval-gated follow-up reminder (requires --due)")
    args = p.parse_args()

    slug = args.project if args.project else "hub"
    backlog_path = HUB / "backlog.md" if slug == "hub" else HUB / "projects" / slug / "backlog.md"
    plan_item_id = str(uuid.uuid4())

    cmd = [
        str(KB_BOARD),
        "append",
        str(backlog_path),
        args.text,
        "--plan-item-id",
        plan_item_id,
        "--actor",
        args.by,
        "--owner",
        args.by,
    ]
    if args.due:
        cmd += ["--field", f"due={args.due}"]
    if args.context:
        cmd += ["--body", args.context]

    result = subprocess.run(cmd, capture_output=True, text=True)
    if result.returncode != 0:
        print(result.stdout, end="")
        print(result.stderr, end="", file=sys.stderr)
        sys.exit(result.returncode)

    target = f"project '{args.project}'" if args.project else "hub"
    print(f"✓ Added to {target} board (via kb-board append)")
    print(result.stdout.rstrip())

    if args.calendar:
        if not args.due:
            print("⚠ --calendar requires --due; skipped.", file=sys.stderr)
        else:
            propose_calendar_followup(args.text, args.due, args.context)


if __name__ == "__main__":
    main()
