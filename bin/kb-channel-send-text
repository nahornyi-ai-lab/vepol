#!/usr/bin/env python3
"""Send exactly one frozen private text part with typed Telegram outcomes.

Usage: kb-channel-send-text <message_type> <0600 part file>

Credentials (per variable: the environment wins, $KB_HUB/personal/.secrets,
read as data, fills gaps): TELEGRAM_BOT_TOKEN (or legacy TELEGRAM_TOKEN) and
TELEGRAM_CHAT_ID. The token never appears in any argv.

Prints one JSON object on stdout. Exit codes:
   0  success (with message_id)
   3  telegram not configured: the token or chat id is empty or missing in
      the environment and in .secrets; one stderr line, no network call
  20  known rejection (definitely not delivered)
  21  ambiguous (transmission may have begun)
"""

from __future__ import annotations

import http.client
import json
import os
import re
import ssl
import stat
import sys
from pathlib import Path
from urllib.parse import urlencode, urlsplit


MAX_UTF16 = 3500
# The retro is one unsplit message and used to go straight to Telegram, so it
# keeps Telegram's own limit (4096 UTF-16 units) instead of the brief's parts.
MAX_UTF16_BY_TYPE = {"retro": 4096, "retro_error": 4096}
MESSAGE_TYPES = {"brief", "brief_error", "agent_review", "retro", "retro_error"}
EXIT_NOT_CONFIGURED = 3


def read_secret(key: str) -> str:
    """Last `KEY=value` line of .secrets (optional `export `, quotes
    stripped). The file is data, never executed."""
    hub = os.environ.get("KB_HUB") or os.path.join(os.path.expanduser("~"), "knowledge")
    try:
        lines = Path(hub, "personal", ".secrets").read_text(
            encoding="utf-8", errors="replace").splitlines()
    except OSError:
        return ""
    value = ""
    for raw in lines:
        line = raw.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        name, rest = line.split("=", 1)
        if re.sub(r"^export[ \t]+", "", name.strip()) == key:
            value = rest.strip()
    if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
        value = value[1:-1]
    return value


def emit(outcome: str, message_id=None, reason: str | None = None) -> None:
    value = {"outcome": outcome, "message_id": message_id}
    if reason:
        value["reason"] = reason
    print(json.dumps(value, ensure_ascii=False, sort_keys=True))


def reject(reason: str) -> int:
    emit("known_rejection", reason=reason)
    return 20


def ambiguous(reason: str) -> int:
    emit("ambiguous", reason=reason)
    return 21


def main() -> int:
    if len(sys.argv) != 3 or sys.argv[1] not in MESSAGE_TYPES:
        return reject("invalid_local_arguments")
    part_path = Path(sys.argv[2])
    try:
        if not part_path.is_file() or stat.S_IMODE(part_path.stat().st_mode) != 0o600:
            return reject("invalid_private_part")
        raw = part_path.read_bytes()
        text = raw.decode("utf-8", errors="strict")
    except (OSError, UnicodeDecodeError):
        return reject("invalid_private_part")
    if not text or len(text.encode("utf-16-le")) // 2 > MAX_UTF16_BY_TYPE.get(sys.argv[1], MAX_UTF16):
        return reject("invalid_private_part")

    token = (os.environ.get("TELEGRAM_BOT_TOKEN") or os.environ.get("TELEGRAM_TOKEN")
             or read_secret("TELEGRAM_BOT_TOKEN") or read_secret("TELEGRAM_TOKEN"))
    chat_id = os.environ.get("TELEGRAM_CHAT_ID") or read_secret("TELEGRAM_CHAT_ID")
    if not token or not chat_id:
        print("telegram not configured", file=sys.stderr)
        emit("not_configured", reason="telegram_not_configured")
        return EXIT_NOT_CONFIGURED
    if not re.fullmatch(r"[^\s/]+", token):
        return reject("missing_credentials")
    try:
        timeout = float(os.environ.get("KB_TG_TEXT_TIMEOUT", "20"))
        if not 0 < timeout <= 120:
            raise ValueError
    except ValueError:
        return reject("invalid_timeout")

    base = os.environ.get("KB_TG_API_BASE", "https://api.telegram.org").rstrip("/")
    try:
        parsed = urlsplit(base)
        if parsed.scheme not in {"http", "https"} or not parsed.hostname:
            raise ValueError
        base_path = parsed.path.rstrip("/")
        path = f"{base_path}/bot{token}/sendMessage"
        port = parsed.port
    except (ValueError, TypeError):
        return reject("invalid_api_base")

    if parsed.scheme == "https":
        connection: http.client.HTTPConnection = http.client.HTTPSConnection(
            parsed.hostname, port=port, timeout=timeout, context=ssl.create_default_context()
        )
    else:
        connection = http.client.HTTPConnection(parsed.hostname, port=port, timeout=timeout)

    # A connect failure is the only network error proven to precede request
    # transmission. Everything after this point is possibly delivered.
    try:
        connection.connect()
    except Exception:
        connection.close()
        return reject("connect_failed_before_transmission")

    payload = urlencode({"chat_id": chat_id, "text": text}).encode("ascii")
    try:
        connection.request(
            "POST",
            path,
            body=payload,
            headers={
                "Content-Type": "application/x-www-form-urlencoded",
                "Content-Length": str(len(payload)),
            },
        )
        response = connection.getresponse()
        response_raw = response.read()
    except Exception:
        connection.close()
        return ambiguous("uncertain_after_transmission_began")
    finally:
        connection.close()

    try:
        value = json.loads(response_raw.decode("utf-8", errors="strict"))
    except (UnicodeDecodeError, json.JSONDecodeError):
        return ambiguous("malformed_response")
    if not isinstance(value, dict):
        return ambiguous("malformed_response")
    if value.get("ok") is True:
        result = value.get("result")
        message_id = result.get("message_id") if isinstance(result, dict) else None
        if (isinstance(message_id, bool) or not isinstance(message_id, int)
                or message_id <= 0):
            return ambiguous("success_with_invalid_message_id")
        emit("success", message_id=message_id)
        return 0
    if value.get("ok") is False:
        return reject("telegram_rejected")
    return ambiguous("malformed_response")


if __name__ == "__main__":
    sys.exit(main())
