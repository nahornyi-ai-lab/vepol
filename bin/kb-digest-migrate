#!/usr/bin/env python3
"""kb-digest-migrate — idempotent processes.yaml migration for the audio digests.

Inserts `evening-digest` (after:retro) and `morning-digest` anchored to the
last enabled scheduled morning process (money-radar > learning > daily),
re-anchors ONLY its own managed morning-digest block when a better anchor
appears (e.g. money-radar enabled later), leaves customized blocks untouched,
or `--revert`s both digest blocks out. The transform is pure text->text in
`_kb_digest_migrate`; this CLI owns only the atomic 0600 rewrite.

Fail-closed: on a malformed source (ProcessConfigError) or an unmigratable file
(DigestMigrationError) it exits non-zero, prints a clear error, and leaves the
file UNCHANGED — no rewrite, no partial file.

Spec: decisions/local-tts-v0-6-dual-backend-addendum-2026-07-11.md
      (spec-contract:sha256:64c99d1d0e31cc701bcedcbe371b603ef179991db5ab508a17abb31ea8d99062)

Usage:
  kb-digest-migrate --file <path> [--audio-backend notebooklm|local_qwen] [--revert]
"""
from __future__ import annotations

import argparse
import os
import sys
import tempfile

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from _kb_processes import ProcessConfigError  # noqa: E402
from _kb_digest_migrate import (  # noqa: E402
    DigestMigrationError,
    migrate_processes,
    revert_processes,
)


def _atomic_write_0600(path: str, text: str) -> None:
    """Atomically replace `path` with `text`, mode 0600 (same pattern as
    kb-mail-migrate): temp file in the same directory -> fchmod 0600 -> write ->
    flush/fsync -> os.replace, so a partial write never becomes the live file."""
    parent = os.path.dirname(os.path.abspath(path)) or "."
    data = text.encode("utf-8")
    fd, tmp = tempfile.mkstemp(dir=parent, prefix=".processes.", suffix=".tmp")
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "wb") as f:
            f.write(data)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)


def main(argv: list[str]) -> int:
    ap = argparse.ArgumentParser(
        prog="kb-digest-migrate",
        description="Idempotent processes.yaml migration for the audio digests.",
    )
    ap.add_argument("--file", required=True, help="path to processes.yaml")
    ap.add_argument("--revert", action="store_true",
                    help="undo the migration (remove both digest blocks)")
    ap.add_argument(
        "--audio-backend", choices=("notebooklm", "local_qwen"),
        help=("selected managed digest route; omitted preserves existing managed "
              "routes and defaults newly created blocks to notebooklm"),
    )
    args = ap.parse_args(argv)

    try:
        with open(args.file, encoding="utf-8") as f:
            text = f.read()
    except OSError as exc:
        print(f"kb-digest-migrate: cannot read {args.file}: {exc}", file=sys.stderr)
        return 1

    # Fail closed BEFORE any write: if the transform raises, the file is untouched.
    notices: list[str] = []
    try:
        if args.revert:
            result = revert_processes(text)
        else:
            result, notices = migrate_processes(
                text, audio_backend=args.audio_backend,
            )
    except (ProcessConfigError, DigestMigrationError) as exc:
        verb = "revert" if args.revert else "migrate"
        print(
            f"kb-digest-migrate: refusing to {verb} {args.file}; source invalid "
            f"or unmigratable, leaving it unchanged: {exc}",
            file=sys.stderr,
        )
        return 1

    try:
        _atomic_write_0600(args.file, result)
    except OSError as exc:
        print(f"kb-digest-migrate: write failed for {args.file}: {exc}", file=sys.stderr)
        return 1

    for note in notices:
        print(f"kb-digest-migrate: notice: {note}")
    action = "reverted" if args.revert else "migrated"
    unchanged = " (no-op)" if result == text else ""
    print(f"kb-digest-migrate: {action} {args.file}{unchanged}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
