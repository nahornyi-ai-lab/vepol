#!/usr/bin/env bash
# kb-cli-offer — at install time, OFFER the optional agent CLIs Vepol can use.
#
# Fail-safe by contract: NEVER blocks the Vepol install. Offers each CLI that is
# not already present; installs the ones the user agrees to (best-effort); skips
# the rest. After offering, the live roster (kb-cli-roster) reflects whatever the
# user actually installed, so agents only ever advertise tools that exist.
#
# Non-interactive (no TTY): prints the list + how to install, installs nothing.
#
# Usage: kb-cli-offer            (interactive prompts when run from a terminal)
#        kb-cli-offer --list     (just print the roster + install hints, no prompts)
set -uo pipefail   # NOT -e: a failed optional install must not abort the installer

C_OK=$'\033[1;32m'; C_INFO=$'\033[1;36m'; C_WARN=$'\033[1;33m'; C_DIM=$'\033[2m'; C_OFF=$'\033[0m'
[[ -t 1 ]] || { C_OK=''; C_INFO=''; C_WARN=''; C_DIM=''; C_OFF=''; }

LIST_ONLY=0
[[ "${1:-}" == "--list" ]] && LIST_ONLY=1

# name | detect (bare name or abs path) | what-for | install hint | auto-install cmd (empty = manual only)
TOOLS=(
  "claude|claude|writes/runs code, skills, MCP, runs the project|Download the desktop app: https://claude.ai/download|"
  "codex|codex|analysis, planning, conservative second opinion, big research|npm install -g @openai/codex|npm install -g @openai/codex"
  "agy|agy|independent second opinion, catches nuances others miss|Antigravity CLI installer (see https://antigravity.google )|"
  "grok|grok|what's discussed on X/Reddit right now; current, blunt|Grok CLI installer (see https://x.ai )|"
  "notebooklm|notebooklm|audio/video recaps for humans|pipx install notebooklm-py && notebooklm login|pipx install notebooklm-py"
  "opencode|opencode|fallback when grok is unavailable; any model|OpenCode installer (see https://opencode.ai )|"
)

is_present() {
  local d="$1"
  if [[ "$d" == */* ]]; then [[ -x "$d" ]]; else command -v "$d" >/dev/null 2>&1; fi
}
# Also treat known absolute fallbacks as present.
present_any() {
  local name="$1"
  case "$name" in
    agy)        is_present agy || is_present "$HOME/.local/bin/agy" ;;
    grok)       is_present grok || is_present "$HOME/.grok/bin/grok" ;;
    notebooklm) is_present notebooklm || is_present "$HOME/.local/bin/notebooklm" ;;
    opencode)   is_present opencode || is_present "$HOME/.opencode/bin/opencode" ;;
    *)          is_present "$name" ;;
  esac
}

echo "${C_INFO}Agent CLIs Vepol can use (it uses whichever you install):${C_OFF}"
for row in "${TOOLS[@]}"; do
  IFS='|' read -r name detect what hint auto <<< "$row"
  if present_any "$name"; then
    echo "  ${C_OK}✓${C_OFF} ${name} — already installed (${what})"
    continue
  fi
  echo "  ${C_DIM}○${C_OFF} ${name} — ${what}"
  if [[ $LIST_ONLY -eq 1 || ! -t 0 ]]; then
    echo "      install: ${hint}"
    continue
  fi
  if [[ -n "$auto" ]]; then
    printf "      Install %s now? [y/N] " "$name"; read -r ans
    if [[ "$ans" =~ ^[Yy] ]]; then
      echo "      ${C_DIM}running: ${auto}${C_OFF}"
      if eval "$auto"; then echo "      ${C_OK}installed ${name}${C_OFF}"; else echo "      ${C_WARN}couldn't install ${name} — skipping (install later: ${hint})${C_OFF}"; fi
    else
      echo "      skipped — install later: ${hint}"
    fi
  else
    echo "      install (manual): ${hint}"
  fi
done
echo "${C_DIM}(Vepol never blocks on these — agents simply use what's installed.)${C_OFF}"
exit 0
