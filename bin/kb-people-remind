#!/usr/bin/env python3
"""kb-people-remind — check next_touch_due and send reminders via Vepol channel.

Usage:
  kb-people-remind [--horizon 0]

Default horizon is 0 — surfaces only contacts whose next_touch_due is
today or earlier (overdue). The intent is "remind me on the day, not
a week before." Pass --horizon N (N>0) if you want N-day-ahead
anticipation reminders.
"""

import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent))

import click
import _kb_profile
from _kb_people import card
from _kb_people.channel import send

# Honor KB_HUB (kb-tick processes, launchd, test fixtures); card.PEOPLE_DIR
# defaults to ~/knowledge/people otherwise.
if os.environ.get("KB_HUB"):
    card.PEOPLE_DIR = Path(os.environ["KB_HUB"]).expanduser() / "people"

# User language (spec: user-language-setting-2026-06-12). The whole message
# is user-facing delivery, so every string goes through the pack.
REMIND_LABELS = {
    "ru": {
        "header": "👤 Напоминания о контактах ({n}):\n",
        "line": "  • {name} — срок {due}{tags}",
        "send_failed": "kb-people-remind: доставка в канал не удалась",
    },
    "en": {
        "header": "👤 Follow-up reminders ({n} contact{plural}):\n",
        "line": "  • {name} — due {due}{tags}",
        "send_failed": "kb-people-remind: channel delivery failed",
    },
}


def _labels():
    lang = _kb_profile.get_language(os.environ.get("KB_HUB"))
    return REMIND_LABELS.get(lang, REMIND_LABELS["en"])


@click.command()
@click.option("--horizon", default=0, show_default=True,
              help="Days ahead to look. 0 = today only (plus overdue). "
                   "Increase for anticipation reminders.")
@click.option("--dry-run", is_flag=True, help="Print without sending")
def main(horizon, dry_run):
    """Send contact follow-up reminders via Vepol channel."""
    due_contacts = card.list_due(horizon)

    if not due_contacts:
        return

    labels = _labels()
    lines = [labels["header"].format(
        n=len(due_contacts), plural="s" if len(due_contacts) > 1 else "")]
    for c in due_contacts:
        tags = f"  [{', '.join(c['tags'])}]" if c.get("tags") else ""
        lines.append(labels["line"].format(name=c["name"], due=c["due"], tags=tags))

    message = "\n".join(lines)

    if dry_run:
        click.echo(message)
    else:
        # [telegram] is this process's only declared output: a failed
        # delivery must surface as a non-zero exit so kb-tick does not
        # mark the process fired and retries on the next tick.
        if not send("contact-reminder", message):
            click.echo(labels["send_failed"], err=True)
            sys.exit(1)


if __name__ == "__main__":
    main()
