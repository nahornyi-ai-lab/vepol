{
  "permissions": {
    "allow": [
      "Read(~/knowledge/**)",
      "Bash(~/knowledge/bin/*)",
      "Bash(__HOME__/knowledge/bin/*)"
    ],
    "defaultMode": "default"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash __HOME__/knowledge/bin/kb-session-start",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash __HOME__/knowledge/bin/kb-session-end",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash __HOME__/knowledge/bin/kb-pre-compact",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash __HOME__/.claude/statusline-command.sh"
  }
}
