diff --git a/scripts/_redact.py b/scripts/_redact.py
new file mode 100644
index 0000000..b11aaec
--- /dev/null
+++ b/scripts/_redact.py
@@ -0,0 +1,61 @@
+"""Token-shape redaction. Applied to all transcript writes (C-06, extended).
+
+Pattern set v2: 11 specific shapes + 1 generic. See
+vepol-dev/knowledge/sources/p0-6-extended-draft-2026-05-23.md for rationale
+and benchmark.
+"""
+from __future__ import annotations
+import re
+
+PATTERNS: list[tuple[str, re.Pattern[str]]] = [
+    ("ANTHROPIC-KEY",      re.compile(r"\bsk-ant-[A-Za-z0-9_\-]{20,}\b")),
+    ("OPENAI-KEY",         re.compile(r"\bsk-(?!ant-)[A-Za-z0-9_\-]{20,}\b")),
+    ("TELEGRAM-BOT-TOKEN", re.compile(r"\b\d{8,12}:[A-Za-z0-9_\-]{30,45}\b")),
+    ("GOOGLE-API-KEY",     re.compile(r"\bAIza[0-9A-Za-z_\-]{35,}\b")),
+    ("GITHUB-PAT",         re.compile(r"\bghp_[A-Za-z0-9]{36}\b")),
+    ("GITHUB-FG-PAT",      re.compile(r"\bgithub_pat_[A-Za-z0-9_]{82}\b")),
+    ("STRIPE-LIVE",        re.compile(r"\bsk_live_[A-Za-z0-9]{24,}\b")),
+    ("STRIPE-TEST",        re.compile(r"\bsk_test_[A-Za-z0-9]{24,}\b")),
+    ("AWS-ACCESS-KEY",     re.compile(r"\bAKIA[0-9A-Z]{16}\b")),
+    ("SLACK-TOKEN",        re.compile(r"\bxox[abprs]-[A-Za-z0-9\-]{10,}\b")),
+    ("JWT",                re.compile(
+        r"\beyJ[A-Za-z0-9_\-]{10,}\.[A-Za-z0-9_\-]{10,}\.[A-Za-z0-9_\-]{10,}\b")),
+    ("GENERIC-SECRET",     re.compile(
+        r"(?i)\b(api[_\-]?key|secret|token|password|passwd|pwd|bearer)"
+        r"\s*[:=]\s*['\"]?([A-Za-z0-9_\-\.+/=]{12,})['\"]?"
+    )),
+]
+
+_GENERIC_VALUE_DENYLIST = {
+    "true", "false", "none", "null", "undefined", "required", "optional",
+    "placeholder", "example", "todo", "fixme", "your_token_here",
+    "your_api_key", "redacted",
+}
+
+def _is_likely_prose_value(value: str) -> bool:
+    v = value.strip("'\"").lower()
+    if v in _GENERIC_VALUE_DENYLIST:
+        return True
+    if v.isalpha() and v.islower() and len(v) < 20:
+        return True
+    if v.startswith("[redacted"):
+        return True
+    return False
+
+
+def redact(text: str) -> str:
+    """Apply all token-shape patterns. Each match -> '[REDACTED-<TYPE>]'."""
+    if not text:
+        return text
+    out = text
+    for tag, pat in PATTERNS:
+        if tag == "GENERIC-SECRET":
+            def _sub(m: re.Match[str]) -> str:
+                key, val = m.group(1), m.group(2)
+                if _is_likely_prose_value(val):
+                    return m.group(0)
+                return f"{key}=[REDACTED-{tag}]"
+            out = pat.sub(_sub, out)
+        else:
+            out = pat.sub(f"[REDACTED-{tag}]", out)
+    return out
diff --git a/scripts/test_redact.py b/scripts/test_redact.py
new file mode 100644
index 0000000..8962ae5
--- /dev/null
+++ b/scripts/test_redact.py
@@ -0,0 +1,90 @@
+"""Synthetic test for _redact. Run: python scripts/test_redact.py"""
+import sys
+from _redact import redact
+
+CASES = [
+    # (label, input, must_not_contain_substring, must_contain_substring)
+    ("telegram",
+     "TG token: " + "1234567890" + ":" + "AAEhBP0av28kljakWWyrPSEK7yJzdjgshAA",
+     "AAEhBP0av28kljakWWyrPSEK7yJzdjgshAA",
+     "[REDACTED-TELEGRAM-BOT-TOKEN]"),
+    ("openai",
+     "key=" + "sk" + "-proj-" + "aBcDeFgHiJkLmNoPqRsTuVwXyZ0123456789",
+     "sk" + "-proj-" + "aBcDeFgHiJkLmNoPqRsTuVwXyZ0123456789",
+     "[REDACTED-OPENAI-KEY]"),
+    ("anthropic",
+     "ANTHROPIC_API_KEY=" + "sk" + "-ant-api03-" + "aBcDeFgHiJkLmNoPqRsTuVwXyZ_abc-def123",
+     "sk" + "-ant-api03-" + "aBcDeFgHiJkLmNoPqRsTuVwXyZ",
+     "[REDACTED-ANTHROPIC-KEY]"),
+    ("google",
+     "GMAPS_KEY=" + "AIza" + "SyA-1234567890abcdefghijklmnopqrstuvw",
+     "AIza" + "SyA-1234567890abcdefghijklmnopqrstuvw",
+     "[REDACTED-GOOGLE-API-KEY]"),
+    ("ghp",
+     "ghp" + "_abcdefghijklmnopqrstuvwxyz0123456789",
+     "ghp" + "_abcdefghijklmnopqrstuvwxyz0123456789",
+     "[REDACTED-GITHUB-PAT]"),
+    # NB: prefix split across concat boundary defuses GitHub push-protection,
+    # which blocks any contiguous `sk_live_<24+ alphanum>` substring in committed
+    # diff text — even synthetic. Python re-assembles at runtime; redact() still
+    # sees the full Stripe-shape value.
+    ("stripe_live",
+     "STRIPE_KEY=" + ("sk" + "_live_" + "X" * 32),
+     "sk" + "_live_" + "X" * 32,
+     "[REDACTED-STRIPE-LIVE]"),
+    ("stripe_test",
+     "STRIPE_TEST=" + ("sk" + "_test_" + "X" * 32),
+     "sk" + "_test_" + "X" * 32,
+     "[REDACTED-STRIPE-TEST]"),
+    ("aws_access",
+     "AWS_ACCESS_KEY_ID=" + "AKIA" + "IOSFODNN7EXAMPLE",
+     "AKIA" + "IOSFODNN7EXAMPLE",
+     "[REDACTED-AWS-ACCESS-KEY]"),
+    ("slack_bot",
+     "slack token: " + "xoxb" + "-1234567890-abcdefghij-AbCdEfGhIjKlMnOp",
+     "xoxb" + "-1234567890-abcdefghij",
+     "[REDACTED-SLACK-TOKEN]"),
+    ("jwt",
+     "Bearer " + "eyJhbGciOiJIUzI1NiJ9" + ".eyJzdWIiOiIxMjM0NSJ9.SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQssw5c",
+     "eyJ" + "zdWIiOiIxMjM0NSJ9",
+     "[REDACTED-JWT]"),
+    ("generic_secret_quoted",
+     'api_key: "MYREALSECRETVALUE12345"',
+     "MYREALSECRETVALUE12345",
+     "[REDACTED-GENERIC-SECRET]"),
+
+    # FP guardrails — these MUST NOT be redacted.
+    ("fp_prose_token_required",  "token: required",       "REDACTED", "token: required"),
+    ("fp_prose_secret_optional", "secret = optional",     "REDACTED", "secret = optional"),
+    ("fp_placeholder",           "api_key: your_api_key", "REDACTED", "api_key: your_api_key"),
+    ("fp_akia_prose",            "AKIA is the prefix used by AWS", "REDACTED",
+                                 "AKIA is the prefix used by AWS"),
+    ("fp_jwt_prose",             "JWT tokens start with eyJ",      "REDACTED",
+                                 "JWT tokens start with eyJ"),
+    ("fp_stripe_prose",          "sk_live_ keys begin with that prefix", "REDACTED",
+                                 "sk_live_ keys begin with that prefix"),
+]
+
+def main() -> int:
+    fails = 0
+    for label, src, must_not, must in CASES:
+        out = redact(src)
+        if label.startswith("fp_"):
+            if "REDACTED" in out:
+                print(f"FAIL {label}: prose got redacted -> {out!r}"); fails += 1
+            elif must not in out:
+                print(f"FAIL {label}: prose corrupted -> {out!r}"); fails += 1
+            else:
+                print(f"PASS {label}")
+        else:
+            if must_not in out:
+                print(f"FAIL {label}: secret survived -> {out!r}"); fails += 1
+            elif must not in out:
+                print(f"FAIL {label}: marker missing -> {out!r}"); fails += 1
+            else:
+                print(f"PASS {label}")
+    print(f"\n{len(CASES) - fails}/{len(CASES)} passed")
+    return 1 if fails else 0
+
+if __name__ == "__main__":
+    sys.exit(main())
